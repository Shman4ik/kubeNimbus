<?xml version="1.0" encoding="utf-8"?>
<!--
  Every package this repository restores comes from nuget.org, and from nowhere
  else, whatever the machine's own NuGet configuration says.

  Without this file NuGet merges the user-wide and machine-wide configs into the
  restore, so a developer machine that lists a private or mirror feed (or the
  Visual Studio offline packages folder, which a Visual Studio install adds) could
  resolve one of our package IDs from there: a dependency-confusion route that CI,
  which only ever had nuget.org, would never show. `<clear />` drops the
  inherited sources, and the source mapping makes nuget.org the only place any
  package ID may come from, so adding a second source later cannot quietly take
  over an existing package either.

  NativeAOT's ILCompiler and the runtime packs are ordinary nuget.org packages, so
  the release builds need nothing more. See SECURITY.md, "Dependencies".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
