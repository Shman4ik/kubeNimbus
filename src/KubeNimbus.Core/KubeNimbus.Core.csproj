<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>KubeNimbus.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aot variant only: source-generated serialization, survives NativeAOT.
         Never swap for the reflection-based "KubernetesClient" package. -->
    <PackageReference Include="KubernetesClient.Aot" Version="19.0.2" />
    <!-- Ours, and upgraded on its own schedule. Used through its event parser
         (KubeconfigReader.cs) and its structural RepresentationModel (YamlJson.cs) —
         never the attribute/reflection-based serializer, which isn't AOT/trim-safe.
         KubernetesClient.Aot also depends on it, and its own YAML code only works with
         the exact YamlDotNet it was built against (a precompiled StaticTypeInspector;
         with 18.x it throws TypeLoadException). That is why this was pinned to 16.3.0
         until KubeconfigReader took the library's YAML layer off every code path we run;
         BannedSymbols.txt keeps it off. A bump here is still verified by the Core tests
         and by the unreachable-cluster launch check, both of which read a kubeconfig. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeNimbus.Core.Tests" />
  </ItemGroup>

</Project>
