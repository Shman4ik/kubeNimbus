<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>KubeNimbus.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aot variant only: source-generated serialization, survives NativeAOT.
         Never swap for the reflection-based "KubernetesClient" package. -->
    <PackageReference Include="KubernetesClient.Aot" Version="19.0.2" />
    <!-- Already a transitive dependency of KubernetesClient.Aot (kubeconfig YAML
         parsing); pinned to the same major version. Used ONLY via its structural
         RepresentationModel (YamlNode tree) in YamlJson.cs — never the
         attribute/reflection-based serializer, which isn't AOT/trim-safe. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KubeNimbus.Core.Tests" />
  </ItemGroup>

</Project>
