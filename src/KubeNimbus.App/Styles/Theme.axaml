<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome">

    <!--
        kubeNimbus's own styles. Everything both Nimbus apps share — the palette,
        the radii, the scrollbars, the 26 common icons and 28 style classes —
        lives in shared/nimbusUi and is merged in below; see
        shared/nimbusUi/DESIGN.md for the rules and the membership test.

        What stays here is what only a Kubernetes client has: the metrics
        sparkline colours, the cluster-environment traffic lights, the bottom
        inspector dock, the segmented tab strip, and this app's own glyphs.
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The shared Nimbus design system (shared/nimbusUi). Merged into THIS
                     file's resources, not just included as a sibling Styles element:
                     a StaticResource below resolves against this file's own resource
                     chain, so a shared token has to be reachable from here. -->
                <ResourceInclude Source="avares://Nimbus.Ui/Theme/Tokens.axaml" />
                <ResourceInclude Source="avares://Nimbus.Ui/Theme/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Usage charts (metrics.k8s.io history, see Controls/Sparkline.cs). Fixed
                 hues so they read the same on both themes, and deliberately NOT the
                 ok/warn/error status colors: a CPU line is a measurement, not a verdict.
                 CPU reuses the brand accent; memory gets a distinct teal. -->
            <SolidColorBrush x:Key="UsageCpuStrokeBrush" Color="#2D7FF9" />
            <SolidColorBrush x:Key="UsageCpuAreaBrush" Color="#382D7FF9" />
            <SolidColorBrush x:Key="UsageMemoryStrokeBrush" Color="#12A594" />
            <SolidColorBrush x:Key="UsageMemoryAreaBrush" Color="#3812A594" />
            <SolidColorBrush x:Key="ChartBaselineBrush" Color="#38808080" />

            <!-- Cluster environment colors. Deliberately the conventional traffic-light
                 assignment (red/amber/green for prod/staging/dev) rather than anything
                 house-styled: this is the one signal in the app whose whole value is
                 that it is already familiar from kube-ps1, kubectx wrappers and every
                 team's shell prompt. Production is NOT AppDangerBrush — an environment is
                 not a failure, and reusing the error color would make every prod
                 cluster look broken. -->
            <SolidColorBrush x:Key="EnvProductionBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="EnvStagingBrush" Color="#D9822B" />
            <SolidColorBrush x:Key="EnvDevelopmentBrush" Color="#46A758" />
            <SolidColorBrush x:Key="EnvUnknownBrush" Color="#80808080" />

            <!-- Outline pin for the switcher's un-pinned rows: a filled/outline pair reads
                 as a toggle, where one glyph at two opacities reads as "disabled". -->
            <StreamGeometry x:Key="PinOutlineIconGeometry">M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12M10,4H14V12.8L15.2,14H8.8L10,12.8V4Z</StreamGeometry>
            <StreamGeometry x:Key="ChevronDownIconGeometry">M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z</StreamGeometry>

            <!-- New for kubeNimbus: pod/container, exec terminal, delete/edit/save/yaml, add, hexagon brand mark. -->
            <StreamGeometry x:Key="CubeOutlineIconGeometry">M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L10.11,5.22L16,8.61L17.96,7.5L12,4.15M6.04,7.5L12,10.85L13.96,9.75L8.08,6.35L6.04,7.5M5,15.91L11,19.29V12.58L5,9.21V15.91M19,15.91V9.21L13,12.58V19.29L19,15.91Z</StreamGeometry>
            <StreamGeometry x:Key="ConsoleIconGeometry">M20,19V7H4V19H20M20,3A2,2 0 0,1 22,5V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V5C2,3.89 2.9,3 4,3H20M13,17V15H18V17H13M9.58,13L5.57,9H8.4L11.7,12.3C12.09,12.69 12.09,13.33 11.7,13.72L8.42,17H5.59L9.58,13Z</StreamGeometry>
            <StreamGeometry x:Key="DeleteIconGeometry">M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z</StreamGeometry>
            <StreamGeometry x:Key="PencilIconGeometry">M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z</StreamGeometry>
            <StreamGeometry x:Key="ContentSaveIconGeometry">M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12A3,3 0 0,0 9,15A3,3 0 0,0 12,18A3,3 0 0,0 15,15A3,3 0 0,0 12,12M6,6H15V10H6V6Z</StreamGeometry>
            <StreamGeometry x:Key="CodeBracesIconGeometry">M8,3A2,2 0 0,0 6,5V9A2,2 0 0,1 4,11H3V13H4A2,2 0 0,1 6,15V19A2,2 0 0,0 8,21H10V19H8V14A2,2 0 0,0 6,12A2,2 0 0,0 8,10V5H10V3H8M16,3A2,2 0 0,1 18,5V9A2,2 0 0,0 20,11H21V13H20A2,2 0 0,0 18,15V19A2,2 0 0,1 16,21H14V19H16V14A2,2 0 0,1 18,12A2,2 0 0,1 16,10V5H14V3H16Z</StreamGeometry>
            <StreamGeometry x:Key="PlusIconGeometry">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
            <StreamGeometry x:Key="AlertCircleIconGeometry">M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="FullscreenIconGeometry">M7,14H5V19H10V17H7V14M5,10H7V7H10V5H5V10M17,17H14V19H19V14H17V17M14,5V7H17V10H19V5H14Z</StreamGeometry>
            <StreamGeometry x:Key="FullscreenExitIconGeometry">M5,16H8V19H10V14H5V16M8,8H5V10H10V5H8V8M14,19H16V16H19V14H14V19M16,8V5H14V10H19V8H16Z</StreamGeometry>
            <StreamGeometry x:Key="ContentCopyIconGeometry">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
            <StreamGeometry x:Key="DownloadIconGeometry">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <StreamGeometry x:Key="ClockOutlineIconGeometry">M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.5,7H11V13L16.2,16.2L17,14.9L12.5,12.2V7Z</StreamGeometry>
            <!-- Eye / eye-off: the show-hide toggle on a masked Secret value. A filled
                 and a struck-through glyph, not one glyph at two opacities — the pair
                 reads as a toggle where the single glyph reads as "disabled". -->
            <StreamGeometry x:Key="EyeIconGeometry">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
            <StreamGeometry x:Key="OpenInNewIconGeometry">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>

        </ResourceDictionary>
    </Styles.Resources>

    <!-- Bottom inspector dock (Lens-style): header tab strip + draggable splitter. -->
    <Style Selector="Grid.dockHeader">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
    </Style>
    <Style Selector="Border.dockTab">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.dockTab:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.dockTab.active">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    </Style>

    <!-- DataGrid cells get a gutter on BOTH sides. Fluent's cell padding is
         left-only, which is invisible while every column is left-aligned and
         actively misleading as soon as one isn't: the resource list's Memory
         column is right-aligned, so its "—" placeholder landed hard against the
         Age column's "5d" and the pair rendered as "—5d" — i.e. a negative age.
         A real value did the same ("48 MiB16d"), and the CPU number touched the
         memory sparkline. The right gutter also stops the Name column's ellipsis
         from butting into Ready. -->
    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="10,0,10,0" />
    </Style>

    <!-- Compact TabItem headers. FluentTheme sizes these at 24px, which dwarfs the
         dock (see the pod detail Logs/Events strip); pull them down to body scale. -->
    <Style Selector="TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,6" />
    </Style>
    <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!-- Headerless TabControl: the tab strip is drawn by a `ListBox.segmented`
         alongside the panel's own tools instead, so the two share one row.
         A TabControl cannot host anything but tabs on its header row, and in a
         ~300px bottom dock every stacked row of chrome comes straight out of the
         content: pod detail spent four of them (owners, containers, tab strip, log
         toolbar) before the first log line. The TabControl itself stays because
         nothing else gives lazily-realized content plus an index that survives a
         hidden tab (Usage rides the Advanced view) — only its strip goes. -->
    <Style Selector="TabControl.headerless /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="TabControl.headerless">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Segmented tab strip: the header half of a `TabControl.headerless`. Selection
         is by index, so it stays aligned with the TabControl's own SelectedIndex —
         including for a tab hidden by the Advanced view, which both count. -->
    <Style Selector="ListBox.segmented">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
    </Style>

    <!-- Divider between the tab strip and the tools sharing its row. -->
    <Style Selector="Rectangle.toolSeparator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Fill" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Row splitter between the resource list and the bottom dock. -->
    <Style Selector="GridSplitter.dock">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="GridSplitter.dock:pointerover">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
    </Style>

    <!-- Form field caption, Fluent's label-above-the-input pattern (WinUI "Caption"
         at 12px, de-emphasized). Beside-the-input labels are what put "Local port"
         hard against its own text box in the port-forward pane: a label column sized
         to Auto has no gap of its own, and every pane that tried picked a different
         hand-tuned spacer. Above the input there is nothing to collide with, and the
         field's own width is the column width. -->
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <!-- InfoBar: WinUI's inline status surface — a tinted, outlined block that states
         what the pane is currently doing. The alternative it replaces is a bare status
         dot next to a sentence, which carries the same information but only for
         someone who already knows the colour code, and reads as decoration otherwise.
         Severity is a class, so a pane can flip it from a bound bool without swapping
         brushes by hand. Neutral (no severity class) is the resting state. -->
    <Style Selector="Border.infoBar">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.infoBar.success">
        <Setter Property="Background" Value="#1446A758" />
        <Setter Property="BorderBrush" Value="#4046A758" />
    </Style>
    <Style Selector="Border.infoBar.warn">
        <Setter Property="Background" Value="#14D9822B" />
        <Setter Property="BorderBrush" Value="#40D9822B" />
    </Style>
    <Style Selector="Border.infoBar.error">
        <Setter Property="Background" Value="#14CD5C5C" />
        <Setter Property="BorderBrush" Value="#40CD5C5C" />
    </Style>

    <!-- Demo-cluster banner. Persistent for the whole life of a demo tab, which is a
         deliberate exception to UI rule 1: the thing it prevents is someone believing a
         screen full of invented pods is their own cluster, and a notice that appears
         once and goes away does not prevent that. Deliberately low-key — a thin tinted
         strip, not an alert — because it has to be readable for an entire session
         without becoming something the eye learns to skip. -->
    <Style Selector="Border.demoBar">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#40D9822B" />
        <Setter Property="Background" Value="#10D9822B" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="Border.demoBar TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.demoBar PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
    </Style>

    <!-- The "this pane needs a real cluster" state (exec, port-forward, apply/delete).
         A card rather than an inline sentence, because it replaces the pane's whole
         content: those panes have nothing offline to show underneath it, and a blank
         rectangle with a caption above it is the state UI rule 9 exists to forbid. -->
    <Style Selector="Border.demoUnavailable">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Clickable sidebar section header: expand/collapse, hover feedback. -->
    <Style Selector="Border.sectionHeaderRow">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.sectionHeaderRow:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>

    <!-- Sidebar filter box: same quiet card language as the palette's searchpill. -->
    <Style Selector="TextBox.filterbox">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="4,6" />
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <!-- Sidebar tree row: pill selection on the fixed brand accent, hover a quiet neutral wash. -->
    <Style Selector="ListBoxItem.navRow">
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ListBoxItem.navRow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem.navRow:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
    </Style>
    <Style Selector="ListBoxItem.navRow:selected PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <!-- Status dots for resource health -->
    <Style Selector="Ellipse.statusDot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
    </Style>
    <Style Selector="Ellipse.statusDot.ok">
        <Setter Property="Fill" Value="{StaticResource AppSuccessBrush}" />
    </Style>
    <Style Selector="Ellipse.statusDot.warn">
        <Setter Property="Fill" Value="{StaticResource AppWarningBrush}" />
    </Style>
    <Style Selector="Ellipse.statusDot.error">
        <Setter Property="Fill" Value="{StaticResource AppDangerBrush}" />
    </Style>
    <Style Selector="Ellipse.statusDot.idle">
        <Setter Property="Fill" Value="#80808080" />
    </Style>

    <!-- Status pill: colored text badge for the resource list's Status column —
         a plain dot alone doesn't distinguish "Pending" from "CrashLoopBackOff"
         at a glance; the pill's tint carries the same ok/warn/error read. -->
    <Style Selector="Border.statusPill">
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <Style Selector="Border.statusPill.ok">
        <Setter Property="Background" Value="#1C46A758" />
    </Style>
    <Style Selector="Border.statusPill.ok TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}" />
    </Style>
    <Style Selector="Border.statusPill.warn">
        <Setter Property="Background" Value="#1CD9822B" />
    </Style>
    <Style Selector="Border.statusPill.warn TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
    </Style>
    <Style Selector="Border.statusPill.error">
        <Setter Property="Background" Value="#1CCD5C5C" />
    </Style>
    <Style Selector="Border.statusPill.error TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}" />
    </Style>

    <!-- Environment pill (PROD / STAGING / DEV) — same shape as statusPill, but its
         own classes so the two vocabularies can't drift into each other: a resource
         being unhealthy and a cluster being production are unrelated claims. -->
    <Style Selector="Border.envPill">
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.envPill TextBlock">
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="0.6" />
    </Style>
    <Style Selector="Border.envPill.production">
        <Setter Property="Background" Value="#24E5484D" />
    </Style>
    <Style Selector="Border.envPill.production TextBlock">
        <Setter Property="Foreground" Value="{StaticResource EnvProductionBrush}" />
    </Style>
    <Style Selector="Border.envPill.staging">
        <Setter Property="Background" Value="#24D9822B" />
    </Style>
    <Style Selector="Border.envPill.staging TextBlock">
        <Setter Property="Foreground" Value="{StaticResource EnvStagingBrush}" />
    </Style>
    <Style Selector="Border.envPill.development">
        <Setter Property="Background" Value="#2446A758" />
    </Style>
    <Style Selector="Border.envPill.development TextBlock">
        <Setter Property="Foreground" Value="{StaticResource EnvDevelopmentBrush}" />
    </Style>

    <!-- Production band: a 2px rule under the command bar, shown only while the
         selected cluster is production. This is the sole piece of always-visible
         chrome the environment scheme adds (UI rule 1) — it costs nothing in the
         common case because it isn't there, and the case it does cover is the one
         the whole feature exists for. -->
    <Style Selector="Border.envBand">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{StaticResource EnvProductionBrush}" />
    </Style>

    <!-- Cluster tab in the top strip. The environment reads as a left edge rather
         than a background tint: a tint dark enough to see would fight the selected
         state, and the edge stacks cleanly with it. -->
    <Style Selector="Border.clusterTab">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Everything clickable says so before it's clicked. Without this a tab
             looks exactly like a label, which is half of "did that do anything?". -->
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.clusterTab:pointerover">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <!-- Press feedback. A click with no pressed state gives nothing back between
         button-down and whatever happens next, and when "whatever happens next" is
         switching to the cluster you were already on, that's the entire feedback
         budget spent on nothing.
         A real class, not the `:pressed` pseudo-class — that one is set by
         button-like controls (Button/ToggleButton/ComboBox), never by a plain
         Border, so the pseudo-class form compiles fine and silently never matches.
         MainWindow's tab pointer handlers toggle this. -->
    <Style Selector="Border.clusterTab.pressed">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Border.clusterTab.active">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.envEdge">
        <Setter Property="Width" Value="3" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>

    <!-- The item container carries no padding or highlight of its own: a group's
         title rides inside the first row of that group, and highlighting the
         container would draw the selection around the heading too. The row body
         below is the thing that lights up. -->
    <Style Selector="ListBox.switcherList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.switcherList ListBoxItem /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.switcherRowBody">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <!-- Transparent, but set: a Border with a null Background does not hit-test,
             which is what made most of each row unclickable in the first place. -->
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.switcherList ListBoxItem:pointerover Border.switcherRowBody">
        <Setter Property="Background" Value="{StaticResource HoverBackgroundBrush}" />
    </Style>
    <!-- The keyboard's highlighted row has to outrank a merely-hovered one, or Enter
         and the cursor appear to disagree about which row is "the" row — so selected
         gets an accent outline on top of the fill that hover also uses. -->
    <Style Selector="ListBox.switcherList ListBoxItem:selected Border.switcherRowBody">
        <Setter Property="Background" Value="{StaticResource AppSelectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppAccentBrush}" />
    </Style>

    <!-- Inline "connection lost" banner — CommandBar row, next to the namespace picker. -->
    <Style Selector="Border.inlineWarning">
        <Setter Property="Background" Value="#1CD9822B" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Border.inlineWarning PathIcon">
        <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
    </Style>
    <Style Selector="Border.inlineWarning TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppWarningBrush}" />
    </Style>

    <!-- Key caps for the F1 cheat sheet: one bordered chip per key, the way every
         other tool prints a shortcut. This replaced a single monospace string per row
         ("Ctrl+1…9"), which read as a filename rather than as keys — and baked the
         modifier into text, so it could not follow the Ctrl/Cmd preference.
         `combo` is the quiet connective between alternatives ("/", "Double-click"). -->
    <Style Selector="Border.kbd">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.kbd TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.combo">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
