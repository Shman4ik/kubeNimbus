<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ported from pgNimbus's design system (see X:\source\pgNimbus\PgNimbus.App\Styles\Theme.axaml):
        PowerToys/Files-inspired two-tone shell, fixed brand-blue accent (NOT the
        OS accent), pill-shaped nav selection, soft rounded cards. Token names
        and structure are kept identical to pgNimbus on purpose — two Nimbus
        apps sharing one design vocabulary.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ShellBackdropBrush" Color="#E6F3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ShellBackdropBrush" Color="#E6202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Fixed brand accent, theme-independent — see CLAUDE.md UI rules: NOT the OS SystemAccentColor. -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#2D7FF9" />
            <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#4A93FA" />
            <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#1E63D6" />
            <SolidColorBrush x:Key="AppSelectionBrush" Color="#282D7FF9" />
            <SolidColorBrush x:Key="AppTextSelectionBrush" Color="#402D7FF9" />

            <!-- Status colors, fixed so they read the same on both themes. -->
            <SolidColorBrush x:Key="WarnBrush" Color="#D9822B" />
            <SolidColorBrush x:Key="ActiveDotBrush" Color="#46A758" />
            <SolidColorBrush x:Key="ErrorBrush" Color="IndianRed" />

            <!-- Usage charts (metrics.k8s.io history, see Controls/Sparkline.cs). Fixed
                 hues so they read the same on both themes, and deliberately NOT the
                 ok/warn/error status colors: a CPU line is a measurement, not a verdict.
                 CPU reuses the brand accent; memory gets a distinct teal. -->
            <SolidColorBrush x:Key="UsageCpuStrokeBrush" Color="#2D7FF9" />
            <SolidColorBrush x:Key="UsageCpuAreaBrush" Color="#382D7FF9" />
            <SolidColorBrush x:Key="UsageMemoryStrokeBrush" Color="#12A594" />
            <SolidColorBrush x:Key="UsageMemoryAreaBrush" Color="#3812A594" />
            <SolidColorBrush x:Key="ChartBaselineBrush" Color="#38808080" />

            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>

            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#80808080" Opacity="0.06" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#80808080" Opacity="0.16" />
            <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#80808080" Opacity="0.1" />

            <!-- Nav pill highlight for TabItem — see pgNimbus's note: FluentTheme's
                 TabItem ControlTheme paints these DynamicResource brushes itself,
                 so overriding the resources (this include loads after FluentTheme)
                 restyles selection without replacing the control template. -->
            <StaticResource x:Key="TabItemHeaderBackgroundSelected" ResourceKey="AppSelectionBrush" />
            <StaticResource x:Key="TabItemHeaderBackgroundSelectedPointerOver" ResourceKey="AppSelectionBrush" />
            <StaticResource x:Key="TabItemHeaderBackgroundSelectedPressed" ResourceKey="AppSelectionBrush" />
            <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPointerOver" ResourceKey="HoverBackgroundBrush" />
            <StaticResource x:Key="TabItemHeaderBackgroundUnselectedPressed" ResourceKey="HoverBackgroundBrush" />
            <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="Transparent" />

            <!-- DataGrid row selection — brand accent instead of the OS accent. -->
            <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="AppAccentBrush" />
            <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="AppAccentBrush" />
            <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.157</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.235</x:Double>
            <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.157</x:Double>
            <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.235</x:Double>

            <!-- Slim 10px thumb-only overlay scrollbars, app-wide. -->
            <x:Double x:Key="ScrollBarSize">10</x:Double>
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
            <Color x:Key="ScrollBarThumbBackgroundColor">#66808080</Color>
            <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#99808080" />
            <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#B3808080" />
            <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#66808080" />
            <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="Transparent" />
            <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.3) translateX(-2px)</TransformOperations>
            <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.3) translateY(-2px)</TransformOperations>

            <!-- Vector icons (Material Design Icons, Apache-2.0, pictogrammers.com) —
                 general-purpose set ported from pgNimbus plus new Kubernetes-flavored glyphs. -->
            <StreamGeometry x:Key="MagnifyIconGeometry">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
