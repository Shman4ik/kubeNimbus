<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KubeNimbus.App.App"
             Name="kubeNimbus"
             RequestedThemeVariant="Default">
  <!-- Name is what macOS titles the application menu with, and what its About, Hide
       and Quit items are named after. Without it Avalonia supplies its own default and
       the app introduces itself to every Mac user as "Avalonia". It is the product name
       rather than the assembly name for the same reason <AssemblyName> is kubeNimbus:
       this is the string a user sees. -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <!-- The shared Nimbus design system (shared/nimbusUi, a git subtree). Loads
         after FluentTheme so its Fluent resource overrides win, and BEFORE this
         app's own Theme.axaml so the app can override a shared style. -->
    <StyleInclude Source="avares://Nimbus.Ui/Theme/Theme.axaml" />
    <StyleInclude Source="avares://kubeNimbus/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
