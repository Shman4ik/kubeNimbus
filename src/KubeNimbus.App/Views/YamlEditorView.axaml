<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:kconv="using:KubeNimbus.App.Converters"
             x:Class="KubeNimbus.App.Views.YamlEditorView"
             x:DataType="vm:YamlEditorTabViewModel">

  <Grid Name="Rows" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="10,8,10,10">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="0,0,0,8">
      <!-- No title here: the dock tab directly above already reads
           `Deployment/checkout-worker`, and this printed it again 44px lower, which is
           the panel-level title UI rule 10 removed from HelmReleaseView and RbacView.
           Unlike those two the row itself has to stay — it carries Reload/Apply/Delete —
           so what this buys is the row's whole flexible column back for the status
           texts, which on a long object name were being squeezed by a duplicate of the
           tab above them. Column 0 is left empty deliberately, so the tools stay
           right-aligned exactly where they were. -->

      <!-- Every in-flight state says so: an editor that silently swaps its text under
           you is indistinguishable from one that lost your edit (CLAUDE.md UI rule 9). -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="Reading from server…" Classes="statusText dim" IsVisible="{Binding IsRefreshing}" />
        <TextBlock Text="Working…" Classes="statusText dim" IsVisible="{Binding IsBusy}" />
      </StackPanel>

      <!-- A ToggleButton gets EITHER a two-way IsChecked binding OR a toggle Command,
           never both: OnClick() flips IsChecked before the Command runs, so a command
           that also flips it cancels the click out. The work happens in the view
           model's OnIsSecretValuesRevealedChanged hook. -->
      <ToggleButton Grid.Column="2" Classes="chip" Padding="7,3" FontSize="11" Margin="0,0,4,0"
                    IsVisible="{Binding CanRevealValues}" IsChecked="{Binding IsSecretValuesRevealed}"
                    ToolTip.Tip="Decode and show this object's base64 values (masked by default, decoded locally)"
                    Content="Reveal values" />
      <Button Grid.Column="3" Classes="toolbar" Command="{Binding ReloadCommand}" IsEnabled="{Binding !IsBusy}"
              ToolTip.Tip="Reload from server (discards unapplied edits)" Padding="6">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
      </Button>
      <Button Grid.Column="4" Classes="accent" Content="Apply" Command="{Binding ApplyCommand}"
              IsEnabled="{Binding !IsBusy}" Margin="8,0,0,0" />
      <Button Grid.Column="5" Content="Delete" Command="{Binding RequestDeleteCommand}" Margin="6,0,0,0"
              IsVisible="{Binding !IsConfirmingDelete}" IsEnabled="{Binding !IsBusy}" />
    </Grid>

    <!-- Row 1 is the editor's row, and the demo notice rides inside it rather than
         claiming a row of its own: the grid's later rows (apply preview, reveal panel,
         delete confirm, conflict, status) are addressed by index. Viewing is the genuinely useful half
         and stays — the object renders with full syntax highlighting — but there is no
         API server to apply to or delete from. Reload/Apply/Delete disable themselves
         (CanExecute on the view model); this says why, rather than leaving three dead
         buttons unexplained. -->
    <DockPanel Grid.Row="1">
      <Border DockPanel.Dock="Top" Classes="demoBar" Margin="0,0,0,8" IsVisible="{Binding IsDemo}">
        <!-- DockPanel, not a horizontal StackPanel: a StackPanel measures its children
             with infinite width, so TextWrapping never fires and the sentence is
             clipped by the dock's right edge instead of wrapping. -->
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                    VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Text="{x:Static vm:YamlEditorTabViewModel.DemoNotice}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>
      <Border Classes="card" Padding="0">
        <ae:TextEditor Name="Editor" ShowLineNumbers="True" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                       IsReadOnly="{Binding IsEditorReadOnly}" Margin="4" />
      </Border>
    </DockPanel>


    <!-- The server's own answer to "what would this apply do?", and the click that
         commits it. It sits directly under the editor because it is about the text
         above it, and it is present only while an apply is armed, so it costs nothing
         the rest of the time (UI rules 1 and 17). Height-capped: this is a ~300px dock
         and a 200-line diff would otherwise take the editor's whole share of it.

         Its row is star-sized from code-behind while a preview is open and Auto when
         it is not, so the diff and the editor split the dock rather than one evicting
         the other: an Auto row tall enough to read left a zero-height editor at the
         dock's default ~300px, and a MinHeight on the editor overflowed the dock and
         overlapped its own rows. Mutating a RowDefinition in code-behind is the same
         answer ClusterTabView.ApplyDockState reaches for, and for the same reason.

         A ContentControl with an inline DataTemplate, NOT a Border carrying both
         DataContext and x:DataType: x:DataType re-roots that element's own bindings
         too, so the pair compiles and then renders nothing at all, silently. That is
         the same trap the row-action strip fell into (UI rule 17). -->
    <ContentControl Grid.Row="2" Content="{Binding PendingPreview}" IsVisible="{Binding HasPendingPreview}">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:ApplyPreviewViewModel">
          <!-- Padding and margins are tighter than the pane's other cards on purpose: at
               the dock's default ~300px every 8px of chrome here is a line of the diff. -->
          <Border Classes="card" Padding="8" Margin="0,6,0,0">
            <DockPanel>
              <!-- One row of chrome above the diff, and the view-mode strip is part of it
                   (UI rule 10): the panel shares a ~300px dock with the editor, so a
                   strip on a row of its own would be two log-lines' worth of height spent
                   on three words. The strip is a ListBox.segmented for the same reason
                   pod detail's is — it is this app's control for exactly this job. -->
              <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <ListBox Grid.Column="0" Classes="segmented" IsVisible="{Binding HasBody}" Margin="0,0,8,0"
                         SelectedIndex="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).PreviewViewMode, Mode=TwoWay}">
                  <ListBoxItem Content="Diff" ToolTip.Tip="The manifest as a unified line diff" />
                  <ListBoxItem Content="Split" ToolTip.Tip="The same diff, old and new side by side" />
                  <ListBoxItem Content="Fields" ToolTip.Tip="The changed fields by path, matched the way Kubernetes merges them" />
                </ListBox>

                <TextBlock Grid.Column="1" Text="{Binding LineSummary}" FontFamily="Cascadia Mono,Consolas,monospace"
                           FontSize="11" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0"
                           IsVisible="{Binding HasBody}" ToolTip.Tip="Lines added and removed" />

                <TextBlock Grid.Column="2" Text="{Binding Headline}" Classes="statusText" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,8,0" />
                <Button Grid.Column="3" Classes="accent" Content="{Binding ConfirmLabel}"
                        Command="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).ConfirmPreviewCommand}" />
                <Button Grid.Column="4" Content="Cancel" Margin="6,0,0,0"
                        Command="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).CancelPreviewCommand}" />
              </Grid>

              <TextBlock DockPanel.Dock="Bottom" Text="{Binding Footnote}" FontSize="11" Opacity="0.6"
                         TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="{Binding HasFootnote}" />

              <!-- Three views of one answer, one at a time. All three are built from the
                   same pair of server documents, so they cannot disagree about what
                   would change. -->
              <Panel Margin="0,6,0,0">

                <!-- Unified line diff: the default, and the shape kubectl diff, git and
                     VS Code all show. It scrolls horizontally rather than wrapping —
                     a wrapped line stops lining up with the numbers beside it. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              IsVisible="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).PreviewViewMode, Converter={x:Static kconv:IndexEqualsConverter.Instance}, ConverterParameter=0}">
                  <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiffLineViewModel">
                        <Panel>
                          <!-- A collapsed run says how much it is standing in for; a gap
                               that does not state its size is a diff quietly withholding
                               part of the document. -->
                          <Border Classes="diffGap" IsVisible="{Binding IsSkipped}">
                            <TextBlock Text="{Binding SkippedText}" FontSize="10.5" Opacity="0.55"
                                       HorizontalAlignment="Center" />
                          </Border>
                          <Border Classes="diffLine" IsVisible="{Binding IsLine}"
                                  Classes.diffLineAdded="{Binding IsAdded}" Classes.diffLineRemoved="{Binding IsRemoved}">
                            <Grid ColumnDefinitions="32,32,13,*">
                              <TextBlock Grid.Column="0" Classes="diffGutter" Text="{Binding LeftNumber}" />
                              <TextBlock Grid.Column="1" Classes="diffGutter" Text="{Binding RightNumber}" />
                              <TextBlock Grid.Column="2" Classes="diffText" Text="{Binding Marker}"
                                         Classes.diffAdded="{Binding IsAdded}" Classes.diffRemoved="{Binding IsRemoved}" />
                              <SelectableTextBlock Grid.Column="3" Classes="diffText" Text="{Binding Text}" />
                            </Grid>
                          </Border>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- Side by side. Two equal columns, so a long line is trimmed with its
                     full text on the tooltip rather than wrapped: wrapping one side
                     pushes it out of step with the other, which is the one thing this
                     mode exists to keep. -->
                <ScrollViewer IsVisible="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).PreviewViewMode, Converter={x:Static kconv:IndexEqualsConverter.Instance}, ConverterParameter=1}">
                  <ItemsControl ItemsSource="{Binding SplitLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiffPairViewModel">
                        <Panel>
                          <Border Classes="diffGap" IsVisible="{Binding IsSkipped}">
                            <TextBlock Text="{Binding SkippedText}" FontSize="10.5" Opacity="0.55"
                                       HorizontalAlignment="Center" />
                          </Border>
                          <Grid ColumnDefinitions="*,10,*" IsVisible="{Binding !IsSkipped}">
                            <!-- The old side. An absent half is the alignment filler:
                                 a deleted line has to face a blank. -->
                            <Border Grid.Column="0" Classes="diffLine" Classes.diffLineRemoved="{Binding Left.IsRemoved}"
                                    Classes.diffFiller="{Binding !HasLeft}">
                              <Grid ColumnDefinitions="32,13,*" IsVisible="{Binding HasLeft}">
                                <TextBlock Grid.Column="0" Classes="diffGutter" Text="{Binding Left.LeftNumber}" />
                                <TextBlock Grid.Column="1" Classes="diffText" Text="{Binding Left.Marker}"
                                           Classes.diffRemoved="{Binding Left.IsRemoved}" />
                                <TextBlock Grid.Column="2" Classes="diffText" Text="{Binding Left.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Left.Text}" />
                              </Grid>
                            </Border>
                            <Border Grid.Column="2" Classes="diffLine" Classes.diffLineAdded="{Binding Right.IsAdded}"
                                    Classes.diffFiller="{Binding !HasRight}">
                              <Grid ColumnDefinitions="32,13,*" IsVisible="{Binding HasRight}">
                                <TextBlock Grid.Column="0" Classes="diffGutter" Text="{Binding Right.RightNumber}" />
                                <TextBlock Grid.Column="1" Classes="diffText" Text="{Binding Right.Marker}"
                                           Classes.diffAdded="{Binding Right.IsAdded}" />
                                <TextBlock Grid.Column="2" Classes="diffText" Text="{Binding Right.Text}"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Right.Text}" />
                              </Grid>
                            </Border>
                          </Grid>
                        </Panel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <!-- The field list: the semantic summary of the same two objects, and the
                     only one of the three that knows a container was inserted rather than
                     six of them rewritten. -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              IsVisible="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).PreviewViewMode, Converter={x:Static kconv:IndexEqualsConverter.Instance}, ConverterParameter=2}">
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DiffRowViewModel">
                        <Grid ColumnDefinitions="14,*" Margin="0,2">
                          <!-- A glyph as well as a colour: the two directions of a diff are
                               the last thing that should depend on telling red from green. -->
                          <TextBlock Grid.Column="0" Text="{Binding Marker}" FontFamily="Cascadia Mono,Consolas,monospace"
                                     FontSize="11.5" VerticalAlignment="Top"
                                     Classes.diffAdded="{Binding IsAdded}" Classes.diffRemoved="{Binding IsRemoved}"
                                     Classes.diffChanged="{Binding IsChanged}" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5"
                                       Classes.diffAdded="{Binding IsAdded}" Classes.diffRemoved="{Binding IsRemoved}"
                                       Classes.diffChanged="{Binding IsChanged}" />
                            <!-- Old above new, the way every diff is read. Selectable,
                                 because a previewed value is routinely the thing someone
                                 is about to paste somewhere else. -->
                            <SelectableTextBlock Text="{Binding Before}" FontFamily="Cascadia Mono,Consolas,monospace"
                                                 FontSize="11.5" TextWrapping="Wrap" Opacity="0.55"
                                                 TextDecorations="Strikethrough" IsVisible="{Binding !IsAdded}" />
                            <SelectableTextBlock Text="{Binding After}" FontFamily="Cascadia Mono,Consolas,monospace"
                                                 FontSize="11.5" TextWrapping="Wrap" Opacity="0.85"
                                                 IsVisible="{Binding !IsRemoved}" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- Decoded values. Height-capped and value-capped on purpose: this sits in a ~300px
         bottom dock, and a single 1 MiB Secret value would otherwise lay out in full to
         show one screenful of it. -->
    <Border Grid.Row="3" Classes="card" Padding="10" Margin="0,8,0,0" MaxHeight="160"
            IsVisible="{Binding IsSecretValuesRevealed}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding RevealCaption}" FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding RevealNotice}" Classes="statusText" Margin="0,6,0,0" TextWrapping="Wrap"
                   Classes.warn="{Binding IsRevealNoticeProblem}" Classes.dim="{Binding !IsRevealNoticeProblem}"
                   IsVisible="{Binding RevealNotice, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding RevealedValues}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RevealedValueViewModel">
                <Grid ColumnDefinitions="150,*,Auto" Margin="0,3">
                  <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Cascadia Mono,Consolas,monospace"
                             FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                  <StackPanel Grid.Column="1" Spacing="1" Margin="0,0,6,0">
                    <!-- Selectable, because the whole point of revealing a value is to use it,
                         and re-typing a password read off a label is nobody's idea of a feature. -->
                    <SelectableTextBlock Text="{Binding Value}" FontFamily="Cascadia Mono,Consolas,monospace"
                                         FontSize="11.5" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" TextWrapping="Wrap" Classes="statusText"
                               Classes.warn="{Binding IsProblem}" Classes.dim="{Binding !IsProblem}"
                               IsVisible="{Binding HasDetail}" />
                  </StackPanel>
                  <Button Grid.Column="2" Classes="toolbar" Padding="4" VerticalAlignment="Top"
                          IsVisible="{Binding CanCopy}" ToolTip.Tip="{Binding CopyTooltip}"
                          Command="{Binding $parent[UserControl].((vm:YamlEditorTabViewModel)DataContext).CopyRevealedValueCommand}"
                          CommandParameter="{Binding}">
                    <PathIcon Data="{StaticResource ContentCopyIconGeometry}" Width="12" Height="12" />
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Delete step 2. Its own strip rather than a pair of buttons swapped into the
         header: at dock height the header is a crowded row, and "Confirm delete" has
         to name what it deletes. -->
    <Border Grid.Row="4" Classes="card" Padding="10" Margin="0,8,0,0" IsVisible="{Binding IsConfirmingDelete}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="statusText warn" TextWrapping="Wrap" VerticalAlignment="Center"
                   Text="{Binding DeleteTargetDescription, StringFormat='Delete {0}? This cannot be undone.'}" />
        <Button Grid.Column="1" Content="Confirm delete" Foreground="IndianRed" Margin="8,0,0,0"
                IsEnabled="{Binding !IsBusy}" Command="{Binding ConfirmDeleteCommand}" />
        <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0" Command="{Binding CancelDeleteCommand}" />
      </Grid>
    </Border>

    <Border Grid.Row="5" Classes="card" Padding="10" Margin="0,8,0,0"
            IsVisible="{Binding ConflictDetails, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <TextBlock Text="Apply conflict — another field manager owns some of these fields." Classes="statusText warn" />
        <TextBlock Text="{Binding ConflictDetails}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
        <!-- Force-apply takes those fields away from their owner, so it says so and is
             offered only here, inside the conflict panel that explains what it would do.
             It used to be gated on the advanced view as well, which put the resolution
             to a conflict behind a switch about sidebar clutter — and the conflict is
             the one state in which this button is the answer. -->
        <Button Content="Force apply" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}"
                Command="{Binding ForceApplyCommand}" />
        <TextBlock Text="Reload and re-apply your change, or force apply to take ownership of these fields."
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Strict field validation refusing a field the server does not know. Its own
         panel rather than a line of status text, for the reason the conflict panel above
         has one: the server's sentence names a field in the document and the reader has
         to go and fix it. It carries no button, which is the difference from a conflict —
         there is nothing to force, and offering a retry here would be offering to apply
         the typo. An infoBar rather than a card, because this is a state (UI rule 11). -->
    <Border Grid.Row="6" Classes="infoBar error" Margin="0,8,0,0"
            IsVisible="{Binding ValidationDetails, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="6">
        <TextBlock Text="Nothing was applied — the server rejected a field it does not recognise."
                   Classes="statusText" />
        <SelectableTextBlock Text="{Binding ValidationDetails}" TextWrapping="Wrap" FontSize="11" Opacity="0.85" />
        <TextBlock Text="Correct the field above and apply again. A misspelled field would otherwise be dropped silently."
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="7" Spacing="4" Margin="0,6,0,0">
      <TextBlock Classes="statusText warn" TextWrapping="Wrap" IsVisible="{Binding IsDeleted}"
                 Text="Deleted from the cluster — this tab is read-only. Reload checks whether it came back." />
      <TextBlock Classes="statusText warn" TextWrapping="Wrap" Text="{Binding StaleNotice}"
                 IsVisible="{Binding StaleNotice, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                 IsVisible="{Binding ConflictDetails, Converter={x:Static conv:ObjectConverters.IsNull}}" />
    </StackPanel>
  </Grid>
</UserControl>
