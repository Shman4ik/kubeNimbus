<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             x:Class="KubeNimbus.App.Views.RowActionStrip"
             x:DataType="vm:RowActionViewModel">

  <!-- The armed-action strip (UI rule 17): the one confirm step for scale, rollout
       restart, delete, cordon, drain and Argo's sync and refresh. Shared by the Resources
       list and the Applications page, so the question, the busy state, the RBAC refusal
       and the success line are the same code in both places — three near-identical
       confirms is exactly how they would drift apart. See ClusterTabView for why it is
       hosted through an inline DataTemplate rather than a DataContext on a Border. -->
  <Border Classes="card" Padding="12,10">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="12.5" />

      <Border Classes="demoBar" IsVisible="{Binding IsDemo}">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                    VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Text="{x:Static vm:RowActionViewModel.DemoNotice}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- Drain.
           Two checkboxes and nothing else. They are kubectl's force and
           delete-emptydir-data flags, and each one authorizes destroying
           something that does not come back — so they are off by default and
           the plan names, by pod, exactly what each one would unblock.
           Re-planning happens as they are ticked, from the pod list already
           read, so the refusal disappears in front of you rather than on
           confirm. -->
      <StackPanel Spacing="6" IsVisible="{Binding IsDrain}">
        <TextBlock Classes="statusText" Text="{Binding DrainPlan.Summary}"
                   IsVisible="{Binding HasDrainPlan}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsEditable}">
          <CheckBox IsChecked="{Binding DrainForce}" Content="Evict unmanaged pods"
                    ToolTip.Tip="kubectl --force. A pod no controller owns is destroyed, not moved: nothing recreates it." />
          <CheckBox IsChecked="{Binding DrainDeleteEmptyDirData}" Content="Delete emptyDir data"
                    ToolTip.Tip="kubectl --delete-emptydir-data. An emptyDir lives on this node's disk and goes with the pod." />
        </StackPanel>

        <!-- Refusals, by name. The single most important thing on this strip:
             a drain that quietly took these pods is the silent data loss this
             whole classification exists to avoid. -->
        <Border Classes="infoBar warn" IsVisible="{Binding IsDrainBlocked}">
          <StackPanel Spacing="4">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="These pods will not be evicted without the matching option above — nothing would bring them back:" />
            <ItemsControl ItemsSource="{Binding DrainBlockers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- Prune, on a sync only. It is the half of a sync that deletes —
           resources that have left Git are removed from the cluster — so it gets
           the same treatment as the drain's two destructive options above: off
           by default, on screen rather than in a menu, and said in words. -->
      <CheckBox IsChecked="{Binding ArgoPrune}" Content="Prune resources removed from Git"
                IsVisible="{Binding IsArgoSync}" IsEnabled="{Binding IsEditable}"
                ToolTip.Tip="Argo's --prune. Objects the Application no longer declares are deleted from the cluster." />

      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Label above the input, never beside it: an Auto column has no gap of
             its own, which is how "Local port" ended up touching its own text box
             in the port-forward pane (UI rule 11). -->
        <StackPanel Grid.Column="0" IsVisible="{Binding IsScale}" Spacing="2">
          <TextBlock Classes="fieldLabel" Text="Replicas" />
          <NumericUpDown Name="ReplicaInput" Value="{Binding Replicas}" Minimum="0"
                         Maximum="{x:Static vm:RowActionViewModel.MaxReplicas}"
                         Increment="1" FormatString="0" MinWidth="120"
                         IsEnabled="{Binding IsEditable}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="statusText dim" VerticalAlignment="Bottom" Margin="10,0,0,8"
                   Text="{Binding CurrentScale}" IsVisible="{Binding IsScale}" />

        <Button Grid.Column="3" Content="{Binding ConfirmLabel}" Classes="accent" Margin="8,0,0,0"
                VerticalAlignment="Bottom" Command="{Binding ConfirmCommand}"
                IsVisible="{Binding IsPromptVisible}" />
        <!-- Cancel before, Close after: one slot, swapped on the state, rather
             than a live button beside a dead one (UI rule 11 again). Cancel goes
             dead while the request is in flight, and that is the honest state:
             the patch or delete is already with the API server, so a button that
             dismissed the strip there would read as "cancelled" over an action
             that went through. -->
        <Button Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Bottom" Content="Cancel"
                Command="{Binding DismissCommand}"
                IsVisible="{Binding IsPromptVisible}" IsEnabled="{Binding IsEditable}" />
        <Button Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Bottom" Content="Close"
                Command="{Binding DismissCommand}" IsVisible="{Binding IsDone}" />
        <!-- A running drain replaces Cancel outright. "Cancel" over a loop
             that is already evicting would read as undo, and there is no
             undo: Stop leaves the node cordoned with some pods moved, which
             is what the final message then says. -->
        <Button Grid.Column="3" Grid.ColumnSpan="2" Margin="8,0,0,0" VerticalAlignment="Bottom"
                HorizontalAlignment="Right" Classes="danger" Content="Stop draining"
                Command="{Binding StopDrainCommand}" IsVisible="{Binding IsDraining}" />
      </Grid>

      <TextBlock Classes="statusText warn" TextWrapping="Wrap" IsVisible="{Binding IsScalingToZero}"
                 Text="0 replicas stops every pod this workload owns. Nothing else about it is removed." />

      <!-- Every state gets a visual (UI rule 9): reading, in flight, the API
           server's own refusal (a 403 here names the subject, the verb and the
           resource), and the result. -->
      <Border Classes="infoBar" IsVisible="{Binding HasMessage}"
              Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
      </Border>

      <!-- The drain's own progress, one row per pod. Height-capped and
           scrollable: this strip sits above the list it is about, and a
           hundred-pod node must not push the list off screen. -->
      <ScrollViewer MaxHeight="150"
                    IsVisible="{Binding DrainSteps.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
        <ItemsControl ItemsSource="{Binding DrainSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DrainStepViewModel">
              <Grid ColumnDefinitions="Auto,260,*" Margin="0,1">
                <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Classes.ok="{Binding IsDone}"
                         Classes.warn="{Binding IsBlocked}"
                         Classes.error="{Binding IsFailed}" />
                <TextBlock Grid.Column="1" Text="{Binding PodKey}" FontSize="11.5"
                           FontFamily="Cascadia Mono,Consolas,monospace"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PodKey}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
