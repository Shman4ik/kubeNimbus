<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             x:Class="KubeNimbus.App.Views.RowActionStrip"
             x:DataType="vm:RowActionViewModel">

  <!-- The action strip (UI rule 17): the one confirm step for scale, rollout restart,
       delete, drain, a CronJob's run-now and resume and Argo's sync with prune, and the
       result line of the actions that fire on their click (cordon, uncordon, suspend,
       Argo's sync and refresh), which show no question and no prompt. Shared by the
       Resources list and the Applications page, so the question, the busy state, the RBAC
       refusal and the success line are the same code in both places — three near-identical
       confirms is exactly how they would drift apart. See ClusterTabView for why it is
       hosted through an inline DataTemplate rather than a DataContext on a Border.

       It reads as one sentence with its answer beside it (FEAT-77): the verb's glyph, then
       "Scale Deployment checkout-worker in payments on prod-eu (production) from 4
       replicas (1 running) to [6]",
       the consequence under it in the dim weight, and Scale / Cancel right after the text
       rather than at the far edge of the window. The block is capped at 900px and sits on
       the left of the card, so on a wide window the buttons stay with the sentence they
       answer. Everything an action adds (the demo notice, the drain plan, the scale
       warnings, the result line) stacks under the sentence in the same column.

       On a production cluster the card's own border takes the production colour
       (Border.card.actionStrip.production): no new element, no new row. The words are in
       the sentence, "(production)", because a colour alone is information only for someone
       who knows the code (UI rule 11). -->
  <UserControl.Styles>
    <!-- The strip's own parts (FEAT-77). The glyph is the verb's icon in a tinted square:
         accent for the reversible actions, red for the ones that destroy something
         (delete, drain, a sync that prunes), so the kind of question is legible before it
         is read. The sentence is 13px, a step above the 12px consequence under it. -->
    <Style Selector="Border.actionGlyph">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
      <Setter Property="Background" Value="{DynamicResource AppSelectionBrush}" />
    </Style>
    <Style Selector="Border.actionGlyph PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>
    <Style Selector="Border.actionGlyph.danger">
      <Setter Property="Background" Value="{DynamicResource AppDangerWashBrush}" />
    </Style>
    <Style Selector="Border.actionGlyph.danger PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
    <Style Selector="TextBlock.actionSentence">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ProgressBar.actionBusy">
      <Setter Property="Width" Value="28" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Height" Value="4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="PathIcon.actionResult">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="PathIcon.actionResult.success">
      <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
    </Style>
    <Style Selector="PathIcon.actionResult.error">
      <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
    </Style>
  </UserControl.Styles>

  <Border Classes="card actionStrip" Classes.production="{Binding IsProduction}" Padding="14,12"
          AutomationProperties.Name="{Binding Question}">
    <Grid ColumnDefinitions="Auto,*">
      <Border Grid.Column="0" Classes="actionGlyph" Classes.danger="{Binding IsDestructive}"
              VerticalAlignment="Top" Margin="0,0,12,0">
        <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                  Width="16" Height="16" />
      </Border>

      <StackPanel Grid.Column="1" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
        <!-- The question and its answer. The sentence column is a star so it wraps on a
             narrow window instead of pushing the buttons out of the card; the grid itself is
             left-aligned, so a short sentence keeps its buttons right beside it. -->
        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" IsVisible="{Binding IsQuestionVisible}">
          <StackPanel Name="QuestionText" Grid.Column="0" Spacing="3" VerticalAlignment="Center">
            <!-- A scale's replica box is the blank in the sentence ("… to [4]"), so the
                 sentence is its label (AutomationProperties.Name says "Replicas" for a
                 screen reader). Rule 11's label-above-the-input is for a form field; this
                 is not one, and the 10px margin is the gap whose absence that rule was
                 about. The box is an inline in the sentence, not docked beside it: docked,
                 a sentence that wrapped (a long cluster name) left "to" alone on its second
                 line with the box centred beside both, reading "(1 running) [6]" over "to".
                 Inline, and drawn together with "to" as one unit, it always follows the word it
                 completes; a wrap moves both. -->
            <TextBlock Name="ActionSentence" Classes="actionSentence" TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="{Binding Verb}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding TargetKind}" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" /><Run Text=" " /><Run Text="{Binding TargetName}" FontWeight="SemiBold" /><Run Text="{Binding TargetPlace}" /><Run Text="{Binding SuffixBeforeBlank}" /><InlineUIContainer BaselineAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="10" Margin="4,2,0,2" IsVisible="{Binding IsScale}"><TextBlock Name="BlankLead" Classes="actionSentence" Text="to" VerticalAlignment="Center" /><NumericUpDown Name="ReplicaInput"
                             VerticalAlignment="Center"
                             AutomationProperties.Name="Replicas"
                             Value="{Binding Replicas}" Minimum="0"
                             Maximum="{x:Static vm:RowActionViewModel.MaxReplicas}"
                             Increment="1" FormatString="0" MinWidth="110"
                             IsEnabled="{Binding IsEditable}" /></StackPanel></InlineUIContainer></TextBlock>

            <TextBlock Classes="statusText dim" Text="{Binding Consequence}" TextWrapping="Wrap"
                       IsVisible="{Binding HasConsequence}" />
            <!-- The number in the box, checked (B3-4): every pod stopping, or a jump of ten
                 times or more. A line of warn text under the sentence it qualifies, except
                 scaling a production workload to zero, which is an outage and gets the warn
                 infoBar below. Neither disables the confirm. -->
            <TextBlock Classes="statusText warn" TextWrapping="Wrap" IsVisible="{Binding HasPlainScaleWarning}"
                       Text="{Binding ScaleWarning}" />
          </StackPanel>

          <!-- The answer, right after the question. Present only while the action is a
               question: once it has an answer the result line below is the strip's last
               word, and Close sits on it. -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsPromptVisible}">
            <!-- Red for the ones that destroy something (delete, drain, a sync that prunes),
                 the accent for the rest — a destructive verb looks destructive (UI rule 20). -->
            <Button Name="ConfirmButton" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}"
                    Classes.accent="{Binding !IsDestructive}" Classes.danger="{Binding IsDestructive}" />
            <!-- Cancel goes dead while the request is in flight, and that is the honest
                 state: the patch or delete is already with the API server, so a button that
                 dismissed the strip there would read as "cancelled" over an action that went
                 through. Its after-the-fact twin, Close, is on the result line below. -->
            <Button Content="Cancel" Classes="soft" Command="{Binding DismissCommand}"
                    IsEnabled="{Binding IsEditable}" />
          </StackPanel>
        </Grid>

        <Border Classes="infoBar warn" IsVisible="{Binding IsScaleWarningProminent}">
          <TextBlock Text="{Binding ScaleWarning}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
        </Border>

        <Border Classes="demoBar" IsVisible="{Binding IsDemoNoticeVisible}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                      VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Text="{x:Static vm:RowActionViewModel.DemoNotice}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>

        <!-- Drain.
             Two checkboxes and nothing else. They are kubectl's force and
             delete-emptydir-data flags, and each one authorizes destroying
             something that does not come back — so they are off by default and
             the plan names, by pod, exactly what each one would unblock.
             Re-planning happens as they are ticked, from the pod list already
             read, so the refusal disappears in front of you rather than on
             confirm. -->
        <StackPanel Spacing="6" IsVisible="{Binding IsDrain}">
          <TextBlock Classes="statusText" Text="{Binding DrainPlan.Summary}"
                     IsVisible="{Binding HasDrainPlan}" TextWrapping="Wrap" />

          <!-- The options row doubles as the running drain's control row: while it runs the
               two options are read-only (they are what the loop was started with; ticking one
               mid-drain changes nothing) and Stop draining takes the right-hand end of the
               same row, rather than a 40px row of its own below it (ENG-28). -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsEditable}">
            <CheckBox Grid.Column="0" IsChecked="{Binding DrainForce}" Content="Evict unmanaged pods"
                      IsEnabled="{Binding !IsDraining}"
                      ToolTip.Tip="kubectl --force. A pod no controller owns is destroyed, not moved: nothing recreates it." />
            <CheckBox Grid.Column="1" IsChecked="{Binding DrainDeleteEmptyDirData}" Content="Delete emptyDir data"
                      Margin="16,0,0,0" IsEnabled="{Binding !IsDraining}"
                      ToolTip.Tip="kubectl --delete-emptydir-data. An emptyDir lives on this node's disk and goes with the pod." />
            <!-- A running drain replaces Cancel outright. "Cancel" over a loop that is
                 already evicting would read as undo, and there is no undo: Stop leaves the
                 node cordoned with some pods moved, which is what the final message then
                 says. The confirm/cancel pair above is hidden for as long as this shows. -->
            <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                    Classes="danger" Content="Stop draining"
                    Command="{Binding StopDrainCommand}" IsVisible="{Binding IsDraining}" />
          </Grid>

          <!-- Refusals, by name. The single most important thing on this strip:
               a drain that quietly took these pods is the silent data loss this
               whole classification exists to avoid. -->
          <Border Classes="infoBar warn" IsVisible="{Binding IsDrainBlocked}">
            <StackPanel Spacing="4">
              <TextBlock FontSize="12" TextWrapping="Wrap"
                         Text="These pods will not be evicted without the matching option above — nothing would bring them back:" />
              <ItemsControl ItemsSource="{Binding DrainBlockers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>


        <!-- Every state gets a visual (UI rule 9): reading, in flight, the API server's own
             refusal (a 403 here names the subject, the verb and the resource), and the
             result. Each leads with its own mark — a moving bar while something is in
             flight, a check, an alert — so the state reads before the sentence does. -->
        <Border Classes="infoBar" IsVisible="{Binding HasMessage}"
                Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}">
          <!-- Once the action is done its result is the strip's last word, so the way out
               sits on that line rather than on a row of its own under a disabled form: Close,
               and before it a CronJob run-now's one natural next step, Open Job (present
               only once the server has named the Job). The negative margins keep the bar's
               height that of its text. -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <Panel Grid.Column="0" VerticalAlignment="Center">
              <ProgressBar Classes="actionBusy" IsIndeterminate="True" IsVisible="{Binding IsWorking}" />
              <PathIcon Classes="actionResult success" Data="{StaticResource CheckIconGeometry}"
                        IsVisible="{Binding IsSuccess}" />
              <PathIcon Classes="actionResult error" Data="{StaticResource AlertCircleIconGeometry}"
                        IsVisible="{Binding IsError}" />
            </Panel>
            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Open Job" Classes="accent" Margin="12,-4,0,-4"
                    Padding="10,3" VerticalAlignment="Center"
                    Command="{Binding OpenCreatedJobCommand}" IsVisible="{Binding HasFollowUp}" />
            <Button Grid.Column="3" Content="Close" Classes="soft" Margin="8,-4,-4,-4"
                    Padding="10,3" VerticalAlignment="Center"
                    Command="{Binding DismissCommand}" IsVisible="{Binding IsDone}" />
          </Grid>
        </Border>

        <!-- The drain's own progress, one row per pod. Height-capped and
             scrollable: this strip sits above the list it is about, and a
             hundred-pod node must not push the list off screen. -->
        <ScrollViewer MaxHeight="150"
                      IsVisible="{Binding DrainSteps.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
          <ItemsControl ItemsSource="{Binding DrainSteps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DrainStepViewModel">
                <Grid ColumnDefinitions="Auto,260,*" Margin="0,1">
                  <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Classes.ok="{Binding IsDone}"
                           Classes.warn="{Binding IsBlocked}"
                           Classes.error="{Binding IsFailed}" />
                  <TextBlock Grid.Column="1" Text="{Binding PodKey}" FontSize="11.5"
                             Classes="mono"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PodKey}" />
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Opacity="0.75"
                             TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
