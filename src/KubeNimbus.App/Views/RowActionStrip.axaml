<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             x:Class="KubeNimbus.App.Views.RowActionStrip"
             x:DataType="vm:RowActionViewModel">

  <!-- The action strip (UI rule 17): the one confirm step for scale, rollout restart,
       delete, drain, a CronJob's run-now and resume and Argo's sync with prune, and the
       result line of the actions that fire on their click (cordon, uncordon, suspend,
       Argo's sync and refresh), which show no question and no prompt row. Shared by the
       Resources list and the Applications page, so the question, the busy state, the RBAC
       refusal and the success line are the same code in both places — three near-identical
       confirms is exactly how they would drift apart. See ClusterTabView for why it is
       hosted through an inline DataTemplate rather than a DataContext on a Border. -->
  <!-- On a production cluster the card's own border takes the production colour
       (Border.card.actionStrip.production): no new element, no new row, present only while
       an action is armed there. The words are in Target, "(production)", because a colour
       alone is information only for someone who knows the code (UI rule 11). -->
  <Border Classes="card actionStrip" Classes.production="{Binding IsProduction}" Padding="12,10">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="12.5"
                 IsVisible="{Binding IsQuestionVisible}" />

      <Border Classes="demoBar" IsVisible="{Binding IsDemoNoticeVisible}">
        <DockPanel>
          <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                    VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Text="{x:Static vm:RowActionViewModel.DemoNotice}" TextWrapping="Wrap" />
        </DockPanel>
      </Border>

      <!-- Drain.
           Two checkboxes and nothing else. They are kubectl's force and
           delete-emptydir-data flags, and each one authorizes destroying
           something that does not come back — so they are off by default and
           the plan names, by pod, exactly what each one would unblock.
           Re-planning happens as they are ticked, from the pod list already
           read, so the refusal disappears in front of you rather than on
           confirm. -->
      <StackPanel Spacing="6" IsVisible="{Binding IsDrain}">
        <TextBlock Classes="statusText" Text="{Binding DrainPlan.Summary}"
                   IsVisible="{Binding HasDrainPlan}" TextWrapping="Wrap" />

        <!-- The options row doubles as the running drain's control row: while it runs the
             two options are read-only (they are what the loop was started with; ticking one
             mid-drain changes nothing) and Stop draining takes the right-hand end of the
             same row, rather than a 40px row of its own below it (ENG-28). -->
        <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsEditable}">
          <CheckBox Grid.Column="0" IsChecked="{Binding DrainForce}" Content="Evict unmanaged pods"
                    IsEnabled="{Binding !IsDraining}"
                    ToolTip.Tip="kubectl --force. A pod no controller owns is destroyed, not moved: nothing recreates it." />
          <CheckBox Grid.Column="1" IsChecked="{Binding DrainDeleteEmptyDirData}" Content="Delete emptyDir data"
                    Margin="16,0,0,0" IsEnabled="{Binding !IsDraining}"
                    ToolTip.Tip="kubectl --delete-emptydir-data. An emptyDir lives on this node's disk and goes with the pod." />
          <!-- A running drain replaces Cancel outright. "Cancel" over a loop that is
               already evicting would read as undo, and there is no undo: Stop leaves the
               node cordoned with some pods moved, which is what the final message then
               says. The confirm/cancel row below is hidden for as long as this shows. -->
          <Button Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center"
                  Classes="danger" Content="Stop draining"
                  Command="{Binding StopDrainCommand}" IsVisible="{Binding IsDraining}" />
        </Grid>

        <!-- Refusals, by name. The single most important thing on this strip:
             a drain that quietly took these pods is the silent data loss this
             whole classification exists to avoid. -->
        <Border Classes="infoBar warn" IsVisible="{Binding IsDrainBlocked}">
          <StackPanel Spacing="4">
            <TextBlock FontSize="12" TextWrapping="Wrap"
                       Text="These pods will not be evicted without the matching option above — nothing would bring them back:" />
            <ItemsControl ItemsSource="{Binding DrainBlockers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>

      <!-- The prompt row: present only while the action is a question. Once it has an
           answer the result line below is the whole strip, and Close sits on it. -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" IsVisible="{Binding IsPromptVisible}">
        <!-- Label above the input, never beside it: an Auto column has no gap of
             its own, which is how "Local port" ended up touching its own text box
             in the port-forward pane (UI rule 11). -->
        <StackPanel Grid.Column="0" IsVisible="{Binding IsScale}" Spacing="2">
          <TextBlock Name="ReplicasLabel" Classes="fieldLabel" Text="Replicas" />
          <NumericUpDown Name="ReplicaInput" Value="{Binding Replicas}" AutomationProperties.LabeledBy="{Binding #ReplicasLabel}" Minimum="0"
                         Maximum="{x:Static vm:RowActionViewModel.MaxReplicas}"
                         Increment="1" FormatString="0" MinWidth="120"
                         IsEnabled="{Binding IsEditable}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="statusText dim" VerticalAlignment="Bottom" Margin="10,0,0,8"
                   Text="{Binding CurrentScale}" IsVisible="{Binding IsScale}" />

        <Button Grid.Column="3" Content="{Binding ConfirmLabel}" Classes="accent" Margin="8,0,0,0"
                VerticalAlignment="Bottom" Command="{Binding ConfirmCommand}"
                IsVisible="{Binding IsPromptVisible}" />
        <!-- Cancel goes dead while the request is in flight, and that is the honest
             state: the patch or delete is already with the API server, so a button that
             dismissed the strip there would read as "cancelled" over an action that went
             through. Its after-the-fact twin, Close, is on the result line below. -->
        <Button Grid.Column="4" Margin="6,0,0,0" VerticalAlignment="Bottom" Content="Cancel"
                Command="{Binding DismissCommand}" IsEnabled="{Binding IsEditable}" />
      </Grid>

      <!-- The number in the box, checked (B3-4): every pod stopping, or a jump of ten times
           or more. A line of warn text, except scaling a production workload to zero, which
           is an outage and gets the warn infoBar. Neither disables the confirm. -->
      <TextBlock Classes="statusText warn" TextWrapping="Wrap" IsVisible="{Binding HasPlainScaleWarning}"
                 Text="{Binding ScaleWarning}" />
      <Border Classes="infoBar warn" IsVisible="{Binding IsScaleWarningProminent}">
        <TextBlock Text="{Binding ScaleWarning}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
      </Border>

      <!-- Every state gets a visual (UI rule 9): reading, in flight, the API
           server's own refusal (a 403 here names the subject, the verb and the
           resource), and the result. -->
      <Border Classes="infoBar" IsVisible="{Binding HasMessage}"
              Classes.success="{Binding IsSuccess}" Classes.error="{Binding IsError}">
        <!-- Once the action is done its result is the strip's last word, so the way out
             sits on that line rather than on a row of its own under a disabled form: Close,
             and before it a CronJob run-now's one natural next step, Open Job (present
             only once the server has named the Job). The negative margins keep the bar's
             height that of its text. -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Open Job" Classes="accent" Margin="12,-4,0,-4"
                  Padding="10,3" VerticalAlignment="Center"
                  Command="{Binding OpenCreatedJobCommand}" IsVisible="{Binding HasFollowUp}" />
          <Button Grid.Column="2" Content="Close" Classes="soft" Margin="8,-4,-4,-4"
                  Padding="10,3" VerticalAlignment="Center"
                  Command="{Binding DismissCommand}" IsVisible="{Binding IsDone}" />
        </Grid>
      </Border>

      <!-- The drain's own progress, one row per pod. Height-capped and
           scrollable: this strip sits above the list it is about, and a
           hundred-pod node must not push the list off screen. -->
      <ScrollViewer MaxHeight="150"
                    IsVisible="{Binding DrainSteps.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
        <ItemsControl ItemsSource="{Binding DrainSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DrainStepViewModel">
              <Grid ColumnDefinitions="Auto,260,*" Margin="0,1">
                <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="0,0,8,0"
                         Classes.ok="{Binding IsDone}"
                         Classes.warn="{Binding IsBlocked}"
                         Classes.error="{Binding IsFailed}" />
                <TextBlock Grid.Column="1" Text="{Binding PodKey}" FontSize="11.5"
                           Classes="mono"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PodKey}" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Opacity="0.75"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</UserControl>
