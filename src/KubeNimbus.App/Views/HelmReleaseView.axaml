<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:aconv="using:Avalonia.Data.Converters"
             x:Class="KubeNimbus.App.Views.HelmReleaseView"
             x:DataType="vm:HelmReleaseTabViewModel">

  <!-- One row of chrome, not two: the title row said `ReleaseName` and the dock tab
       above it already says `Helm/<ReleaseName>`, so only the chart and revision were
       ever news — and they fit beside the tab strip. -->
  <Grid RowDefinitions="Auto,*" Margin="10,8,10,10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
      <ListBox Grid.Column="0" Name="HelmTabStrip" Classes="segmented" SelectedIndex="0"
               IsVisible="{Binding ErrorMessage, Converter={x:Static aconv:ObjectConverters.IsNull}}">
        <ListBoxItem Content="Values" />
        <ListBoxItem Content="Manifest" />
        <ListBoxItem Content="Notes" />
        <ListBoxItem Content="History" />
      </ListBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding SelectedRevision.Chart}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding SelectedRevision.Revision, StringFormat='revision {0}'}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="Loading…" Opacity="0.55" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                 IsVisible="{Binding IsLoading}" />
      <Button Grid.Column="3" Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="Reload from cluster" Padding="6">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
      </Button>
    </Grid>

    <Border Grid.Row="1" Classes="card" Padding="10"
            IsVisible="{Binding ErrorMessage, Converter={x:Static aconv:ObjectConverters.IsNotNull}}">
      <TextBlock Text="{Binding ErrorMessage}" Classes="statusText warn" TextWrapping="Wrap" />
    </Border>

    <TabControl Grid.Row="1" Classes="headerless" SelectedIndex="{Binding #HelmTabStrip.SelectedIndex}"
                IsVisible="{Binding ErrorMessage, Converter={x:Static aconv:ObjectConverters.IsNull}}">

      <TabItem Header="Values">
        <Grid>
          <Border Classes="card" Padding="0">
            <ae:TextEditor Name="ValuesEditor" IsReadOnly="True" ShowLineNumbers="True"
                           FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Margin="4" />
          </Border>
          <TextBlock Text="This release was installed with chart defaults — no user values."
                     Opacity="0.55" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !HasValues}" />
        </Grid>
      </TabItem>

      <TabItem Header="Manifest">
        <Border Classes="card" Padding="0">
          <ae:TextEditor Name="ManifestEditor" IsReadOnly="True" ShowLineNumbers="True"
                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Margin="4" />
        </Border>
      </TabItem>

      <TabItem Header="Notes">
        <Grid>
          <Border Classes="card" Padding="8">
            <ScrollViewer>
              <SelectableTextBlock Text="{Binding Notes}" FontFamily="Cascadia Mono,Consolas,monospace"
                                   FontSize="11.5" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <TextBlock Text="This chart renders no notes." Opacity="0.55" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasNotes}" />
        </Grid>
      </TabItem>

      <TabItem Header="History">
        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedRevision}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                  DoubleTapped="OnHistoryRowDoubleTapped">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Rev" Width="Auto" MinWidth="50">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <TextBlock Text="{Binding Revision}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="110">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <Border Classes="statusPill" Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                          Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                          Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}">
                    <TextBlock Text="{Binding Status}" FontSize="11.5" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Chart" Width="Auto" MinWidth="140">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <TextBlock Text="{Binding Chart}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="App" Width="Auto" MinWidth="70">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Updated" Width="Auto" MinWidth="150">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <TextBlock Text="{Binding Updated}" Opacity="0.75" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Description" Width="*" MinWidth="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                  <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Description}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
