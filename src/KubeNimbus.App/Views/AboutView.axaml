<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="KubeNimbus.App.Views.AboutView">
    <!-- The macOS-style About box: name, version, license — nothing more. Version and
         copyright are filled in code-behind from the entry assembly, so the release
         pipeline's -p:Version is the only source and this cannot claim a version the
         binary isn't. Same shape as pgNimbus's. -->
    <StackPanel Margin="28,12,28,28" Spacing="4">
        <TextBlock Text="kubeNimbus" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock Name="VersionText" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
        <TextBlock Text="A fast, open-source Kubernetes client"
                   FontSize="12" Opacity="0.8" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <TextBlock Name="CopyrightText" FontSize="11" Opacity="0.5" HorizontalAlignment="Center" Margin="0,2,0,0" />
        <Button Classes="soft" Content="kubeNimbus on GitHub" HorizontalAlignment="Center" Margin="0,14,0,0"
                Click="OnGitHubClick" />
    </StackPanel>
</UserControl>
