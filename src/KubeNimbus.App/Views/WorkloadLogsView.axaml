<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:controls="using:KubeNimbus.App.Controls"
             xmlns:sys="using:System"
             x:Class="KubeNimbus.App.Views.WorkloadLogsView"
             x:DataType="vm:WorkloadLogsTabViewModel">

  <!-- Two rows of chrome and no more (UI rule 10), and neither of them repeats the
       dock tab's own `Logs/<workload>` heading. Row 1 is the pod strip, which is both
       the colour legend and the selector; row 2 is the filter and the display toggles.
       The strip scrolls horizontally rather than wrapping, for the same reason pod
       detail's container strip does: fifty replicas must cost the dock the same height
       as three. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10,8,10,10">

    <!-- Pod strip. ToggleButtons bound to IsIncluded and to NOTHING else — a Command
         beside a two-way IsChecked flips the property twice per click and lands where
         it started (UI rule 8b); the view model listens for the property instead. -->
    <!-- Hidden when the pane is embedded in an application page, whose own pod list is the
         selector there; a second strip of the same pods would be two controls for one
         choice. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6" IsVisible="{Binding !IsEmbedded}">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sources}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogSourceViewModel">
              <ToggleButton Classes="chip" Padding="8,3" IsChecked="{Binding IsIncluded}"
                            ToolTip.Tip="{Binding Tooltip}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- The colour key itself. A real brush off the view model, never a
                       converter that can return null — a null Foreground is local, beats
                       inheritance, and Avalonia's glyph draw early-returns on it, which
                       is how log lines once rendered invisible. -->
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Brush}" />
                  <TextBlock Text="{Binding ShortName}" FontSize="12" VerticalAlignment="Center"
                             Classes="mono"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                  <TextBlock Text="{Binding StateLabel}" FontSize="10" Opacity="0.85" VerticalAlignment="Center"
                             Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"
                             IsVisible="{Binding HasStateLabel}" />
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Grid.Column="1" Text="{Binding Summary}" Classes="sectionHeader" VerticalAlignment="Center"
                 Margin="10,0,0,0" />
    </Grid>

    <!-- Search + display toggles. The search finds by default and filters with the funnel
         chip on — the same box, the same keys, as pod detail's pane. -->
    <Grid Name="LogBarRow" Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
      <TextBox Name="LogSearchBox" Grid.Column="0" Classes="filterbox" MaxWidth="400" HorizontalAlignment="Left" MinWidth="230"
               Text="{Binding LogSearchText}" PlaceholderText="Search logs…">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="11" Height="11" Opacity="0.5" Margin="8,0,0,0" />
        </TextBox.InnerLeftContent>
        <TextBox.InnerRightContent>
          <StackPanel Orientation="Horizontal" Spacing="1" Margin="0,0,3,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding LogSearchSummary}" FontSize="10.5" Opacity="0.6" VerticalAlignment="Center"
                       Margin="0,0,3,0" IsVisible="{Binding HasLogSearch}" />
            <Button Classes="toolbar" Padding="3" Command="{Binding FindPreviousLogMatchCommand}" IsVisible="{Binding IsFinding}"
                    Focusable="False" ToolTip.Tip="Previous (earlier) match — Shift+Enter">
              <PathIcon Data="{StaticResource ChevronUpIconGeometry}" Width="11" Height="11" />
            </Button>
            <Button Classes="toolbar" Padding="3" Command="{Binding FindNextLogMatchCommand}" IsVisible="{Binding IsFinding}"
                    Focusable="False" ToolTip.Tip="Next (later) match — Enter">
              <PathIcon Data="{StaticResource ChevronDownIconGeometry}" Width="11" Height="11" />
            </Button>
            <Button Classes="toolbar" Padding="3" Command="{Binding PinSearchCommand}" IsVisible="{Binding HasLogSearch}"
                    Focusable="False" ToolTip.Tip="Pin this search as a coloured highlight and search for something else — Alt+P">
              <PathIcon Data="{StaticResource PinOutlineIconGeometry}" Width="11" Height="11" />
            </Button>
            <ToggleButton Classes="chip checkedAccent logSearchOption" Focusable="False" IsChecked="{Binding IsLogMatchCase}"
                          ToolTip.Tip="Match case — Alt+C" Content="Aa" />
            <ToggleButton Classes="chip checkedAccent logSearchOption" Focusable="False" IsChecked="{Binding IsLogRegex}"
                          ToolTip.Tip="Regular expression — Alt+R" Content=".*" />
            <ToggleButton Classes="chip checkedAccent" Padding="4" Focusable="False" IsChecked="{Binding IsLogFilterMode}"
                          ToolTip.Tip="Filter: hide the lines that don't match, instead of highlighting the matches among them">
              <PathIcon Data="{StaticResource FilterVariantIconGeometry}" Width="11" Height="11" />
            </ToggleButton>
          </StackPanel>
        </TextBox.InnerRightContent>
      </TextBox>

      <StackPanel Name="LogBarTools" Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <!-- Context around each match, grep -C. Only while the search filters: in find mode
             every line is already on screen. -->
        <!-- A chip rather than a combo box: the row already holds the search box and the
             problem counts, and a caption of "±2" says as much as "±2 lines" did. -->
        <!-- The three slots (context, Range, Levels) are what LogBarOverflow hides at a
             narrow window; the copies in the ⋯ menu then show (ENG-51). -->
        <Panel Name="ContextSlot">
        <Button Classes="chip" Padding="7,3" FontSize="11" Margin="0,0,4,0" IsVisible="{Binding IsLogFilterMode}"
                Classes.accentText="{Binding LogContextLines, Converter={x:Static conv:CountToBoolConverter.Instance}}"
                ToolTip.Tip="Lines to keep around each match while filtering, like grep -C">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding LogContextLines, Converter={x:Static conv:LogContextLabelConverter.Instance}, ConverterParameter=short}" VerticalAlignment="Center" />
            <PathIcon Data="{StaticResource ChevronDownIconGeometry}" Width="8" Height="8" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="4" MinWidth="160">
                <TextBlock Text="Context around each match" FontSize="11" Opacity="0.6" />
                <ListBox ItemsSource="{Binding LogContextChoices}" SelectedItem="{Binding LogContextLines}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="sys:Int32">
                      <TextBlock Text="{Binding Converter={x:Static conv:LogContextLabelConverter.Instance}}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        </Panel>
        <!-- The problems among the shown lines, and the jump between them (LogProblems).
             Each count is only there when it is not zero. -->
        <Button Classes="chip logProblem error" Command="{Binding Problems.PreviousErrorCommand}"
                IsVisible="{Binding Problems.HasErrors}" ToolTip.Tip="{Binding Problems.ErrorTip}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource AlertCircleIconGeometry}" Width="11" Height="11" />
            <TextBlock Text="{Binding Problems.ErrorCount, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Classes="chip logProblem warn" Command="{Binding Problems.PreviousWarningCommand}" Margin="0,0,4,0"
                IsVisible="{Binding Problems.HasWarnings}" ToolTip.Tip="{Binding Problems.WarningTip}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource AlertIconGeometry}" Width="11" Height="11" />
            <TextBlock Text="{Binding Problems.WarningCount, StringFormat='{}{0:N0}'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Errors only: the application page's narrowing, over the same severity classes
             the lines are coloured with. Two-way IsChecked and no Command (UI rule 8b).
             Offered only where the pane is embedded, so the dock's pane is unchanged. -->
        <ToggleButton Name="ErrorsOnlyToggle" Classes="chip checkedAccent" Padding="7,3" FontSize="11" Margin="0,0,4,0"
                      IsChecked="{Binding ShowErrorsOnly}" IsVisible="{Binding IsEmbedded}"
                      ToolTip.Tip="Show only the lines coloured as errors; every line stays buffered"
                      Content="Errors only" />
        <Panel Name="RangeSlot">
        <ComboBox Width="132" MinHeight="27" FontSize="11" Margin="0,0,4,0"
                  ItemsSource="{Binding LogRanges}" SelectedItem="{Binding SelectedLogRange}"
                  IsEnabled="{Binding !IsDemo}"
                  ToolTip.Tip="Log range (unavailable for canned demo streams)">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRange">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        </Panel>
        <ToggleButton Classes="chip" Padding="6" IsChecked="{Binding IsFollowing}"
                      ToolTip.Tip="Follow every pod (cancels all streams when toggled off)">
          <PathIcon Data="{StaticResource PlayIconGeometry}" Width="12" Height="12" />
        </ToggleButton>
        <!-- Levels (FEAT-36). Not offered where the pane is embedded: the application page's
             Errors only is the narrowing there, and two severity controls side by side
             would be two answers to one question. -->
        <Panel Name="LevelsSlot">
        <Button Classes="chip" Padding="7,3" FontSize="11" Classes.accentText="{Binding Levels.IsFiltering}"
                IsVisible="{Binding !IsEmbedded}"
                ToolTip.Tip="Which severities to show. Lines with no level keyword are always shown.">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="{Binding Levels.Label}" VerticalAlignment="Center" />
            <PathIcon Data="{StaticResource ChevronDownIconGeometry}" Width="8" Height="8" VerticalAlignment="Center" />
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MaxWidth="220">
                <CheckBox IsChecked="{Binding Levels.ShowError}" Content="Error" />
                <CheckBox IsChecked="{Binding Levels.ShowWarn}" Content="Warn" />
                <CheckBox IsChecked="{Binding Levels.ShowInfo}" Content="Info" />
                <TextBlock Text="Lines with no level keyword are always shown." FontSize="11" Opacity="0.6"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        </Panel>
        <!-- Copy stays on the bar: it is the one gesture for getting a log into a bug report.
             The rest — the three remembered display toggles, Clear and Save — are in the
             overflow menu. The bar used to carry all six beside Range, Follow, Previous and
             Levels, ten controls in a row of icons and words. CheckBoxes with a two-way
             IsChecked and no Command (UI rule 8b); Clear and Save close the menu as they run. -->
        <Button Classes="toolbar" Command="{Binding CopyLogsCommand}"
                ToolTip.Tip="Copy the visible lines, pod-prefixed and with timestamps" Padding="6">
          <PathIcon Data="{StaticResource ContentCopyIconGeometry}" Width="13" Height="13" />
        </Button>
        <Button Name="LogMenuButton" Classes="toolbar" Padding="6" ToolTip.Tip="Display options, Clear and Save">
          <PathIcon Data="{StaticResource DotsHorizontalIconGeometry}" Width="13" Height="13" />
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="2" MinWidth="200">
                <!-- What the bar had no room for at this width (LogBarOverflow): hidden until then. -->
                <StackPanel Name="MenuRange" Spacing="4" Margin="0,0,0,8" IsVisible="False">
                  <TextBlock Text="Range" FontSize="11" Opacity="0.6" />
                  <ComboBox HorizontalAlignment="Stretch" MinHeight="27" FontSize="11"
                            ItemsSource="{Binding LogRanges}" SelectedItem="{Binding SelectedLogRange}"
                            IsEnabled="{Binding !IsDemo}"
                            ToolTip.Tip="Log range (unavailable for canned demo streams)">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LogRange">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Panel Name="MenuLevels" IsVisible="False">
                  <StackPanel Spacing="2" Margin="0,0,0,8" IsVisible="{Binding !IsEmbedded}">
                    <TextBlock Text="Levels — lines with no level keyword are always shown" FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap" MaxWidth="220" HorizontalAlignment="Left" />
                    <CheckBox IsChecked="{Binding Levels.ShowError}" Content="Error" />
                    <CheckBox IsChecked="{Binding Levels.ShowWarn}" Content="Warn" />
                    <CheckBox IsChecked="{Binding Levels.ShowInfo}" Content="Info" />
                  </StackPanel>
                </Panel>
                <Panel Name="MenuContext" IsVisible="False">
                  <StackPanel Spacing="4" Margin="0,0,0,8" IsVisible="{Binding IsLogFilterMode}">
                    <TextBlock Text="Context around each match" FontSize="11" Opacity="0.6" />
                    <ComboBox HorizontalAlignment="Stretch" MinHeight="27" FontSize="11"
                              ItemsSource="{Binding LogContextChoices}" SelectedItem="{Binding LogContextLines}"
                              ToolTip.Tip="Lines to keep around each match while filtering, like grep -C">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="sys:Int32">
                          <TextBlock Text="{Binding Converter={x:Static conv:LogContextLabelConverter.Instance}}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Panel>
                <CheckBox IsChecked="{Binding ShowLogTimestamps}" Content="Timestamps" ToolTip.Tip="Show timestamps (local time) — the merge orders on these, so they are how an out-of-order line is spotted" />
                <CheckBox IsChecked="{Binding UseUtcTimestamps}" Content="In UTC" Margin="24,0,0,0"
                          IsEnabled="{Binding ShowLogTimestamps}" ToolTip.Tip="{Binding TimestampZoneTooltip}" />
                <CheckBox IsChecked="{Binding WrapLogLines}" Content="Wrap long lines" />
                <Separator Margin="0,4" Opacity="0.4" />
                <Button Classes="linkRow" Command="{Binding ClearLogsCommand}" Click="OnLogMenuActionClick"
                        ToolTip.Tip="Clear the pane — every stream keeps running and new lines appear">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource EraserIconGeometry}" Width="13" Height="13" />
                    <TextBlock Text="Clear the pane" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="linkRow" Command="{Binding DownloadLogsCommand}" Click="OnLogMenuActionClick"
                        ToolTip.Tip="Save the visible lines to a file, pod-prefixed and with timestamps">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource DownloadIconGeometry}" Width="13" Height="13" />
                    <TextBlock Text="Save to a file…" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Present only when the pod cap actually bit, so it costs nothing the rest of the
         time (UI rule 1) and is impossible to miss when it matters (UI rule 11). -->
    <StackPanel Grid.Row="2" Spacing="4">
      <!-- A regular expression that does not parse filters nothing and says why. -->
      <Border Classes="infoBar error" Margin="0,0,0,6" IsVisible="{Binding HasLogSearchError}">
        <TextBlock Text="{Binding LogSearchError}" TextWrapping="Wrap" FontSize="11.5" />
      </Border>
      <!-- Pinned highlights, only while there are any: each chip is its colour's key and
           its own remove button. -->
      <ItemsControl ItemsSource="{Binding Pins.Items}" Margin="0,0,0,6" IsVisible="{Binding Pins.HasAny}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LogPin">
            <Button Classes="chip logPinChip" Margin="0,0,4,0"
                    Command="{Binding $parent[UserControl].((vm:WorkloadLogsTabViewModel)DataContext).Pins.RemoveCommand}"
                    CommandParameter="{Binding}" ToolTip.Tip="Pinned highlight — click to remove">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse Width="8" Height="8" Fill="{Binding SolidBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Text}" Classes="mono" FontSize="11" VerticalAlignment="Center" />
                <PathIcon Data="{StaticResource CloseIconGeometry}" Width="8" Height="8" Opacity="0.6" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Classes="infoBar warn" Margin="0,0,0,6"
              IsVisible="{Binding CapNotice, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}">
        <TextBlock Text="{Binding CapNotice}" TextWrapping="Wrap" FontSize="11.5" />
      </Border>
      <Border Classes="infoBar warn" Margin="0,0,0,6"
              IsVisible="{Binding TrimNotice, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}">
        <TextBlock Text="{Binding TrimNotice}" TextWrapping="Wrap" FontSize="11.5" />
      </Border>
    </StackPanel>

    <Border Grid.Row="3" Classes="card" Padding="8,8,2,8">
      <Grid ColumnDefinitions="*,10">
        <!-- Every error, warning, match and pin as a tick beside the scrollbar; a click goes
             there (Controls/LogOverviewRuler). -->
        <controls:LogOverviewRuler Name="LogRuler" Grid.Column="1" Margin="2,0,0,0"
                                   Lines="{Binding LogLines}" Query="{Binding LogQuery}"
                                   Pins="{Binding Pins.Items}" CursorLine="{Binding Problems.Current}"
                                   ErrorBrush="IndianRed" WarnBrush="{StaticResource AppWarningBrush}"
                                   MatchBrush="{DynamicResource LogCurrentMatchBrush}"
                                   CursorBrush="{DynamicResource SystemAccentColor}" />
        <ScrollViewer Name="LogScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto">
          <!-- The bottom margin is room for the horizontal scroll bar, as in pod detail's
               pane: the bar is drawn over the content, and the last line used to sit under it. -->
          <StackPanel Margin="0,0,0,14">
          <ItemsControl Name="LogItems" ItemsSource="{Binding LogLines}">
            <!-- Virtualized: only the rows in sight exist. With the default StackPanel every
                 buffered line was a live row of about ten controls, so a full 4,000-line
                 buffer took seconds to lay out and made every theme switch restyle ~37,000
                 controls. Rows are found by item, not by container, for the same reason
                 (LogSearchGestures.BringIntoView). -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LogLineViewModel">
                <!-- The pod name is a fixed-width column so the messages line up down
                     the pane; without it every line's text starts at a different x and
                     a merged stream is harder to read than the separate ones were. Only
                     while more than one pod is shown (ShowSourceColumn): with one, it is
                     the same name on every line. -->
                <StackPanel>
                <Rectangle Classes="logGap" IsVisible="{Binding IsGapBefore}" />
                <Border Classes="logRow" Classes.error="{Binding IsErrorLine}" Classes.warn="{Binding IsWarnLine}"
                        Classes.context="{Binding IsContextLine}" Classes.cursor="{Binding IsProblemCursor}">
                <!-- Column 0 is the JSON chevron's, kept on every row so JSON and plain
                     lines start at the same x. -->
                <Grid ColumnDefinitions="14,Auto,*" RowDefinitions="Auto,Auto">
                  <ToggleButton Grid.Column="0" Classes="logExpand" IsChecked="{Binding IsExpanded}" IsVisible="{Binding IsJson}"
                                ToolTip.Tip="Show this JSON line's fields, one per row">
                    <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="8" Height="8" />
                  </ToggleButton>
                  <TextBlock Grid.Column="1" Text="{Binding Source.ShortName}" Width="150" Margin="0,0,10,0"
                             Classes="mono" FontSize="11"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Top"
                             Foreground="{Binding Source.Brush}"
                             ToolTip.Tip="{Binding Source.PodName}">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasSource" />
                        <Binding Path="$parent[UserControl].((vm:WorkloadLogsTabViewModel)DataContext).ShowSourceColumn" />
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                  <!-- Severity as classes rather than a Foreground binding — see the
                       `.logError`/`.logWarn`/`.logInfo` styles in Theme.axaml for why a
                       binding that produces UnsetValue is not safe on this property. -->
                  <controls:LogLineText Grid.Column="2" Classes="logLine mono" Text="{Binding DisplayText}" FontSize="11"
                                        MatchStart="{Binding MessageOffset}"
                                        LevelStart="{Binding DisplayLevelStart}" LevelLength="{Binding LevelLength}"
                                        IsCurrentMatch="{Binding IsCurrentMatch}"
                                        Query="{Binding $parent[UserControl].((vm:WorkloadLogsTabViewModel)DataContext).LogQuery}"
                                        Pins="{Binding $parent[UserControl].((vm:WorkloadLogsTabViewModel)DataContext).Pins.Items}"
                                        MatchBrush="{DynamicResource LogMatchBrush}"
                                        CurrentMatchBrush="{DynamicResource LogCurrentMatchBrush}"
                                        Classes.logError="{Binding IsErrorLine}"
                                        Classes.logWarn="{Binding IsWarnLine}"
                                        Classes.logInfo="{Binding IsInfoLine}"
                                        TextWrapping="{Binding $parent[UserControl].((vm:WorkloadLogsTabViewModel)DataContext).WrapLogLines, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}" />
                  <SelectableTextBlock Grid.Column="2" Grid.Row="1" Classes="logJson" Text="{Binding PrettyJson}"
                                       IsVisible="{Binding IsExpanded}" />
                </Grid>
                </Border>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- How the run ended, set by the application page: the log's last line. -->
          <Border Classes="infoBar error" Margin="0,8,0,0" HorizontalAlignment="Left" IsVisible="{Binding HasFooter}">
            <TextBlock Text="{Binding Footer}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
          </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Every empty state says which one it is (UI rule 9) — "still finding pods",
             "the selector matches nothing", "matched but silent", "everything hidden"
             and "the filter matched none of the buffer" are five different next steps. -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="460"
                    IsVisible="{Binding HasLogPlaceholder}">
          <TextBlock Text="{Binding LogPlaceholder}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                     Classes="statusText" Classes.warn="{Binding IsLogStatusProblem}"
                     Classes.dim="{Binding !IsLogStatusProblem}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
