<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:aconv="using:Avalonia.Data.Converters"
             x:Class="KubeNimbus.App.Views.PortForwardView"
             x:DataType="vm:PortForwardTabViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="12,10,12,12" MaxWidth="440" HorizontalAlignment="Left">
    <TextBlock Grid.Row="0" Classes="sectionHeader" Text="PORT FORWARD" Margin="0,0,0,12" />

    <!-- The pod's own declared ports, with their names. They were read off the spec
         and then thrown away for a hardcoded 8080, so forwarding to a pod serving on
         9090 meant knowing that and typing it. Hidden entirely for a pod that
         declares none — there is nothing to pick (UI rule 1). -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10"
                IsVisible="{Binding HasDeclaredPorts}">
      <TextBlock Text="Declared" VerticalAlignment="Center" Opacity="0.7" />
      <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}" MinWidth="160"
                IsEnabled="{Binding CanEditPorts}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ContainerPort">
            <TextBlock Text="{Binding Display}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <!-- Read-only while running: the ports the forward was started with are what it
         is doing, and an editable box that changes nothing is a lie about that. -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,90,24,Auto,90">
      <TextBlock Grid.Column="0" Text="Pod port" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="1" Value="{Binding PodPort}" Minimum="1" Maximum="65535" ShowButtonSpinner="False"
                     FormatString="0" IsEnabled="{Binding CanEditPorts}" />
      <TextBlock Grid.Column="3" Text="Local port" VerticalAlignment="Center" />
      <NumericUpDown Grid.Column="4" Value="{Binding LocalPort}" Minimum="0" Maximum="65535" ShowButtonSpinner="False"
                     FormatString="0" IsEnabled="{Binding CanEditPorts}"
                     ToolTip.Tip="0 = pick an available port automatically" />
    </Grid>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="accent" Content="Start" Command="{Binding StartCommand}" />
      <Button Content="Stop" Command="{Binding StopCommand}" />
      <!-- Running with a refused connection is warn, not ok: the listener really is
           accepting, so "stopped" would be wrong, but so is a green dot over a
           forward whose last connection the kubelet turned away. -->
      <Ellipse Classes="statusDot" VerticalAlignment="Center" Margin="8,0,0,0"
               Fill="{Binding Health, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
    </StackPanel>

    <!-- Reaching the thing you just forwarded, which is the entire point of forwarding it. -->
    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding IsRunning}">
      <TextBlock Text="{Binding LocalUrl}" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas,monospace"
                 FontSize="12" Opacity="0.85" />
      <Button Classes="toolbar" Padding="5" Command="{Binding CopyUrlCommand}" ToolTip.Tip="Copy the local URL">
        <PathIcon Data="{StaticResource ContentCopyIconGeometry}" Width="12" Height="12" />
      </Button>
      <Button Classes="toolbar" Padding="5" Command="{Binding OpenInBrowserCommand}" ToolTip.Tip="Open in the default browser">
        <PathIcon Data="{StaticResource OpenInNewIconGeometry}" Width="12" Height="12" />
      </Button>
    </StackPanel>

    <StackPanel Grid.Row="5" Spacing="4" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
      <!-- The kubelet's own sentence ("error forwarding port 8080 to pod x: connection
           refused"), which used to be dropped on the floor — leaving a forward that
           accepted connections and answered none of them, saying nothing. -->
      <TextBlock Text="{Binding ConnectionError}" Classes="statusText warn" TextWrapping="Wrap"
                 IsVisible="{Binding ConnectionError, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
    </StackPanel>
  </Grid>
</UserControl>
