<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels" xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:app="using:KubeNimbus.App" x:Class="KubeNimbus.App.Views.WorkloadDetailView"
             x:DataType="vm:WorkloadDetailTabViewModel" KeyDown="OnKeyDown">
  <Grid RowDefinitions="Auto,Auto,*" Margin="10,8,10,10">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
      <ListBox Classes="segmented" SelectedIndex="{Binding SelectedTabIndex}">
        <ListBoxItem Content="Pods"/><ListBoxItem Content="Conditions"/><ListBoxItem Content="Events"/>
      </ListBox>
      <TextBlock Grid.Column="1" Text="{Binding Rollout}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Rollout}"/>
      <!-- Refresh is the resource list's own icon button; Actions a real button with a
           chevron. Both were chips holding a bare word, which drew as plain text. -->
      <Button Grid.Column="2" Classes="toolbar" Padding="6" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="13" Height="13"/>
      </Button>
      <Button Grid.Column="3" Classes="soft" Padding="10,4" Margin="6,0,0,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Actions" FontSize="12" VerticalAlignment="Center"/>
          <PathIcon Data="{StaticResource ChevronDownIconGeometry}" Width="9" Height="9" Opacity="0.6" VerticalAlignment="Center"/>
        </StackPanel>
        <Button.Flyout><MenuFlyout>
          <MenuItem Header="Edit YAML (E)" Command="{Binding OpenYamlCommand}"/>
          <MenuItem Header="Scale…" Command="{Binding ScaleCommand}" IsVisible="{Binding CanScale}"/>
          <MenuItem Header="Rollout restart…" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}"/>
        </MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"/>
    <TabControl Grid.Row="2" Classes="headerless" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Pods"><Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Text="{Binding PodsStatus}" Opacity="0.65" Margin="0,0,0,6"/>
        <!-- A logs open that found nothing to open says why here (the pod went away, the
             read was refused) — present only while there is something to say (UI rule 9). -->
        <Border Grid.Row="1" Classes="infoBar warn" Margin="0,0,0,6"
                IsVisible="{Binding LogsNotice, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}">
          <TextBlock Text="{Binding LogsNotice}" TextWrapping="Wrap" FontSize="12"/>
        </Border>
        <!-- L / Shift+L and Enter are handled in the Tunnel phase from code-behind
             (RowLogsGesture + OnPodKeyDown): DataGrid's own class handler consumes Enter
             before a bubble handler here would see it. The menu captions are display-only
             and follow CommandCatalog's List-scoped rows by hand. The selection is synced
             from code-behind (GridSelectionSync) rather than bound two-way, which lost it
             every time the inspector switched tabs. -->
        <DataGrid Grid.Row="2" Name="PodsGrid" ItemsSource="{Binding Pods}"
                  IsReadOnly="True" AutoGenerateColumns="False" DoubleTapped="OnPodDoubleTapped">
          <DataGrid.ContextMenu><ContextMenu>
            <MenuItem Header="Logs" Command="{Binding PodLogsCommand}" InputGesture="L"/>
            <MenuItem Header="Logs, maximized" Command="{Binding PodLogsMaximizedCommand}" InputGesture="Shift+L"/>
            <MenuItem Header="Open pod" Command="{Binding OpenPodCommand}" InputGesture="Enter"/>
            <MenuItem Header="Shell" Command="{Binding ShellCommand}" InputGesture="S"/>
          </ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
            <!-- The row's logs icon, the resource list's own (L2): drawn on the hovered and
                 the selected row by Button.rowAction, Shift+click for full-size. -->
            <DataGridTemplateColumn Header="Name" Width="*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ResourceRowViewModel">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Grid.Column="1" Classes="rowAction logs" Click="OnPodLogsClick"
                            ToolTip.Tip="{x:Static app:CommandTip.RowLogs}">
                      <PathIcon Data="{StaticResource LogsIconGeometry}" Width="12" Height="12"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ready" Width="80">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ResourceRowViewModel">
                  <TextBlock Text="{Binding ReadyText}" VerticalAlignment="Center" Classes="mono" FontSize="11.5"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <!-- The same pill as the resource list's Status column: this is the same pod,
                 and it read as plain text here. -->
            <DataGridTemplateColumn Header="Status" Width="180">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ResourceRowViewModel">
                  <Border Classes="statusPill" Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                          Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                          Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}"
                          IsVisible="{Binding Status, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}"
                          ToolTip.Tip="{Binding Status}">
                    <TextBlock Text="{Binding Status}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Restarts" Width="100">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate x:DataType="vm:ResourceRowViewModel">
                  <TextBlock Text="{Binding RestartsText}" VerticalAlignment="Center" Classes="mono" FontSize="11.5"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
      <TabItem Header="Conditions"><Grid>
        <TextBlock Text="No conditions reported." IsVisible="{Binding HasNoConditions}" Opacity="0.65"/>
        <DataGrid ItemsSource="{Binding Conditions}" IsVisible="{Binding !HasNoConditions}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Condition" Binding="{Binding Type}" Width="150"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
      <TabItem Header="Events"><Grid RowDefinitions="Auto,*">
        <TextBlock Text="{Binding EventsStatus}" Opacity="0.65" Margin="0,0,0,6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="190"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
