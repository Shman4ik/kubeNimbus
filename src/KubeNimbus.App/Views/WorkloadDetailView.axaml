<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels" xmlns:conv="using:KubeNimbus.App.Converters" x:Class="KubeNimbus.App.Views.WorkloadDetailView"
             x:DataType="vm:WorkloadDetailTabViewModel" KeyDown="OnKeyDown">
  <Grid RowDefinitions="Auto,Auto,*" Margin="10,8,10,10">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
      <ListBox Classes="segmented" SelectedIndex="{Binding SelectedTabIndex}">
        <ListBoxItem Content="Pods"/><ListBoxItem Content="Conditions"/><ListBoxItem Content="Events"/>
      </ListBox>
      <TextBlock Grid.Column="1" Text="{Binding Rollout}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Rollout}"/>
      <Button Grid.Column="2" Classes="chip" Content="Refresh" Command="{Binding RefreshCommand}"/>
      <Button Grid.Column="3" Classes="chip" Content="Actions" Margin="4,0,0,0">
        <Button.Flyout><MenuFlyout>
          <MenuItem Header="Edit YAML (E)" Command="{Binding OpenYamlCommand}"/>
          <MenuItem Header="Scale…" Command="{Binding ScaleCommand}" IsVisible="{Binding CanScale}"/>
          <MenuItem Header="Rollout restart…" Command="{Binding RestartCommand}" IsVisible="{Binding CanRestart}"/>
        </MenuFlyout></Button.Flyout>
      </Button>
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" Foreground="{StaticResource AppDangerBrush}" TextWrapping="Wrap"/>
    <TabControl Grid.Row="2" Classes="headerless" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Pods"><Grid RowDefinitions="Auto,*">
        <TextBlock Text="{Binding PodsStatus}" Opacity="0.65" Margin="0,0,0,6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Pods}" SelectedItem="{Binding SelectedPod}"
                  IsReadOnly="True" AutoGenerateColumns="False" DoubleTapped="OnPodDoubleTapped" KeyDown="OnPodKeyDown">
          <DataGrid.ContextMenu><ContextMenu>
            <MenuItem Header="Logs (L)" Command="{Binding OpenPodLogsCommand}"/>
            <MenuItem Header="Shell (S)" Command="{Binding ShellCommand}"/>
          </ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Name" Width="*">
              <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="vm:ResourceRowViewModel">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                  <Button Grid.Column="1" Classes="rowAction logs" Click="OnPodLogsClick" ToolTip.Tip="Open pod logs (L)">
                    <PathIcon Data="{StaticResource LogsIconGeometry}" Width="12" Height="12" />
                  </Button>
                </Grid>
              </DataTemplate></DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Header="Ready" Binding="{Binding ReadyText}" Width="80"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
            <DataGridTextColumn Header="Restarts" Binding="{Binding RestartsText}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
      <TabItem Header="Conditions"><Grid>
        <TextBlock Text="No conditions reported." IsVisible="{Binding HasNoConditions}" Opacity="0.65"/>
        <DataGrid ItemsSource="{Binding Conditions}" IsVisible="{Binding !HasNoConditions}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Condition" Binding="{Binding Type}" Width="150"/>
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="220"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
      <TabItem Header="Events"><Grid RowDefinitions="Auto,*">
        <TextBlock Text="{Binding EventsStatus}" Opacity="0.65" Margin="0,0,0,6"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Events}" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="90"/>
            <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="190"/>
            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
            <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid></TabItem>
    </TabControl>
  </Grid>
</UserControl>
