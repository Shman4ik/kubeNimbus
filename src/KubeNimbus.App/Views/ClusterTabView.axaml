<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:controls="using:KubeNimbus.App.Controls"
             xmlns:aconv="using:Avalonia.Data.Converters"
             xmlns:app="using:KubeNimbus.App"
             xmlns:views="using:KubeNimbus.App.Views"
             x:Class="KubeNimbus.App.Views.ClusterTabView"
             x:DataType="vm:ClusterTabViewModel">

  <!-- Named because ApplySidebarVisibility and ApplySidebarWidth mutate column 0's
       width from code-behind: hiding a Grid child does not collapse the column it
       occupies, so the width is what has to move, and a GridSplitter writes that width
       directly and would fight a one-way binding — the same reason ApplyDockState
       mutates row heights rather than binding them.

       The width is an absolute one now, not the 0.65* it used to be. A star column
       re-divides on every window resize, so a sidebar sized to hold a kind name at
       1280px was taking ~24% of a 3840px window to show the same 200px of text; the
       resource list is what should absorb a wider window. Column 1 stays star so it
       takes every pixel the sidebar does not. -->
  <Grid Name="ContentColumns" ColumnDefinitions="224,Auto,*">

    <!-- Sidebar: sits directly on the shell tone, Files-style — no card chrome. -->
    <Grid Name="Sidebar" Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,8,0">
      <Grid.ContextFlyout><MenuFlyout>
        <MenuItem Header="Refresh resource catalog" Command="{Binding RefreshCatalogCommand}"/>
      </MenuFlyout></Grid.ContextFlyout>

      <!-- Filter row, with the advanced-view switch docked right of it — same placement
           and same shape as pgNimbus's SchemaTreePanel, because it answers the same
           complaint ("too much of it, all the time") and people who use both should
           find it in the same place. The switch is *this panel's*: it governs which
           sections the sidebar shows and nothing outside it. It is a ToggleButton with
           a two-way IsChecked and NO Command: the two together cancel each other out
           (see the note on ClusterTabViewModel.IsAdvancedView). -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="4,0,4,8">
        <TextBox Grid.Column="0" Classes="filterbox"
                  Text="{Binding SidebarFilter}" PlaceholderText="Filter resources…">
          <TextBox.InnerLeftContent>
            <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="11" Height="11" Opacity="0.5" Margin="8,0,0,0" />
          </TextBox.InnerLeftContent>
          <TextBox.InnerRightContent>
            <Button Classes="chip" Padding="0" MinWidth="16" MinHeight="16" Margin="0,0,4,0"
                    IsVisible="{Binding SidebarFilter, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}"
                    Command="{Binding $parent[UserControl].((vm:ClusterTabViewModel)DataContext).ClearSidebarFilterCommand}"
                    ToolTip.Tip="Clear filter">
              <PathIcon Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
            </Button>
          </TextBox.InnerRightContent>
        </TextBox>
        <ToggleButton Grid.Column="1" Classes="chip" Padding="5" Margin="6,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding IsAdvancedView}"
                      ToolTip.Tip="Advanced view — list every resource kind, including the API machinery and CRDs. On by default; turn it off for the kinds you actually browse (Pods, Deployments, Services, Nodes…). The filter and the command palette still reach everything.">
          <PathIcon Data="{StaticResource EyePlusIconGeometry}" Width="14" Height="14" />
        </ToggleButton>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <ItemsControl ItemsSource="{Binding SidebarSections}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SidebarSectionViewModel">
              <StackPanel Margin="0,0,0,8" IsVisible="{Binding IsSectionVisible}">
                <Border Classes="sectionHeaderRow" Tapped="OnSidebarSectionTapped">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Data="{StaticResource ChevronRightIconGeometry}" Width="10" Height="10"
                              Opacity="0.5" Margin="0,0,4,0" VerticalAlignment="Center"
                              RenderTransformOrigin="50%,50%">
                      <PathIcon.RenderTransform>
                        <RotateTransform Angle="{Binding ShowKinds, Converter={x:Static conv:ExpandedToAngleConverter.Instance}}" />
                      </PathIcon.RenderTransform>
                    </PathIcon>
                    <TextBlock Grid.Column="1" Classes="sectionHeader" Text="{Binding Title}" VerticalAlignment="Center" />
                    <!-- "How much is hiding in here?" is a spelunking question, so the
                         badge rides the advanced view (pushed down per section — see
                         ClusterTabViewModel.ApplySidebarChrome). -->
                    <TextBlock Grid.Column="2" Classes="sectionHeader" Text="{Binding KindCount}" Opacity="0.4"
                               VerticalAlignment="Center" IsVisible="{Binding ShowKindCount}" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Kinds}" IsVisible="{Binding ShowKinds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarKindViewModel">
                      <ListBoxItem Classes="navRow" IsSelected="{Binding IsSelected}" IsVisible="{Binding IsVisible}"
                                   Tapped="OnSidebarKindTapped">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <PathIcon Data="{Binding IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                                    Width="13" Height="13" VerticalAlignment="Center" Opacity="0.8" />
                          <TextBlock Text="{Binding DisplayName}" FontSize="12" VerticalAlignment="Center" />
                          <!-- Only set when another kind in this section shares the name. -->
                          <TextBlock Text="{Binding GroupLabel}" IsVisible="{Binding HasGroupLabel}"
                                     FontSize="10.5" Opacity="0.45" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding GroupLabel}" />
                        </StackPanel>
                      </ListBoxItem>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- The sidebar's drag handle. Sized to the 8px gutter the sidebar's own right
         margin already leaves, so it adds no width — it makes a gap that was there
         anyway draggable. Min/Max come from AppSettings so the drag cannot leave the
         filter box too narrow to type in, or the resource list too narrow to read;
         ClusterTabView.axaml.cs persists where it ends up. -->
    <GridSplitter Grid.Column="1" Name="SidebarSplitter" Classes="sidebar" Width="8"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                  DragCompleted="OnSidebarSplitterDragCompleted" />

    <!-- Content: raised layer, Files-style. Resource list on top, inspector docks
         along the bottom (Lens-style) so logs / exec / YAML get the full content
         width instead of a cramped sidecar. Row heights are managed in code-behind
         (ApplyDockState) to support the draggable splitter + maximize + collapse. -->
    <Border Grid.Column="2" Classes="layer">
      <DockPanel>

        <!-- Demo banner. Present for the whole life of a demo tab and absent entirely
             otherwise, so it costs no chrome on a real cluster (same shape as the
             production band above). See ClusterTabViewModel.DemoBanner for why this one
             always-visible control is justified.
             Docked outside ContentRows rather than added as a row of it: that grid's row
             indices are load-bearing — ApplyDockState drives the hidden/split/maximized
             states by mutating them by position from code-behind. -->
        <Border DockPanel.Dock="Top" Classes="demoBar" Margin="0,0,0,8" IsVisible="{Binding IsDemo}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static vm:ClusterTabViewModel.DemoBanner}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="Every object here ships inside the app. kubeNimbus is not talking to any cluster in this tab." />
          </StackPanel>
        </Border>

        <!-- The armed workload action (scale / rollout restart / delete). Present only
             while one is armed, so it costs no chrome the rest of the time (UI rule 1),
             and docked outside ContentRows for the same reason the demo bar is: that
             grid's row indices are load-bearing for ApplyDockState.

             It is the confirm step for all three actions and the only place a replica
             count is typed — a form, so it follows UI rule 11: label above the input,
             state in an InfoBar rather than a bare status dot. The alternative designs
             were a second window (forbidden — UI rule 16), an OverlayPanel (which
             covers the very list the action is about, and which rule 16b reserves for
             shell-level surfaces you open, use and dismiss), and an inspector dock tab
             (a third row of chrome inside a ~300px dock, against UI rule 10, for a
             question with a one-word answer).

             An inline DataTemplate rather than the action assigned straight to this
             element's DataContext: `x:DataType` re-roots an element's *own* bindings
             too, so a Border that both sets DataContext and declares the new type
             compiles (against the wrong type) and silently renders nothing — which is
             exactly what the first cut of this did. A template's bindings are rooted at
             its own type by construction and cannot make that mistake. -->
        <ContentControl DockPanel.Dock="Top" Content="{Binding PendingRowAction}" Margin="0,0,0,8"
                        IsVisible="{Binding PendingRowAction, Converter={x:Static aconv:ObjectConverters.IsNotNull}}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:RowActionViewModel">
              <!-- The strip itself lives in RowActionStrip so the Applications page arms
                   the very same confirm (UI rule 17) rather than a copy that drifts. -->
              <views:RowActionStrip />
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- What happened when a terminal was asked for. Present only while there is
             something to report, so it costs nothing the rest of the time (UI rule 1),
             and docked outside ContentRows for the same reason the demo bar and the row
             action strip are: that grid's row indices are load-bearing for
             ApplyDockState.

             It exists because this command's own feedback — a window — opens *in front
             of the app*, so the two states that matter ("no kubectl on this machine"
             and "nothing here could be opened at all") would otherwise be invisible.
             State in an InfoBar rather than a status dot, UI rule 11; severity as a
             bound class, same as the row action strip's. -->
        <Border DockPanel.Dock="Top" Classes="infoBar" Margin="0,0,0,8"
                Classes.warn="{Binding TerminalNoticeIsWarning}"
                Classes.error="{Binding TerminalNoticeIsError}"
                IsVisible="{Binding TerminalNotice, Converter={x:Static aconv:ObjectConverters.IsNotNull}}">
          <DockPanel>
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource ConsoleIconGeometry}" Width="12" Height="12"
                      VerticalAlignment="Top" Margin="0,2,8,0" />
            <Button DockPanel.Dock="Right" Classes="chip" Padding="0" MinWidth="18" MinHeight="18"
                    Margin="8,0,0,0" VerticalAlignment="Top"
                    Command="{Binding DismissTerminalNoticeCommand}" ToolTip.Tip="Dismiss">
              <PathIcon Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
            </Button>
            <!-- Selectable: the KUBECONFIG value is the thing to copy when no terminal
                 could be opened, which is precisely when it is being read. -->
            <SelectableTextBlock Text="{Binding TerminalNotice}" TextWrapping="Wrap" FontSize="12" />
          </DockPanel>
        </Border>

      <Grid Name="ContentRows">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="90" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="0" MinHeight="0" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,10">
          <TextBlock Grid.Column="0" Text="{Binding SelectedKind.DisplayName}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
          <Button Grid.Column="1" Name="NamespaceButton" Classes="soft"
                  Margin="12,0,0,0" MinWidth="170" MaxWidth="280" IsEnabled="{Binding SelectedKind.Descriptor.Namespaced}"
                  ToolTip.Tip="Choose namespace — type to filter">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding SelectedNamespace}" TextTrimming="CharacterEllipsis"/>
              <PathIcon Grid.Column="1" Data="{StaticResource ChevronDownIconGeometry}" Width="10" Height="10" Margin="12,0,0,0"/>
            </Grid>
            <Button.Flyout>
              <Flyout Opened="OnNamespaceOpened" Closed="OnNamespaceClosed">
                <Grid RowDefinitions="Auto,Auto,*" Width="320" MaxHeight="420" KeyDown="OnNamespaceKeyDown">
                  <TextBox Name="NamespaceSearch" Text="{Binding NamespaceFilter}" PlaceholderText="Filter namespaces…"/>
                  <TextBlock Grid.Row="1" Text="No matching namespaces." IsVisible="{Binding NoNamespaceMatches}" Margin="4,12" Opacity="0.65"/>
                  <ListBox Grid.Row="2" Name="NamespaceList" ItemsSource="{Binding FilteredNamespaces}"
                           SelectedItem="{Binding NamespaceCandidate}" Tapped="OnNamespaceTapped" Margin="0,6,0,0">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="vm:NamespaceChoice">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"/>
                        <TextBlock Grid.Column="1" Text="Recent" IsVisible="{Binding IsRecent}" Opacity="0.45" Margin="12,0,0,0"/>
                      </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Flyout>
            </Button.Flyout>
          </Button>
          <!-- Fleet toggle: only offered with more than one cluster connected, since
               aggregating one cluster is just this list (UI rule 1). -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsVisible="{Binding IsFleetToggleVisible}">
            <ToggleButton Classes="chip" Padding="8,3" FontSize="11.5" IsChecked="{Binding IsFleetView}"
                          ToolTip.Tip="Aggregate this kind across every connected cluster">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <PathIcon Data="{StaticResource LayersIconGeometry}" Width="12" Height="12" />
                <TextBlock Text="All clusters" VerticalAlignment="Center" />
              </StackPanel>
            </ToggleButton>
            <TextBlock Text="{Binding FleetSummary}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FleetSummary}"
                       IsVisible="{Binding IsFleetView}" />
          </StackPanel>
          <Border Grid.Column="3" Classes="inlineWarning" Margin="12,0,0,0" HorizontalAlignment="Left"
                  IsVisible="{Binding ConnectionWarning, Converter={x:Static aconv:ObjectConverters.IsNotNull}}"
                  ToolTip.Tip="{Binding ConnectionWarning}">
            <!-- A DockPanel, not a horizontal StackPanel: a StackPanel measures its
                 children at infinite width, so the TextTrimming below never fired and a
                 long warning ("staging-eu: connection refused (127.0.0.1:6550)") drew
                 straight over the search box beside it in the fleet-partial state. Docked,
                 the text gets the column's width and ellipsises; the tooltip has the rest. -->
            <DockPanel>
              <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                        Margin="0,0,6,0" />
              <TextBlock Text="{Binding ConnectionWarning}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </Border>
          <!-- Search the list by name. The sidebar's filter box narrows *kinds*; this
               one narrows the objects, which is the thing `kubectl get | grep` has
               always been for and the one gesture the list had no answer to. Same
               shape as the sidebar's box (UI rule: people should find it where they
               left it), and the "12 of 87" beside it states that the list is short on
               purpose. Hidden in the Helm browser, which is a different list. -->
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsResourceListVisible}">
            <TextBlock Text="{Binding RowFilterSummary}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                       IsVisible="{Binding RowFilterSummary, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" />
            <TextBox Name="RowFilterBox" Classes="filterbox" Width="230"
                     Text="{Binding RowFilter}" PlaceholderText="{Binding RowFilterPlaceholder}"
                     KeyDown="OnRowFilterKeyDown">
              <TextBox.InnerLeftContent>
                <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="11" Height="11" Opacity="0.5" Margin="8,0,0,0" />
              </TextBox.InnerLeftContent>
              <TextBox.InnerRightContent>
                <Button Classes="chip" Padding="0" MinWidth="16" MinHeight="16" Margin="0,0,4,0"
                        IsVisible="{Binding IsRowFiltering}"
                        Command="{Binding ClearRowFilterCommand}"
                        ToolTip.Tip="Clear the search (Esc)">
                  <PathIcon Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
                </Button>
              </TextBox.InnerRightContent>
            </TextBox>
            <!-- Unhealthy only: k9s's "toggle faults". Beside the search box because it
                 narrows the same list, docked right of it the way the sidebar's advanced
                 switch sits right of the sidebar's box. Two-way IsChecked and NO Command
                 (UI rule 8b). Disabled on a kind with no health verdict, where it could
                 only produce an always-empty list; ShowOnDisabled so the tooltip that
                 says why is still reachable. -->
            <ToggleButton Name="UnhealthyToggle" Classes="chip checkedAccent" Padding="5" VerticalAlignment="Center"
                          IsChecked="{Binding IsUnhealthyOnly}"
                          IsEnabled="{Binding CanFilterUnhealthy}"
                          ToolTip.Tip="{Binding UnhealthyToggleTip}"
                          ToolTip.ShowOnDisabled="True">
              <PathIcon Data="{StaticResource AlertCircleIconGeometry}" Width="14" Height="14" />
            </ToggleButton>
          </StackPanel>
          <Button Grid.Column="5" Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" Padding="6"
                  Margin="8,0,0,0">
            <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
          </Button>
        </Grid>

        <!-- Resource list (hidden while the Helm browser or the Argo dashboard is showing) -->
        <Grid Grid.Row="1" IsVisible="{Binding IsResourceListVisible}">
          <!-- VisibleRows, not Rows: the watch keeps applying its events against the
               full list (see ClusterTabViewModel.Rows) while this renders whatever
               survives the search box. -->
          <DataGrid Name="ResourceGrid"
                     ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}"
                     IsReadOnly="True" GridLinesVisibility="Horizontal"
                     CanUserResizeColumns="True" CanUserSortColumns="True"
                     Sorting="OnGridSorting"
                     DoubleTapped="OnRowDoubleTapped">
            <!-- Right-clicking a resource used to do nothing at all: the app had exactly
                 one context menu anywhere, and logs / exec / port-forward had no entry
                 point from the list. Bound to SelectedRow, with the grid's own
                 right-click-selects handler (OnGridRightClick) making sure the row under
                 the cursor is the row the menu acts on. Pod-only items are disabled
                 rather than hidden, so the menu doesn't change shape per row —
                 a menu whose items move is a menu you have to read every time.
                 InputGesture is a caption only (a MenuItem's HotKey is the binding, and
                 there is none): the keys themselves are handled by OnGridKeyDown from
                 the command catalog, and these captions are how a mouse user learns
                 them. Keep the two in step with CommandCatalog's List-scoped rows. -->
            <DataGrid.ContextFlyout>
              <MenuFlyout>
                <!-- On an Event about a pod, "Logs" is that pod's (L3). -->
                <MenuItem Header="Logs" Command="{Binding OpenLogsCommand}" InputGesture="L">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource PlayIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Previous logs" Command="{Binding OpenPreviousLogsCommand}" InputGesture="P"
                          ToolTip.Tip="The crashed instance's logs — where a CrashLoopBackOff explains itself" />
                <!-- Enabled for whatever names the pods it owns — a Deployment, a
                     StatefulSet, a Service, a CRD with a pod selector — and disabled on
                     a pod, whose own detail pane is the answer. -->
                <MenuItem Header="Logs (all pods)" Command="{Binding OpenWorkloadLogsCommand}" InputGesture="L"
                          ToolTip.Tip="Tail every pod this workload owns in one pane, colour-keyed by pod">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource LayersIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exec" Command="{Binding ExecIntoSelectedCommand}" InputGesture="S">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource ConsoleIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Port-forward" Command="{Binding PortForwardSelectedCommand}" InputGesture="F">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource SwapHorizontalIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <!-- The mutating actions. Each one arms the confirm strip above the
                     list rather than firing on the click: these are the app's first
                     one-click changes to a running cluster, and every one of them is
                     confirmable (see RowActionViewModel). Scale is offered when the
                     server declares a `scale` subresource for the kind, restart when
                     the object has a pod template to stamp — both from discovery/the
                     object, never from a list of kinds. -->
                <MenuItem Header="Scale…" Command="{Binding ScaleSelectedCommand}" InputGesture="S"
                          ToolTip.Tip="Set the replica count through the scale subresource">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource ScaleIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Rollout restart…" Command="{Binding RestartSelectedCommand}" InputGesture="R"
                          ToolTip.Tip="Stamps the pod template so the controller rolls its pods — the same thing kubectl rollout restart does">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource RestartIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <!-- Node actions. One slot for cordon/uncordon rather than two items with
                     one of them always dead — the same "one control, swapped on the
                     state" the port-forward pane's Start/Stop settled (UI rule 11).
                     Exactly one of the pair is present, so nothing above or below moves.
                     They appear only on a node: unlike scale and restart, whose kinds a
                     reader might reasonably wonder about, "cordon this ConfigMap" is not
                     a question anyone has. -->
                <MenuItem Header="Cordon…" Command="{Binding CordonSelectedCommand}"
                          IsVisible="{Binding CanCordonSelectedRow}"
                          ToolTip.Tip="Stop scheduling new pods on this node. Its running pods stay put.">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CordonIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Uncordon…" Command="{Binding UncordonSelectedCommand}"
                          IsVisible="{Binding CanUncordonSelectedRow}"
                          ToolTip.Tip="Put this node back into service — the scheduler starts using it again.">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CheckIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Drain…" Command="{Binding DrainSelectedCommand}"
                          IsVisible="{Binding CanDrainSelectedRow}"
                          ToolTip.Tip="Cordon the node and evict the pods that may be evicted, honouring PodDisruptionBudgets">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource DrainIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <!-- Argo CD, on an ordinary Applications list. Present only for that kind,
                     for the same reason cordon is present only on a node: "sync this
                     ConfigMap" is not a question anyone has. The dashboard's own rows carry
                     the identical pair, and both arm the same strip. -->
                <MenuItem Header="Sync…" Command="{Binding SyncArgoApplicationCommand}"
                          IsVisible="{Binding CanSyncSelectedArgoApplication}"
                          ToolTip.Tip="Ask Argo CD to apply the revision this Application targets">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource SyncIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Refresh from Git…" Command="{Binding RefreshArgoApplicationCommand}"
                          IsVisible="{Binding CanSyncSelectedArgoApplication}"
                          ToolTip.Tip="Ask Argo to re-compare this Application against Git. Changes nothing on the cluster.">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Edit YAML" Command="{Binding EditSelectedYamlCommand}" InputGesture="E">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource CodeBracesIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete…" Command="{Binding DeleteSelectedCommand}" InputGesture="Delete"
                          ToolTip.Tip="Asks to confirm, naming the object — for a controller-owned pod, deleting it is how it gets recreated">
                  <MenuItem.Icon>
                    <PathIcon Data="{StaticResource DeleteIconGeometry}" Width="13" Height="13" />
                  </MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </DataGrid.ContextFlyout>
            <!-- No column here is Width="Auto", and that is deliberate: an Avalonia
                 DataGrid sizes an Auto column to the widest cell it has ever realized
                 and never shrinks it back, and every Auto column takes its width off the
                 top before the star columns divide what is left. So one long namespace
                 scrolling into view permanently widens that column and permanently
                 narrows every other one — measured on this grid, a single longer value
                 moved eight columns at once and did not move them back. Bounded,
                 monospace cells (Ready, Restarts, Age, CPU, Memory) get a fixed width;
                 everything else is a fixed or star column that trims with a tooltip.
                 The Helm and Argo grids below deliberately keep Auto: they are short,
                 one-shot lists whose cells are not rewritten under the reader, so their
                 columns reach their widest on the first render and effectively stop —
                 and fixing their widths measurably rendered them worse. See CLAUDE.md,
                 "An Auto DataGrid column ratchets, and only one grid can afford it". -->
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Tag="health" Width="28" CanUserResize="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Ellipse Classes="statusDot" Fill="{Binding StatusHealth, Converter={x:Static conv:HealthToBrushConverter.Instance}}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Cluster: only meaningful in the aggregated fleet view, so
                   ClusterTabView.ApplyFleetColumn shows and hides it (same reason as
                   the usage columns — a DataGridColumn can't bind to the DataContext). -->
              <DataGridTemplateColumn Header="Cluster" Tag="cluster" CanUserSort="True" Width="150" MinWidth="120" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding ClusterName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ClusterName}"
                               FontWeight="SemiBold" Opacity="0.85" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Namespace" Tag="namespace" CanUserSort="True" Width="130" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding Namespace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- The Events list's own columns: kubectl's LAST SEEN / TYPE / REASON / OBJECT /
                   MESSAGE, plus COUNT. Shown only while the selected kind is an Event, in
                   place of Name (a generated "<object>.<hex>"), Status and Age — see
                   ClusterTabView.ApplySummaryColumns and docs/engineering/events-list.md.
                   Ordinary tagged columns rather than CRD printer slots: Last seen is a
                   fallback chain, Object a concatenation and Type a tinted pill, none of which
                   a JSONPath text cell can carry. No Width="Auto" (the ratchet): bounded
                   cells are fixed, the three that carry prose are stars. The MinWidths are
                   what a narrow window squeezes the fixed columns down to, so each one still
                   fits its header and, for Type, the whole word "Warning" — the pill's tint
                   is not allowed to be the only thing left of it (checked at 1024px). -->
              <DataGridTemplateColumn Header="Last seen" Tag="event-lastseen" CanUserSort="True" Width="108" MinWidth="100" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding LastSeenText}" VerticalAlignment="Center" ToolTip.Tip="{Binding LastSeenTooltip}"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Type: the word, always — "Warning" is the signal and the amber tint only
                   repeats it, so the column reads the same to someone who cannot tell the
                   tints apart. Normal stays an untinted pill. -->
              <DataGridTemplateColumn Header="Type" Tag="event-type" CanUserSort="True" Width="90" MinWidth="90" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Border Classes="statusPill" Classes.warn="{Binding IsWarningEvent}"
                            IsVisible="{Binding EventType, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}">
                      <TextBlock Text="{Binding EventType}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Reason" Tag="event-reason" CanUserSort="True" Width="1.3*" MinWidth="100" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding EventReason}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EventReason}"
                               FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- On an Event about a pod the row's logs icon sits here, at the end of the
                   object it opens the logs of — the Events list hides Name, which is where
                   every other kind carries it. Same Panel/Button.rowAction pair and the same
                   click handler as the Name cell below (L3); HasLogs is true on an event
                   only when its involved object is a core pod (LogTarget.InvolvedPod). -->
              <DataGridTemplateColumn Header="Object" Tag="event-object" CanUserSort="True" Width="1.3*" MinWidth="110" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding EventObject}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EventObjectTooltip}"
                                 FontSize="12" VerticalAlignment="Center" />
                      <Panel Grid.Column="1" IsVisible="{Binding HasLogs}">
                        <Button Classes="rowAction logs"
                                Click="OnRowLogsClick"
                                ToolTip.Tip="{x:Static app:CommandTip.RowLogs}">
                          <PathIcon Data="{StaticResource LogsIconGeometry}" Width="12" Height="12" />
                        </Button>
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Count" Tag="event-count" CanUserSort="True" Width="84" MinWidth="80" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding EventCount}" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Message" Tag="event-message" CanUserSort="True" Width="2.4*" MinWidth="160" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding EventMessage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip.Tip="{Binding EventMessageTooltip}" VerticalAlignment="Center" FontSize="12" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- The logs icon lives INSIDE the Name cell, at its right end, rather than in
                   a column: a column would be one more width the per-kind layout remembers
                   and one more thing a CRD's printer columns compete with at 1280px (see
                   "The resource grid is the reader's to re-cut"). The Panel carries whether
                   the row has logs at all (HasLogs); Button.rowAction (Styles/Theme.axaml)
                   carries when it is drawn — only on the hovered and the selected row (UI
                   rule 1). While it is hidden its Auto column is zero wide, so a name at
                   rest keeps the whole cell; the icon's 24px come out of the name only on
                   the row under the pointer and the row you are on, which is the trade
                   against a slot reserved on every row (measured: at 860px that was a fifth
                   of every pod name, on rows nobody was pointing at).
                   Click, not Command: Shift+click is the full-size open, and a command
                   cannot see the modifier. -->
              <DataGridTemplateColumn Header="Name" Tag="name" CanUserSort="True" Width="2*" MinWidth="136">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                      <Panel Grid.Column="1" IsVisible="{Binding HasLogs}">
                        <Button Classes="rowAction logs"
                                Click="OnRowLogsClick"
                                ToolTip.Tip="{x:Static app:CommandTip.RowLogs}">
                          <PathIcon Data="{StaticResource LogsIconGeometry}" Width="12" Height="12" />
                        </Button>
                      </Panel>
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Ready / Status / Restarts / Age / Details are kubectl's own columns, and
                   which of them apply is a property of the selected kind, not of the app:
                   ClusterTabView.ApplySummaryColumns asks ResourceStatusSummary and shows
                   or hides each one. A DataGridColumn is outside the visual tree, so it
                   inherits no DataContext and cannot bind IsVisible itself — same reason
                   the Cluster and usage columns are handled there. -->
              <DataGridTemplateColumn Header="Ready" Tag="ready" CanUserSort="True" Width="84" MinWidth="70" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding ReadyText}" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Tag="status" CanUserSort="True" Width="*" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Border Classes="statusPill" Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                            Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                            Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}"
                            IsVisible="{Binding Status, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}"
                            ToolTip.Tip="{Binding Status}">
                      <TextBlock Text="{Binding Status}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- What kubectl shows instead of a status for kinds that have none:
                   a Service's type/IP/ports, a ConfigMap's key count. -->
              <DataGridTemplateColumn Header="Details" Tag="details" CanUserSort="True" Width="*" MinWidth="150" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding Details}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Details}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Restarts" Tag="restarts" CanUserSort="True" Width="112" MinWidth="78" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <!-- The count carries "(43m ago)": 200 restarts that stopped yesterday
                         and 200 still climbing are the same number and different problems. -->
                    <TextBlock Text="{Binding RestartsText}" VerticalAlignment="Center"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- CRD printer columns. A CustomResourceDefinition declares the columns it
                   wants a list of its objects to have (spec.versions[].additionalPrinterColumns)
                   and kubectl honours them, so these are what `kubectl get <crd>` prints.
                   They are fixed slots rather than columns built in code for one reason:
                   a DataGridColumn is outside the visual tree, so a code-built column
                   needs a code-built binding, and a code-built binding is a reflection
                   binding — which NativeAOT is exactly what this repo will not ship.
                   ClusterTabView.ApplyPrinterColumns fills in the headers and the
                   visibility from ClusterTabViewModel.VisiblePrinterColumns; the
                   PrinterSlotHeader sentinel below is how it finds them, and is read
                   once at construction, before any of them is renamed.
                   A built-in kind never has any (it is not a CRD), which is what keeps
                   ResourceStatusSummary the sole owner of every column a Pod, Deployment
                   or Node list shows (an Event list has its own columns, further up). -->
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[0].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[0].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[1].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[1].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[2].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[2].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[3].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[3].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[4].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[4].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[5].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[5].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[6].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[6].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[7].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[7].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[8].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[8].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Tag="crd-slot" CanUserSort="True" Width="*" MinWidth="88" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding PrinterCells[9].Text}" VerticalAlignment="Center" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PrinterCells[9].Text}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Usage columns: only meaningful for pods/nodes on a cluster with
                   metrics-server, so ClusterTabView.ApplyMetricsColumns shows and
                   hides them (a DataGridColumn isn't in the visual tree and can't
                   bind to the DataContext). -->
              <DataGridTemplateColumn Header="CPU" Tag="cpu" CanUserSort="True" Width="118" MinWidth="98" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <!-- Sparkline + current value: the number answers "how much now",
                         the line answers "is this a spike or its normal level" —
                         which one number alone can never say. -->
                    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding CpuTooltip}">
                      <controls:Sparkline Grid.Column="0" Values="{Binding CpuSeries}" Height="16" MinWidth="34"
                                          Margin="0,0,6,0" VerticalAlignment="Center"
                                          Stroke="{StaticResource UsageCpuStrokeBrush}"
                                          AreaFill="{StaticResource UsageCpuAreaBrush}"
                                          BaselineBrush="{StaticResource ChartBaselineBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding CpuText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Memory" Tag="memory" CanUserSort="True" Width="132" MinWidth="106" IsVisible="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding MemoryTooltip}">
                      <controls:Sparkline Grid.Column="0" Values="{Binding MemorySeries}" Height="16" MinWidth="34"
                                          Margin="0,0,6,0" VerticalAlignment="Center"
                                          Stroke="{StaticResource UsageMemoryStrokeBrush}"
                                          AreaFill="{StaticResource UsageMemoryAreaBrush}"
                                          BaselineBrush="{StaticResource ChartBaselineBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding MemoryText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                    </Grid>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Age, last, exactly where kubectl puts it. The text is a function of
                   wall-clock, not of the object, so it is recomputed by the one shared
                   timer in ClusterTabView — a watch event is not what makes it change. -->
              <DataGridTemplateColumn Header="Age" Tag="age" CanUserSort="True" Width="72" MinWidth="60">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:ResourceRowViewModel">
                    <TextBlock Text="{Binding AgeText}" VerticalAlignment="Center" ToolTip.Tip="{Binding AgeTooltip}"
                               FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Opacity="0.75" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- Waiting is a state, and it has to name what it is waiting for and show
               that something is still happening (UI rule 18). A bare "Loading…" and,
               worse, the empty state that used to render in its place are the two ways
               a slow list reads as a broken one. The shape deliberately mirrors the
               empty state below it — same layout, same second line — so the transition
               from waiting to a verdict changes the words and not the page. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="320"
                      IsVisible="{Binding IsListLoading}">
            <ProgressBar IsIndeterminate="True" Width="150" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SelectedKind.DisplayName, StringFormat='Loading {0}…'}"
                       FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" />
            <TextBlock Text="{Binding SelectedNamespace, StringFormat='in {0}'}" FontSize="12" Opacity="0.5"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SelectedKind.Descriptor.Namespaced}" />
          </StackPanel>

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="320"
                      IsVisible="{Binding IsListEmpty}">
            <PathIcon Data="{Binding SelectedKind.IconKey, Converter={x:Static conv:IconKeyToGeometryConverter.Instance}}"
                      Width="28" Height="28" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding SelectedKind.DisplayName, StringFormat='No {0} found'}"
                       FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" />
            <TextBlock Text="{Binding SelectedNamespace, StringFormat='in {0}'}" FontSize="12" Opacity="0.5"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding SelectedKind.Descriptor.Namespaced}" />
            <!-- Events only: an empty events list usually means "nothing recent", because
                 events expire (an hour by default), and saying so stops it reading as a
                 broken watch. -->
            <TextBlock Text="{Binding EmptyListHint}" FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"
                       IsVisible="{Binding EmptyListHint, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" />
          </StackPanel>

          <!-- "The search matched nothing" is a different state from "this kind has
               nothing" (UI rule 9), and the two lead to opposite next steps — one is a
               typo, the other is an empty namespace. Says how many rows it filtered out
               of, and offers the way back. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360"
                      IsVisible="{Binding IsFilterEmpty}">
            <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="26" Height="26" Opacity="0.25"
                      HorizontalAlignment="Center" />
            <TextBlock Text="{Binding RowFilter, StringFormat='Nothing matches “{0}”'}"
                       FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Rows.Count, StringFormat='{}{0} in the list'}" FontSize="12" Opacity="0.5"
                       HorizontalAlignment="Center" />
            <Button Classes="chip" HorizontalAlignment="Center" Command="{Binding ClearRowFilterCommand}"
                    Content="Clear search" />
          </StackPanel>

          <!-- Unhealthy-only emptied the list: the good-news state, and a third one
               beside "no <kind> found" and "nothing matches" (UI rule 9) — a check mark
               rather than the kind's glyph or a magnifier, so it cannot be read as
               either. States what it counted over and offers the way back. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360"
                      IsVisible="{Binding IsHealthFilterEmpty}">
            <PathIcon Data="{StaticResource CheckIconGeometry}" Width="26" Height="26" Opacity="0.3"
                      HorizontalAlignment="Center" />
            <TextBlock Text="{Binding HealthFilterEmptyTitle}"
                       FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding HealthFilterEmptyDetail}" FontSize="12" Opacity="0.5"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HealthFilterEmptyDetail, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" />
            <Button Classes="chip" HorizontalAlignment="Center" Command="{Binding ShowAllRowsCommand}"
                    Content="Show every row" />
          </StackPanel>
        </Grid>

        <!-- Helm release browser: same slot as the resource list, shown when the
             synthetic Helm sidebar entry is selected. Read-only. -->
        <Grid Grid.Row="1" IsVisible="{Binding IsHelmView}">
          <DataGrid Name="HelmGrid"
                     ItemsSource="{Binding HelmReleases}" SelectedItem="{Binding SelectedHelmRelease}"
                     IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                     DoubleTapped="OnHelmRowDoubleTapped">
            <DataGrid.Columns>
              <!-- No health dot here, for the same reason the resource list no longer
                   has one: this grid always shows its Status column, and that column is
                   already colour-coded from the same StatusHealth *and* spells the word
                   ("deployed", "failed", "superseded"). A dot beside it encoded the same
                   fact a second time and bought 28px of nothing. The resource list keeps
                   a dot in exactly one case — where a CRD's own printer columns have
                   replaced the Status column, so the dot is the last thing carrying the
                   classification — and this grid has no such case. -->
              <DataGridTemplateColumn Header="Namespace" Width="Auto" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding Namespace}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Release" Width="2*" MinWidth="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Chart" Width="*" MinWidth="140">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding Chart}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Chart}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="App" Width="Auto" MinWidth="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding AppVersion}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Rev" Width="Auto" MinWidth="50">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding Revision}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <Border Classes="statusPill" Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                            Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                            Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}"
                            ToolTip.Tip="{Binding Description}">
                      <TextBlock Text="{Binding Status}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Updated" Width="Auto" MinWidth="150">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:HelmReleaseRowViewModel">
                    <TextBlock Text="{Binding Updated}" Opacity="0.75" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <TextBlock Text="Reading Helm releases…" Opacity="0.5" FontSize="13"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsHelmLoading}" />

          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="340"
                      IsVisible="{Binding IsHelmEmpty}">
            <PathIcon Data="{StaticResource LayersIconGeometry}" Width="28" Height="28" Opacity="0.25" HorizontalAlignment="Center" />
            <TextBlock Text="No Helm releases found" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7" />
            <TextBlock Text="{Binding SelectedNamespace, StringFormat='in {0}'}" FontSize="12" Opacity="0.5" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <!-- Argo CD dashboard: the same slot again, shown when the synthetic Argo entry is
             selected. Two pills per row rather than one Status column, because sync and
             health are independent — an Application can be Synced and Degraded, or OutOfSync
             and Healthy, and a single column cannot say both. No leading health dot: the
             pills are already colour-coded from the same classification *and* spell the
             word, which is exactly the double encoding the resource list dropped its dot to
             avoid. -->
        <!-- ClipToBounds, and it is not cosmetic: maximizing the inspector works by setting
             this row's height to 0 (ClusterTabView.ApplyDockState), and a Grid does not clip
             its children by default. The list and the Helm browser get away with it because
             a DataGrid clips itself; this one's summary card is an ordinary Border, so
             without this it goes on painting straight through the maximized dock — which is
             what the first render of it did. -->
        <Grid Grid.Row="1" IsVisible="{Binding IsArgoView}" RowDefinitions="Auto,*" ClipToBounds="True">

          <!-- The seven counts Argo CD's own dashboard opens on, plus the one sentence that
               answers "is anything wrong right now" without counting pills. Absent until the
               first read completes, so the strip never shows seven zeros while loading. -->
          <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,8"
                  IsVisible="{Binding ArgoCounts, Converter={x:Static aconv:ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Applications" />
                  <TextBlock Text="{Binding ArgoCounts.Total}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Synced" />
                  <TextBlock Text="{Binding ArgoCounts.Synced}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Healthy" />
                  <TextBlock Text="{Binding ArgoCounts.Healthy}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Out of sync" />
                  <TextBlock Text="{Binding ArgoCounts.OutOfSync}" FontSize="18" FontWeight="SemiBold" Classes="statusText warn" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Degraded" />
                  <TextBlock Text="{Binding ArgoCounts.Degraded}" FontSize="18" FontWeight="SemiBold" Classes="statusText error" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Missing" />
                  <TextBlock Text="{Binding ArgoCounts.Missing}" FontSize="18" FontWeight="SemiBold" Classes="statusText error" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="fieldLabel" Text="Progressing" />
                  <TextBlock Text="{Binding ArgoCounts.Progressing}" FontSize="18" FontWeight="SemiBold" />
                </StackPanel>
              </StackPanel>
              <TextBlock Classes="statusText" Text="{Binding ArgoAttentionSummary}" TextWrapping="Wrap"
                         IsVisible="{Binding ArgoAttentionSummary, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="1">
            <DataGrid Name="ArgoGrid"
                       ItemsSource="{Binding ArgoApplications}" SelectedItem="{Binding SelectedArgoApplication}"
                       IsReadOnly="True" GridLinesVisibility="Horizontal" CanUserResizeColumns="True"
                       DoubleTapped="OnArgoRowDoubleTapped">
              <!-- The two actions Argo's own UI leads with, on the row rather than on a
                   toolbar (UI rule 1). Both arm the confirm strip above the list rather than
                   firing on the click — a sync applies whatever Git currently says to a live
                   cluster, which is at least as consequential as a rollout restart. -->
              <DataGrid.ContextFlyout>
                <MenuFlyout>
                  <MenuItem Header="Sync…" Command="{Binding SyncArgoApplicationCommand}"
                            ToolTip.Tip="Ask Argo CD to apply the revision this Application targets">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource SyncIconGeometry}" Width="13" Height="13" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Refresh…" Command="{Binding RefreshArgoApplicationCommand}"
                            ToolTip.Tip="Ask Argo to re-compare this Application against Git. Changes nothing on the cluster.">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="13" Height="13" />
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="Open" Command="{Binding OpenArgoApplicationCommand}"
                            ToolTip.Tip="Managed resources, conditions and deployment history" />
                </MenuFlyout>
              </DataGrid.ContextFlyout>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Application" Width="2*" MinWidth="150">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Tooltip}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Project" Width="Auto" MinWidth="90">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding Project}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Sync" Width="Auto" MinWidth="104">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <Border Classes="statusPill"
                              Classes.ok="{Binding SyncHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                              Classes.warn="{Binding SyncHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                              Classes.error="{Binding SyncHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}">
                        <TextBlock Text="{Binding SyncText}" FontSize="11.5" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Health" Width="Auto" MinWidth="104">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <Border Classes="statusPill"
                              Classes.ok="{Binding HealthHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                              Classes.warn="{Binding HealthHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
                              Classes.error="{Binding HealthHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}"
                              ToolTip.Tip="{Binding Application.HealthMessage}">
                        <TextBlock Text="{Binding HealthText}" FontSize="11.5" />
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Revision" Width="Auto" MinWidth="82">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding Revision}" VerticalAlignment="Center" Opacity="0.8"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Destination" Width="Auto" MinWidth="100">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding Destination}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Destination}" VerticalAlignment="Center" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Source" Width="*" MinWidth="130">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding SourceSummary}" TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding RepoUrl}" VerticalAlignment="Center" FontSize="11.5" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Policy" Width="Auto" MinWidth="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="vm:ArgoApplicationRowViewModel">
                      <TextBlock Text="{Binding SyncPolicy}" VerticalAlignment="Center" FontSize="11.5" Opacity="0.8"
                                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SyncPolicy}" />
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Reading Argo CD Applications…" Opacity="0.5" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding IsArgoLoading}" />

            <!-- Argo installed, no Applications yet: its own state, and a different problem
                 from "Argo is not here" — which never reaches this view at all, because the
                 sidebar row only exists on a cluster that serves the Application kind. -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="360"
                        IsVisible="{Binding IsArgoEmpty}">
              <PathIcon Data="{StaticResource SourceBranchIconGeometry}" Width="28" Height="28" Opacity="0.25"
                        HorizontalAlignment="Center" />
              <TextBlock Text="No Argo CD Applications on this cluster" FontWeight="SemiBold" FontSize="13"
                         HorizontalAlignment="Center" Opacity="0.7" />
              <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.5"
                         Text="Argo CD is installed — it serves the Application kind — but nothing has been registered with it yet, or this account cannot read the namespace they live in." />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- Drag handle between the list and the bottom dock. -->
        <GridSplitter Grid.Row="2" Name="DockSplitter" Classes="dock" Height="7"
                      ResizeDirection="Rows" IsVisible="False" />

        <!-- Bottom inspector dock (Lens-style). -->
        <Border Grid.Row="3" Name="DockRegion" Classes="card" Padding="0" IsVisible="False">
          <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Classes="dockHeader">
              <ItemsControl Grid.Column="0" ItemsSource="{Binding InspectorTabs}" Margin="4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:InspectorTabViewModelBase">
                    <Border Classes="dockTab" Classes.active="{Binding IsActive}" Margin="2" Tapped="OnInspectorTabTapped">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- Trimmed: a generated pod name ("Pod/payment-service-report-generator
                             -7f9c8d6bcd-x7k2m") is 50 characters of which the last few are the
                             only ones that differ, and at full length two open tabs fill the
                             strip and push it onto a second row. The full title is on the
                             tooltip, and the trimming keeps the tail's hash visible for as
                             long as the width allows. -->
                        <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="240" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"
                                   Opacity="{Binding IsPreview, Converter={x:Static conv:PreviewToOpacityConverter.Instance}}" />
                        <Button Classes="chip" Padding="0" MinWidth="14" MinHeight="14"
                                Command="{Binding $parent[UserControl].((vm:ClusterTabViewModel)DataContext).CloseInspectorTabCommand}"
                                CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource CloseIconGeometry}" Width="9" Height="9" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Grid.Column="1" Classes="toolbar" Margin="0,4,4,0"
                      Command="{Binding ToggleInspectorMaximizedCommand}"
                      ToolTip.Tip="{Binding IsInspectorMaximized, Converter={x:Static conv:MaximizedToTooltipConverter.Instance}}"
                      Padding="6">
                <PathIcon Width="13" Height="13"
                          Data="{Binding IsInspectorMaximized, Converter={x:Static conv:MaximizedToIconConverter.Instance}}" />
              </Button>
            </Grid>

            <ContentControl Grid.Row="1" Content="{Binding SelectedInspectorTab}" />
          </Grid>
        </Border>
      </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
