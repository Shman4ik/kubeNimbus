<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:term="using:SvcSystems.UI.Terminal"
             x:Class="KubeNimbus.App.Views.ExecView"
             x:DataType="vm:ExecTabViewModel">

  <UserControl.Resources>
    <!-- Right-click menu, opened by hand from TerminalControl.ContextRequested: the
         control raises its own event instead of the base ContextRequested, so the
         standard ContextMenu attachment never fires. A menu rather than
         RightClickAction.CopyOrPaste, which pastes on any right-click into an empty
         selection — one stray click away from running whatever is on the clipboard
         in someone's production container. -->
    <ContextMenu x:Key="TerminalMenu">
      <MenuItem Header="Copy" Click="OnCopyClick" />
      <MenuItem Header="Paste" Click="OnPasteClick" />
      <Separator />
      <MenuItem Header="Select all" Click="OnSelectAllClick" />
    </ContextMenu>
  </UserControl.Resources>

  <!-- Two mutually exclusive contents, so the UserControl gets one child. -->
  <Panel>

  <!-- Demo cluster: the pane's whole function is a websocket to a real kubelet, so
       there is nothing underneath to show. Says what it can't do and what to do
       instead — never a terminal that sits on "Connecting…" forever (UI rule 9). -->
  <Border Classes="demoUnavailable" IsVisible="{Binding IsDemo}">
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource ConsoleIconGeometry}" Width="15" Height="15" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Text="Exec isn't available here" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{x:Static vm:ExecTabViewModel.DemoNotice}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </StackPanel>
  </Border>

  <!-- One row of chrome, then the terminal (UI rule 10). The input box and its Send
       button are gone: the terminal takes keystrokes itself, so a second row spent
       retyping them into a TextBox was a row of dock height buying nothing. -->
  <Grid RowDefinitions="Auto,*" Margin="10,8,10,10" IsVisible="{Binding !IsDemo}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <Ellipse Grid.Column="0" Classes="statusDot" Classes.ok="{Binding IsConnected}" Classes.idle="{Binding !IsConnected}"
               VerticalAlignment="Center" Margin="0,0,8,0" />
      <!-- Hidden while the overlay below is showing the same sentence, larger and
           unabbreviated. The dot still carries the state either way. -->
      <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Opacity="0.75" FontSize="12" VerticalAlignment="Center"
                 IsVisible="{Binding !IsStatusOverlayVisible}"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />

      <!-- Shell box + reconnect. /bin/sh was hardcoded, so a bash-only or distroless
           image gave a connected-looking blank terminal with no way to try anything
           else. Empty means "try the usual shells for this pod's OS" — bash, sh, ash on
           Linux, powershell, cmd on a Windows node — and the placeholder says which. -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBox Text="{Binding ShellCommand}" Width="150" FontSize="11.5" PlaceholderText="{Binding ShellPlaceholder}"
                 Classes="mono"
                 ToolTip.Tip="{Binding ShellTip}" />
        <Button Classes="toolbar" Padding="6" Command="{Binding ReconnectCommand}" ToolTip.Tip="Reconnect with this shell">
          <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ClipToBounds because the terminal paints its own opaque background edge to
         edge and would otherwise square off the card's rounded corners. -->
    <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
      <Panel>
        <!-- The token rather than the `mono` class, the one code surface that has to
             (DESIGN.md rule 22): TerminalControl is a Grid with a FontFamily property of
             its own, not inherited, which neither the class's selectors (TextBlock,
             TemplatedControl) nor TextElement.FontFamily reach. With the class it drew
             in the interface face, and `top`'s columns stopped lining up. -->
        <term:TerminalControl Name="Terminal" Model="{Binding Terminal}"
                              FontFamily="{DynamicResource MonoFont}" FontSize="12" />

        <!-- The blank-screen states (UI rule 9): connecting, no usable shell, a
             session that ended before printing anything. A terminal with nothing in
             it looks identical to a broken pane, so the status covers it until the
             first byte arrives and then gets out of the way. -->
        <Border IsVisible="{Binding IsStatusOverlayVisible}" Padding="24" IsHitTestVisible="{Binding IsDebugOfferVisible}">
          <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TerminalForegroundBrush}" Opacity="0.75" />

            <!-- No shell in the image: kubectl debug's answer, in place. The click is the
                 confirmation (the sentence says what it adds and that it stays), and it is
                 offered only after every shell was refused as missing — never for a 403. -->
            <Border Classes="overlayCard" Padding="14" IsVisible="{Binding IsDebugOfferVisible}">
              <StackPanel Spacing="10">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="A debug container joins the pod from another image and shares this container's processes and network. It stays in the pod until the pod is recreated." />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Name="DebugImageLabel" Classes="fieldLabel" Text="Debug image" />
                    <TextBox Text="{Binding DebugImage}" Classes="mono" FontSize="11.5"
                             AutomationProperties.LabeledBy="{Binding #DebugImageLabel}"
                             ToolTip.Tip="Any image with a shell. The default is BusyBox 1.37 from Docker Hub (4 MB), pinned to its digest; an air-gapped cluster needs its own mirror here." />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" VerticalAlignment="Bottom"
                          Content="Start debug container" Command="{Binding StartDebugContainerCommand}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- The armed multi-line paste (ExecTabViewModel.Paste): the shell has not turned
             on bracketed paste, so each line would run as it arrived. Laid over the top of
             the terminal rather than docked as a row above it: present only while armed
             (UI rule 1), no third row of dock chrome (rule 10) and no resize of the remote
             PTY for a question; the top, because the prompt the paste will land at is at
             the bottom and stays in view. The gesture that armed it never runs it (rule 17's
             pattern), and Esc cancels. -->
        <Border Classes="overlayCard" IsVisible="{Binding HasPendingPaste}" VerticalAlignment="Top"
                HorizontalAlignment="Stretch" Margin="10" Padding="12,10" KeyDown="OnPasteStripKeyDown">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding PendingPastePrompt}" TextWrapping="Wrap" FontSize="12"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Name="PasteConfirmButton" Classes="accent" Content="Paste" Margin="12,0,0,0"
                    VerticalAlignment="Center" Command="{Binding ConfirmPasteCommand}" Click="OnPasteStripButtonClick"
                    ToolTip.Tip="Send every line to the shell" />
            <Button Grid.Column="2" Content="Cancel" Margin="6,0,0,0" VerticalAlignment="Center"
                    Command="{Binding CancelPasteCommand}" Click="OnPasteStripButtonClick"
                    ToolTip.Tip="Send nothing (Esc)" />
          </Grid>
        </Border>
      </Panel>
    </Border>
  </Grid>
  </Panel>
</UserControl>
