<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:term="using:SvcSystems.UI.Terminal"
             x:Class="KubeNimbus.App.Views.ExecView"
             x:DataType="vm:ExecTabViewModel">

  <UserControl.Resources>
    <!-- Right-click menu, opened by hand from TerminalControl.ContextRequested: the
         control raises its own event instead of the base ContextRequested, so the
         standard ContextMenu attachment never fires. A menu rather than
         RightClickAction.CopyOrPaste, which pastes on any right-click into an empty
         selection — one stray click away from running whatever is on the clipboard
         in someone's production container. -->
    <ContextMenu x:Key="TerminalMenu">
      <MenuItem Header="Copy" Click="OnCopyClick" />
      <MenuItem Header="Paste" Click="OnPasteClick" />
      <Separator />
      <MenuItem Header="Select all" Click="OnSelectAllClick" />
    </ContextMenu>
  </UserControl.Resources>

  <!-- Two mutually exclusive contents, so the UserControl gets one child. -->
  <Panel>

  <!-- Demo cluster: the pane's whole function is a websocket to a real kubelet, so
       there is nothing underneath to show. Says what it can't do and what to do
       instead — never a terminal that sits on "Connecting…" forever (UI rule 9). -->
  <Border Classes="demoUnavailable" IsVisible="{Binding IsDemo}">
    <StackPanel Spacing="10">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <PathIcon Data="{StaticResource ConsoleIconGeometry}" Width="15" Height="15" VerticalAlignment="Center" Opacity="0.7" />
        <TextBlock Text="Exec isn't available here" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{x:Static vm:ExecTabViewModel.DemoNotice}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
    </StackPanel>
  </Border>

  <!-- One row of chrome, then the terminal (UI rule 10). The input box and its Send
       button are gone: the terminal takes keystrokes itself, so a second row spent
       retyping them into a TextBox was a row of dock height buying nothing. -->
  <Grid RowDefinitions="Auto,*" Margin="10,8,10,10" IsVisible="{Binding !IsDemo}">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <Ellipse Grid.Column="0" Classes="statusDot" Classes.ok="{Binding IsConnected}" Classes.idle="{Binding !IsConnected}"
               VerticalAlignment="Center" Margin="0,0,8,0" />
      <!-- Hidden while the overlay below is showing the same sentence, larger and
           unabbreviated. The dot still carries the state either way. -->
      <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Opacity="0.75" FontSize="12" VerticalAlignment="Center"
                 IsVisible="{Binding !IsStatusOverlayVisible}"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusMessage}" />

      <!-- Shell box + reconnect. /bin/sh was hardcoded, so a bash-only or distroless
           image gave a connected-looking blank terminal with no way to try anything
           else. Empty means "try bash, then sh, then ash". -->
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBox Text="{Binding ShellCommand}" Width="130" FontSize="11.5" PlaceholderText="auto (bash/sh/ash)"
                 FontFamily="Cascadia Mono,Consolas,monospace"
                 ToolTip.Tip="Shell to exec. Leave empty to try /bin/bash, /bin/sh, then /bin/ash." />
        <Button Classes="toolbar" Padding="6" Command="{Binding ReconnectCommand}" ToolTip.Tip="Reconnect with this shell">
          <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- ClipToBounds because the terminal paints its own opaque background edge to
         edge and would otherwise square off the card's rounded corners. -->
    <Border Grid.Row="1" Classes="card" Padding="0" ClipToBounds="True">
      <Panel>
        <term:TerminalControl Name="Terminal" Model="{Binding Terminal}"
                              FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" FontSize="12" />

        <!-- The blank-screen states (UI rule 9): connecting, no usable shell, a
             session that ended before printing anything. A terminal with nothing in
             it looks identical to a broken pane, so the status covers it until the
             first byte arrives and then gets out of the way. -->
        <Border IsVisible="{Binding IsStatusOverlayVisible}" Padding="24" IsHitTestVisible="False">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                     HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520"
                     Foreground="{StaticResource TerminalForegroundBrush}" Opacity="0.75" />
        </Border>
      </Panel>
    </Border>
  </Grid>
  </Panel>
</UserControl>
