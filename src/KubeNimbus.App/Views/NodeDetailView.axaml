<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:core="using:KubeNimbus.Core"
             xmlns:conv="using:KubeNimbus.App.Converters"
             x:Class="KubeNimbus.App.Views.NodeDetailView"
             x:DataType="vm:NodeDetailTabViewModel">

  <!-- No title row: the dock tab above already reads `Node/<name>`, and a row that
       repeats it is a row of a ~300px dock spent on nothing (UI rule 10). One chrome
       row only — the segmented strip, the node's own status, and the selected tab's
       tools sharing it — with the headerless TabControl carrying the content, which is
       the pattern pod detail, Helm and the access review all use. -->
  <Grid RowDefinitions="Auto,*" Margin="10,8,10,10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
      <ListBox Grid.Column="0" Classes="segmented" SelectedIndex="{Binding SelectedTabIndex}">
        <ListBoxItem Content="Overview" />
        <ListBoxItem Content="Pods" />
      </ListBox>

      <Border Grid.Column="1" Classes="statusPill" Margin="10,0,0,0" VerticalAlignment="Center"
              Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
              Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
              Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}">
        <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
      </Border>

      <TextBlock Grid.Column="2" Text="{Binding Roles}" Opacity="0.6" FontSize="12"
                 VerticalAlignment="Center" Margin="10,0,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Roles}" />

      <!-- Only on the Pods tab: the Overview follows the node's own watch and has
           nothing to refresh (UI rule 10 — a tool that belongs to one tab rides that
           tab's slot on the shared row rather than taking a row of its own). -->
      <TextBlock Grid.Column="4" Text="{Binding PodsCaption}" Opacity="0.6" FontSize="12"
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=1}" />
      <Button Grid.Column="5" Classes="toolbar" Padding="6" Command="{Binding RefreshPodsCommand}"
              ToolTip.Tip="Re-read the pods scheduled on this node"
              IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=1}">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
      </Button>
    </Grid>

    <TabControl Grid.Row="1" Classes="headerless" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ============================================================ Overview -->
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Spacing="8">

            <!-- Allocatable vs requested. The number people open a node for: how much of
                 it the scheduler has already promised away. Allocatable is the
                 denominator, not capacity — see NodeResources.Summarize. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionHeader" Text="ALLOCATABLE VS REQUESTED" />

                <TextBlock Classes="statusText dim" IsVisible="{Binding !HasResourceSummary}"
                           Text="Counting the pods on this node…" />

                <ItemsControl ItemsSource="{Binding ResourceLines}" IsVisible="{Binding HasResourceSummary}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeResourceLineViewModel">
                      <Grid ColumnDefinitions="70,*,Auto" Margin="0,3" ToolTip.Tip="{Binding Tooltip}">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />

                        <!-- Clamped at 100 even when the requests oversubscribe, which is
                             legitimate and does happen: a bar that ran past its own track
                             would say less than the percentage printed beside it already
                             does. -->
                        <ProgressBar Grid.Column="1" Margin="8,0" Height="6" Minimum="0" Maximum="100"
                                     VerticalAlignment="Center"
                                     Value="{Binding RequestedPercentValue}" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock FontSize="12" FontFamily="Cascadia Mono,Consolas,monospace"
                                     Text="{Binding RequestedText}" />
                          <TextBlock FontSize="12" Opacity="0.55" Text="/" />
                          <TextBlock FontSize="12" Opacity="0.7" FontFamily="Cascadia Mono,Consolas,monospace"
                                     Text="{Binding AllocatableText}" />
                          <TextBlock FontSize="12" MinWidth="42" TextAlignment="Right"
                                     Classes="statusText" Classes.warn="{Binding IsTight}"
                                     Text="{Binding RequestedPercentText}" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="statusText dim" FontSize="11.5" TextWrapping="Wrap"
                           IsVisible="{Binding HasResourceSummary}"
                           Text="Requested is what the scheduler has promised, not what is being used — a node can be full of requests and idle, or busy and mostly unrequested." />
              </StackPanel>
            </Border>

            <!-- Conditions. Ready is healthy when True and every pressure condition is
                 healthy when False; NodeCondition.IsProblem reads that polarity off the
                 one condition Kubernetes defines as positive rather than off a list of
                 the negative ones, so a condition nobody has heard of is classified the
                 same way kubectl classifies it. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="CONDITIONS" />
                <ItemsControl ItemsSource="{Binding Conditions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeConditionViewModel">
                      <Grid ColumnDefinitions="Auto,150,Auto,*" Margin="0,2">
                        <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding Health, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" Opacity="0.7"
                                   MinWidth="56" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Message}"
                                   ToolTip.Tip="{Binding Message}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Taints. A cordoned node carries the scheduler's own
                 node.kubernetes.io/unschedulable taint as well as spec.unschedulable, so
                 both halves of "why is nothing landing here" are on the same card. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="TAINTS" />
                <TextBlock Classes="statusText dim" IsVisible="{Binding HasNoTaints}"
                           Text="No taints. Any pod that tolerates this node's other constraints can be scheduled here." />
                <ItemsControl ItemsSource="{Binding Taints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:NodeTaint">
                      <SelectableTextBlock Text="{Binding Display}" FontSize="12" Margin="0,2"
                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionHeader" Text="KUBELET" />
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" FontSize="12" Opacity="0.6" />
                  <SelectableTextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Text="{Binding Info.KubeletVersion}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="OS image" FontSize="12" Opacity="0.6" />
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="{Binding Info.OsImage}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Kernel" FontSize="12" Opacity="0.6" />
                  <SelectableTextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="{Binding Info.KernelVersion}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Runtime" FontSize="12" Opacity="0.6" />
                  <SelectableTextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Text="{Binding Info.ContainerRuntime}" />
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Internal IP" FontSize="12" Opacity="0.6" />
                  <SelectableTextBlock Grid.Row="4" Grid.Column="1" FontSize="12" Text="{Binding Info.InternalIp}" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================ Pods -->
      <TabItem Header="Pods">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="infoBar error" Margin="0,0,0,8"
                  IsVisible="{Binding HasPodsError}">
            <TextBlock Text="{Binding PodsError}" TextWrapping="Wrap" FontSize="12" />
          </Border>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Pods}" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="28">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <Ellipse Classes="statusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding StatusHealth, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Namespace" Width="Auto" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Namespace}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Name" Width="*" MinWidth="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="CPU req" Width="Auto" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding CpuRequestText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Mem req" Width="Auto" MinWidth="92">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding MemoryRequestText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Age" Width="Auto" MinWidth="56">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding AgeText}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Same affordance the events feed uses to reach the object it is about,
                   rather than a double-click nothing announces. -->
              <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <Button Classes="chip" Padding="0" MinWidth="20" MinHeight="20" VerticalAlignment="Center"
                            ToolTip.Tip="Open this pod"
                            Command="{Binding $parent[UserControl].((vm:NodeDetailTabViewModel)DataContext).OpenPodCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="10" Height="10" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
