<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:core="using:KubeNimbus.Core"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:controls="using:KubeNimbus.App.Controls"
             x:Class="KubeNimbus.App.Views.NodeDetailView"
             x:DataType="vm:NodeDetailTabViewModel">

  <!-- No title row: the dock tab above already reads `Node/<name>`, and a row that
       repeats it is a row of a ~300px dock spent on nothing (UI rule 10). One chrome
       row only — the segmented strip, the node's own status, and the selected tab's
       tools sharing it — with the headerless TabControl carrying the content, which is
       the pattern pod detail, Helm and the access review all use. -->
  <Grid RowDefinitions="Auto,*" Margin="10,8,10,10">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="0,0,0,8">
      <ListBox Grid.Column="0" Classes="segmented" SelectedIndex="{Binding SelectedTabIndex}">
        <ListBoxItem Content="Overview" />
        <ListBoxItem Content="Pods" />
        <ListBoxItem Content="Events" />
        <ListBoxItem Content="Usage" />
      </ListBox>

      <Border Grid.Column="1" Classes="statusPill" Margin="10,0,0,0" VerticalAlignment="Center"
              Classes.ok="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
              Classes.warn="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}"
              Classes.error="{Binding StatusHealth, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=error}">
        <TextBlock Text="{Binding StatusText}" FontSize="11.5" />
      </Border>

      <TextBlock Grid.Column="2" Text="{Binding Roles}" Opacity="0.6" FontSize="12"
                 VerticalAlignment="Center" Margin="10,0,0,0"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Roles}" />

      <!-- Each tab's own tools ride its slot on the shared row (UI rule 10): a caption
           and a Refresh for the two one-shot reads (Pods, Events), the window caption
           for Usage. The Overview follows the node's own watch and has nothing to
           refresh. Exactly one of each column's children is ever visible. -->
      <TextBlock Grid.Column="4" Text="{Binding PodsCaption}" Opacity="0.6" FontSize="12"
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=1}" />
      <TextBlock Grid.Column="4" Text="{Binding EventsCaption}" Opacity="0.6" FontSize="12"
                 VerticalAlignment="Center" Margin="0,0,8,0"
                 IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=2}" />
      <TextBlock Grid.Column="4" Text="{Binding UsageWindowCaption}" Classes="sectionHeader"
                 VerticalAlignment="Center" Margin="0,0,4,0"
                 IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=3}" />
      <Button Grid.Column="5" Classes="toolbar" Padding="6" Command="{Binding RefreshPodsCommand}"
              ToolTip.Tip="Re-read the pods scheduled on this node"
              IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=1}">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
      </Button>
      <Button Grid.Column="5" Classes="toolbar" Padding="6" Command="{Binding RefreshEventsCommand}"
              ToolTip.Tip="Re-read the events about this node"
              IsVisible="{Binding SelectedTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=2}">
        <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="14" Height="14" />
      </Button>
    </Grid>

    <TabControl Grid.Row="1" Classes="headerless" SelectedIndex="{Binding SelectedTabIndex}">

      <!-- ============================================================ Overview -->
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Spacing="8">

            <!-- Allocatable vs requested. The number people open a node for: how much of
                 it the scheduler has already promised away. Allocatable is the
                 denominator, not capacity — see NodeResources.Summarize. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="8">
                <TextBlock Classes="sectionHeader" Text="ALLOCATABLE VS REQUESTED" />

                <TextBlock Classes="statusText dim" IsVisible="{Binding !HasResourceSummary}"
                           Text="Counting the pods on this node…" />

                <!-- Every column but the track is a *fixed* width, and that is the whole
                     point of the layout rather than a tidiness preference. This row used
                     to be `70,*,Auto` with the numbers in the Auto column, so the star
                     column ended wherever that row's own text happened to stop: CPU,
                     Memory and Pods print different-width figures, so the three tracks
                     came out three different lengths — aligned at the left, ragged at the
                     right — and three bars of different lengths cannot be compared row to
                     row, which is the entire job of this card. Fixed number columns give
                     every track the same start and the same end. -->
                <ItemsControl ItemsSource="{Binding ResourceLines}" IsVisible="{Binding HasResourceSummary}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeResourceLineViewModel">
                      <Grid ColumnDefinitions="62,*,76,12,76,46,168" Margin="0,3" ToolTip.Tip="{Binding Tooltip}">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />

                        <!-- One track carrying both figures, not two stacked bars: a
                             second bar per resource would triple the card's height in a
                             ~300px dock (UI rule 10) to say something this axis already
                             carries. The requested fill clamps at the track; the limit
                             marker does not silently clamp — see ResourceMeter. The
                             marker takes the theme's high-contrast foreground rather than
                             a second accent: it is routinely drawn *on top of* the accent
                             fill (limits below requested is ordinary — a limit sums only
                             the containers that declare one), and accent-on-accent is
                             invisible on the dark theme, which is where this repo has
                             hidden colour bugs before. -->
                        <controls:ResourceMeter Grid.Column="1" Margin="8,0" Height="8"
                                                VerticalAlignment="Center"
                                                RequestedPercent="{Binding RequestedPercentValue}"
                                                LimitPercent="{Binding LimitPercentValue}"
                                                TrackBrush="{DynamicResource MeterTrackBrush}"
                                                FillBrush="{DynamicResource AppAccentBrush}"
                                                LimitBrush="#552D7FF9"
                                                MarkerBrush="{DynamicResource SystemControlForegroundBaseHighBrush}"
                                                OverBrush="{DynamicResource AppWarningBrush}" />

                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center"
                                   TextAlignment="Right" FontFamily="Cascadia Mono,Consolas,monospace"
                                   Text="{Binding RequestedText}" />
                        <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center"
                                   TextAlignment="Center" Opacity="0.55" Text="/" />
                        <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center"
                                   TextAlignment="Right" Opacity="0.7"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   Text="{Binding AllocatableText}" />
                        <TextBlock Grid.Column="5" FontSize="12" VerticalAlignment="Center"
                                   TextAlignment="Right" Margin="6,0,0,0"
                                   Classes="statusText" Classes.warn="{Binding IsTight}"
                                   Text="{Binding RequestedPercentText}" />

                        <!-- Empty for the pods row, which has no limit at all — so it
                             renders no marker, no caption and no dangling separator
                             rather than an empty slot the two rows above it fill. -->
                        <TextBlock Grid.Column="6" FontSize="12" VerticalAlignment="Center"
                                   TextAlignment="Right" Margin="10,0,0,0"
                                   FontFamily="Cascadia Mono,Consolas,monospace"
                                   Classes="statusText" Classes.warn="{Binding IsOvercommitted}"
                                   Text="{Binding LimitSummaryText}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="statusText dim" FontSize="11.5" TextWrapping="Wrap"
                           IsVisible="{Binding HasResourceSummary}"
                           Text="Requested is what the scheduler has promised, not what is being used — a node can be full of requests and idle, or busy and mostly unrequested. The filled part of each track is requested; the tick is where the declared limits fall on the same scale, counting only the containers that set one. Limits past the track's end are ordinary overcommit, and the marker turns amber rather than sitting flush." />
              </StackPanel>
            </Border>

            <!-- Conditions. Ready is healthy when True and every pressure condition is
                 healthy when False; NodeCondition.IsProblem reads that polarity off the
                 one condition Kubernetes defines as positive rather than off a list of
                 the negative ones, so a condition nobody has heard of is classified the
                 same way kubectl classifies it. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="CONDITIONS" />
                <ItemsControl ItemsSource="{Binding Conditions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeConditionViewModel">
                      <Grid ColumnDefinitions="Auto,150,Auto,*" Margin="0,2">
                        <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding Health, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" Opacity="0.7"
                                   MinWidth="56" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Message}"
                                   ToolTip.Tip="{Binding Message}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Taints. A cordoned node carries the scheduler's own
                 node.kubernetes.io/unschedulable taint as well as spec.unschedulable, so
                 both halves of "why is nothing landing here" are on the same card. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="TAINTS" />
                <TextBlock Classes="statusText dim" IsVisible="{Binding HasNoTaints}"
                           Text="No taints. Any pod that tolerates this node's other constraints can be scheduled here." />
                <ItemsControl ItemsSource="{Binding Taints}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:NodeTaint">
                      <SelectableTextBlock Text="{Binding Display}" FontSize="12" Margin="0,2"
                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- The machine behind the node: what it runs, where it is, how it is
                 addressed, when it joined. One label/value line per thing the node
                 actually reported — NodeDetailTabViewModel.BuildSystemRows leaves out
                 what is absent, so a bare-metal node has no Provider ID row rather than a
                 label beside nothing. Selectable, because IPs and provider IDs are what
                 people copy out of this card. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="4">
                <TextBlock Classes="sectionHeader" Text="SYSTEM" />
                <ItemsControl ItemsSource="{Binding SystemRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:NodeSystemRow">
                      <Grid ColumnDefinitions="130,*" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" Opacity="0.6" />
                        <SelectableTextBlock Grid.Column="1" FontSize="12" Text="{Binding Value}"
                                             TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ================================================================ Pods -->
      <TabItem Header="Pods">
        <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" Classes="infoBar error" Margin="0,0,0,8"
                  IsVisible="{Binding HasPodsError}">
            <TextBlock Text="{Binding PodsError}" TextWrapping="Wrap" FontSize="12" />
          </Border>

          <DataGrid Grid.Row="1" ItemsSource="{Binding Pods}" IsReadOnly="True"
                    GridLinesVisibility="Horizontal" CanUserResizeColumns="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="28">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <Ellipse Classes="statusDot" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding StatusHealth, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Namespace" Width="Auto" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Namespace}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Namespace}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Name" Width="*" MinWidth="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Status" Width="Auto" MinWidth="120">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="CPU req" Width="Auto" MinWidth="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding CpuRequestText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Mem req" Width="Auto" MinWidth="92">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding MemoryRequestText}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Age" Width="Auto" MinWidth="56">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <TextBlock Text="{Binding AgeText}" VerticalAlignment="Center" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <!-- Same affordance the events feed uses to reach the object it is about,
                   rather than a double-click nothing announces. -->
              <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:NodePodViewModel">
                    <Button Classes="chip" Padding="0" MinWidth="20" MinHeight="20" VerticalAlignment="Center"
                            ToolTip.Tip="Open this pod"
                            Command="{Binding $parent[UserControl].((vm:NodeDetailTabViewModel)DataContext).OpenPodCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="10" Height="10" />
                    </Button>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- ============================================================== Events -->
      <!-- The same two-line card feed pod detail uses — Reason/Message/Count/Type never
           fit a DataGrid at inspector width. No "open the object" chevron: every event
           here is about the node this pane is already showing. -->
      <TabItem Header="Events">
        <Grid RowDefinitions="Auto,Auto,*">
          <Border Grid.Row="0" Classes="infoBar error" Margin="0,0,0,8"
                  IsVisible="{Binding HasEventsError}">
            <TextBlock Text="{Binding EventsError}" TextWrapping="Wrap" FontSize="12" />
          </Border>
          <TextBlock Grid.Row="1" Classes="statusText dim" Margin="2,0,0,8" TextWrapping="Wrap"
                     IsVisible="{Binding HasNoEvents}"
                     Text="No recent events for this node. Events expire after an hour by default, so a quiet node has none — that is the healthy case." />
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventRowViewModel">
                  <Border Classes="card" Padding="8,6" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                      <Border Grid.Row="0" Grid.Column="0" Classes="statusPill" Margin="0,0,8,0"
                              Classes.ok="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                              Classes.warn="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}">
                        <TextBlock Text="{Binding Type}" FontSize="11" />
                      </Border>
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Reason}" FontWeight="SemiBold" FontSize="12.5"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="0" Grid.Column="2" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="{Binding Count, StringFormat='×{0}'}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastSeen}" />
                      </TextBlock>
                      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Message}" FontSize="11.5" Opacity="0.75"
                                 TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- =============================================================== Usage -->
      <!-- Measured, not requested: the Overview's bars are what the scheduler has
           promised, and a node can be full of requests and idle. Each figure is also
           given as a share of allocatable, the Overview's own denominator, so the two
           tabs compare directly. -->
      <TabItem Header="Usage">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <Border Classes="infoBar" IsVisible="{Binding IsMetricsUnavailable}">
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                          VerticalAlignment="Top" Margin="0,2,8,0" />
                <StackPanel Spacing="2">
                  <TextBlock Text="No usage data on this cluster" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="metrics.k8s.io isn't served here — install metrics-server to see CPU and memory. What the scheduler has promised is on the Overview tab, which needs no metrics."
                             FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Classes="infoBar" IsVisible="{Binding IsCollectingUsage}">
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Data="{StaticResource AlertCircleIconGeometry}" Width="12" Height="12"
                          VerticalAlignment="Top" Margin="0,2,8,0" />
                <StackPanel Spacing="2">
                  <TextBlock Text="Collecting samples…" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="{Binding UsagePollHint}" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
            </Border>

            <Border Classes="card" Padding="12" ToolTip.Tip="{Binding CpuTooltip}"
                    IsVisible="{Binding HasUsageSamples}">
              <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="CPU — node total" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                  <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Opacity="0.8">
                    <Run Text="{Binding CpuText}" />
                    <Run Text="{Binding CpuShareText}" />
                    <Run Text="  · peak " />
                    <Run Text="{Binding PeakCpuText}" />
                  </TextBlock>
                </Grid>
                <controls:Sparkline Grid.Row="1" Height="72" Values="{Binding CpuSeries}"
                                    Stroke="{StaticResource UsageCpuStrokeBrush}"
                                    AreaFill="{StaticResource UsageCpuAreaBrush}"
                                    BaselineBrush="{StaticResource ChartBaselineBrush}"
                                    StrokeThickness="1.6" />
              </Grid>
            </Border>

            <Border Classes="card" Padding="12" ToolTip.Tip="{Binding MemoryTooltip}"
                    IsVisible="{Binding HasUsageSamples}">
              <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Grid.Column="0" Text="Memory — node total" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                  <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Opacity="0.8">
                    <Run Text="{Binding MemoryText}" />
                    <Run Text="{Binding MemoryShareText}" />
                    <Run Text="  · peak " />
                    <Run Text="{Binding PeakMemoryText}" />
                  </TextBlock>
                </Grid>
                <controls:Sparkline Grid.Row="1" Height="72" Values="{Binding MemorySeries}"
                                    Stroke="{StaticResource UsageMemoryStrokeBrush}"
                                    AreaFill="{StaticResource UsageMemoryAreaBrush}"
                                    BaselineBrush="{StaticResource ChartBaselineBrush}"
                                    StrokeThickness="1.6" />
              </Grid>
            </Border>

            <TextBlock Classes="statusText dim" FontSize="11.5" TextWrapping="Wrap"
                       IsVisible="{Binding HasUsageSamples}"
                       Text="Measured by metrics-server over its last scrape window: everything on the machine the kubelet can see, system daemons included — which is why it can differ from the sum of the pods on it." />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
