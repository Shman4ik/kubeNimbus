<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:core="using:KubeNimbus.Core"
             xmlns:sys="using:System"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:controls="using:KubeNimbus.App.Controls"
             xmlns:aconv="using:Avalonia.Data.Converters"
             x:Class="KubeNimbus.App.Views.PodDetailView"
             x:DataType="vm:PodDetailTabViewModel">

  <!-- Two rows of chrome above the content, not four. This panel lives in a bottom
       dock that is ~300px tall by default, and it used to spend an owner row, a
       container row, a tab strip and a per-tab toolbar (plus, on Logs, a filter box
       and a "Following …" caption) before the first line of content — roughly 200px
       of a 300px dock. The owner chips now ride the container row, and every tab's
       tools ride the tab strip's row (see `ListBox.segmented` /
       `TabControl.headerless` in Theme.axaml). -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="10,8,10,10">

    <!-- Identity row: which container you are looking at, what owns the pod, and the
         two things you do to a container. The container picker is a single
         horizontally-scrolling strip rather than a WrapPanel, so a pod with eight
         containers costs the dock the same height as a pod with one. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
      <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ListBox Classes="segmented" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ContainerViewModel">
              <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding ResourcesTooltip}">
                <Ellipse Classes="statusDot" Classes.ok="{Binding Ready}" Classes.warn="{Binding !Ready}" />
                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
                <!-- init / debug: without this an init container that will not start is
                     indistinguishable from an app container that is merely not ready. -->
                <TextBlock Text="{Binding RoleLabel}" FontSize="10" Opacity="0.5" VerticalAlignment="Center"
                           IsVisible="{Binding HasRoleLabel}" />
                <!-- The live state ("CrashLoopBackOff"), which is what sends you to Previous. -->
                <TextBlock Text="{Binding State}" FontSize="10.5" Opacity="0.7" VerticalAlignment="Center"
                           IsVisible="{Binding HasStateLabel}" />
                <TextBlock Text="{Binding RestartCount, StringFormat='↻{0}'}" Opacity="0.6" FontSize="11"
                           VerticalAlignment="Center" IsVisible="{Binding RestartCount, Converter={x:Static conv:CountToBoolConverter.Instance}}" />
                <TextBlock Text="{Binding UsageSummary}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                           IsVisible="{Binding HasUsage}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <!-- Owner chain. The "Owned by" label is gone: the chips say `ReplicaSet/x`
           themselves, and the label cost a row's worth of width for no information. -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Owners}" Margin="8,0,0,0" VerticalAlignment="Center"
                    IsVisible="{Binding Owners.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:OwnerRef">
            <!-- A border, because an owner chip is the one clickable thing on this row
                 that isn't obviously a control (UI rule 8). -->
            <Button Classes="chip" Padding="8,3" Opacity="1" MaxWidth="220"
                    BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}"
                    ToolTip.Tip="Open the owning object"
                    Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).OpenOwnerCommand}"
                    CommandParameter="{Binding}">
              <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Kind}" FontWeight="SemiBold" />
                <Run Text="/" />
                <Run Text="{Binding Name}" />
              </TextBlock>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="6,0,0,0" VerticalAlignment="Center">
        <!-- Both disable themselves on the demo cluster (CanExecute), where there is no
             container to reach — the tooltip is what stops a disabled button reading as
             a bug. -->
        <Button Classes="toolbar" Command="{Binding ExecCommand}" Padding="6"
                ToolTip.Tip="{Binding IsDemo, Converter={x:Static conv:DemoActionTooltipConverter.Exec}}">
          <PathIcon Data="{StaticResource ConsoleIconGeometry}" Width="14" Height="14" />
        </Button>
        <Button Classes="toolbar" Command="{Binding PortForwardCommand}" Padding="6"
                ToolTip.Tip="{Binding IsDemo, Converter={x:Static conv:DemoActionTooltipConverter.PortForward}}">
          <PathIcon Data="{StaticResource SwapHorizontalIconGeometry}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>

    <!-- Tab strip + the selected tab's tools, one row. Indices here are the
         TabControl's below: Logs=0, Env=1, Events=2, Usage=3. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
      <ListBox Grid.Column="0" Classes="segmented" SelectedIndex="{Binding SelectedDetailTabIndex}">
        <ListBoxItem Content="Logs" />
        <ListBoxItem Content="Env" />
        <ListBoxItem Content="Events" />
        <ListBoxItem Content="Usage" IsVisible="{Binding IsAdvancedView}" />
        <!-- Appended after Usage for the same reason Usage was appended after Events:
             SelectedDetailTabIndex's existing values (Logs=0, Env=1, Events=2, Usage=3)
             are depended on by ClusterTabViewModel.OpenLogs and by the screenshot
             scenarios, so a new tab goes on the end and Overview is 4. -->
        <ListBoxItem Content="Overview" />
      </ListBox>

      <!-- Logs: the filter takes the row's slack. It was a full-width row of its own,
           which in a dock this short is a line of logs traded for a text box. -->
      <TextBox Grid.Column="1" Classes="filterbox" Margin="10,0,0,0" MaxWidth="340" HorizontalAlignment="Left"
               MinWidth="150" Text="{Binding LogSearchText}" PlaceholderText="Filter logs…"
               IsVisible="{Binding SelectedDetailTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=0}">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="11" Height="11" Opacity="0.5" Margin="8,0,0,0" />
        </TextBox.InnerLeftContent>
      </TextBox>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <!-- NOT ONE of these ToggleButtons carries a Command, and that is the fix, not
             an omission. ToggleButton.IsChecked is registered two-way and OnClick()
             flips it BEFORE the Command runs, so a toggling command bound alongside a
             two-way IsChecked cancels its own click out. Follow and Previous both had
             exactly that and were guaranteed no-ops — Follow stopped the stream it was
             meant to start, and Previous started a live follow of the current container.
             The work happens in the view model's On<Property>Changed hooks. -->
        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                    IsVisible="{Binding SelectedDetailTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=0}">
          <ToggleButton Classes="chip" Padding="6" IsChecked="{Binding IsFollowingLogs}"
                        ToolTip.Tip="Follow logs (cancels the stream when toggled off)">
            <PathIcon Data="{StaticResource PlayIconGeometry}" Width="12" Height="12" />
          </ToggleButton>
          <ToggleButton Classes="chip" Padding="7,3" FontSize="11"
                        IsChecked="{Binding IsShowingPreviousLogs}"
                        ToolTip.Tip="Show the previous (crashed/restarted) container instance's logs — the first thing to read on a CrashLoopBackOff"
                        Content="Previous" />
          <ToggleButton Classes="chip" Padding="6" IsChecked="{Binding ShowLogTimestamps}" ToolTip.Tip="Show timestamps">
            <PathIcon Data="{StaticResource ClockOutlineIconGeometry}" Width="12" Height="12" />
          </ToggleButton>

          <!-- Advanced-view only: wrap, copy and download are all useful and none of
               them is what you came here for. -->
          <ToggleButton Classes="chip" Padding="7,3" FontSize="11" IsVisible="{Binding IsAdvancedView}"
                        IsChecked="{Binding WrapLogLines}" ToolTip.Tip="Wrap long lines" Content="Wrap" />
          <Button Classes="toolbar" Command="{Binding CopyLogsCommand}" IsVisible="{Binding IsAdvancedView}"
                  ToolTip.Tip="Copy the visible lines, with timestamps" Padding="6">
            <PathIcon Data="{StaticResource ContentCopyIconGeometry}" Width="13" Height="13" />
          </Button>
          <Button Classes="toolbar" Command="{Binding DownloadLogsCommand}" IsVisible="{Binding IsAdvancedView}"
                  ToolTip.Tip="Save the visible lines to a file, with timestamps" Padding="6">
            <PathIcon Data="{StaticResource DownloadIconGeometry}" Width="13" Height="13" />
          </Button>
        </StackPanel>

        <!-- Events: its refresh button had a row to itself inside the tab. -->
        <Button Classes="toolbar" Command="{Binding RefreshEventsCommand}" Padding="6" ToolTip.Tip="Reload events"
                IsVisible="{Binding SelectedDetailTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=2}">
          <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="13" Height="13" />
        </Button>

        <!-- Usage: the window caption ("last 30 min") was a section header row. -->
        <TextBlock Text="{Binding UsageWindowCaption}" Classes="sectionHeader" VerticalAlignment="Center" Margin="4,0"
                   IsVisible="{Binding SelectedDetailTabIndex, Converter={x:Static conv:IndexEqualsConverter.Instance}, ConverterParameter=3}" />
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="2" Classes="headerless" SelectedIndex="{Binding SelectedDetailTabIndex}">
      <TabItem Header="Logs">
        <Grid>
          <Border Classes="card" Padding="8">
            <Grid>
              <!-- HorizontalScrollBarVisibility defaults to Disabled, which with wrapping
                   off hard-clipped every long line — a stack trace or a JSON log entry
                   simply ran off the edge with no way to reach the rest of it. -->
              <ScrollViewer Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding LogLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LogLineViewModel">
                      <!-- Selectable: reading a log usually ends in copying part of it into a
                           search box or a ticket, and a plain TextBlock made that impossible.
                           Same control HelmReleaseView already uses. -->
                      <!-- Severity as classes, never as a Foreground binding: a binding that
                           produces UnsetValue falls back to TextElement.Foreground's own
                           default (opaque black), not to the inherited foreground, so every
                           keyword-free line was invisible on the dark theme's card. See the
                           `.logError`/`.logWarn`/`.logInfo` styles in Theme.axaml. -->
                      <SelectableTextBlock Text="{Binding DisplayText}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                                           Classes.logError="{Binding IsErrorLine}"
                                           Classes.logWarn="{Binding IsWarnLine}"
                                           Classes.logInfo="{Binding IsInfoLine}"
                                           TextWrapping="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).WrapLogLines, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- Every empty state says which one it is (UI rule 9). Streaming-but-silent,
                   stopped, ended-with-a-reason and filtered-to-nothing all used to render
                   as the same blank card, and the pane's most common state — freshly
                   opened, nothing started — had no message at all. -->
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="420"
                          IsVisible="{Binding HasLogPlaceholder}">
                <TextBlock Text="{Binding LogPlaceholder}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                           Classes="statusText" Classes.warn="{Binding IsLogStatusProblem}" Classes.dim="{Binding !IsLogStatusProblem}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Env">
        <!-- No "ENV — <container>" header: the container strip two rows up is the
             selector for it and already names it. -->
        <Grid RowDefinitions="*,Auto">
          <Border Grid.Row="0" Classes="card" Padding="10">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding EnvironmentVars}">
                <ItemsControl.ItemTemplate>
                  <!-- Name beside the value, not above it. Stacking them was right when the
                       inspector was a narrow right-hand sidecar; in a full-width bottom dock
                       it doubled the row count of the longest list in the panel for no gain.
                       The name column is a fixed width rather than Auto: each row is its own
                       Grid (Avalonia has no shared-size scope), so Auto would start every
                       value at a different x and the list would read as a ragged edge. A
                       name longer than the column wraps inside it. -->
                  <DataTemplate x:DataType="vm:EnvVarViewModel">
                    <Grid ColumnDefinitions="200,*" Margin="0,3">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" Margin="0,0,12,0"
                                 FontFamily="Cascadia Mono,Consolas,monospace" FontWeight="SemiBold" FontSize="11.5"
                                 TextWrapping="Wrap" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="2">
                        <!-- Selectable: an env var is read in order to be pasted somewhere. -->
                        <SelectableTextBlock Text="{Binding DirectValue}" FontSize="11.5" Opacity="0.85" TextWrapping="Wrap"
                                             IsVisible="{Binding HasDirectValue}" />
                        <!-- A resolved fieldRef shows the value above and where it came from here,
                             since it reads like a literal but isn't one. -->
                        <TextBlock Text="{Binding SourceDescription}" FontSize="10.5" Opacity="0.5" TextWrapping="Wrap"
                                   IsVisible="{Binding IsDerivedValue}" />

                        <!-- A reference's value line. Same shape as a literal's, because for a
                             ConfigMap that is exactly what it is: resolved on open, shown
                             plainly, with the object it came from as the caption underneath.
                             A Secret stops at the dots until the eye is clicked. -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsReference}">
                          <SelectableTextBlock Text="{Binding RevealedValue}" FontSize="11.5" Opacity="0.85" TextWrapping="Wrap"
                                               IsVisible="{Binding HasResolvedValue}" />
                          <TextBlock Text="{Binding MaskedValue}" FontSize="11.5" Opacity="0.55" VerticalAlignment="Center"
                                     FontFamily="Cascadia Mono,Consolas,monospace" IsVisible="{Binding IsMasked}" />
                          <TextBlock Text="resolving…" FontSize="11" Opacity="0.45" VerticalAlignment="Center"
                                     IsVisible="{Binding IsResolving}" />
                          <!-- Eye, not a "Reveal" chip: it is a show/hide toggle, and it can hide
                               again — the chip was one-way, so a value revealed on a shared screen
                               stayed there until the tab was closed. Secrets only; a ConfigMap
                               has nothing to hide and gets no control at all. -->
                          <Button Classes="chip" Padding="4,2" VerticalAlignment="Center"
                                  IsVisible="{Binding IsSecretReference}" IsEnabled="{Binding !IsRevealing}"
                                  Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).ToggleEnvVarCommand}"
                                  CommandParameter="{Binding}">
                            <Panel>
                              <PathIcon Data="{StaticResource EyeIconGeometry}" Width="12" Height="12"
                                        IsVisible="{Binding !HasResolvedValue}" />
                              <PathIcon Data="{StaticResource EyeOffIconGeometry}" Width="12" Height="12"
                                        IsVisible="{Binding HasResolvedValue}" />
                            </Panel>
                            <ToolTip.Tip>
                              <TextBlock Text="Show or hide this Secret value" />
                            </ToolTip.Tip>
                          </Button>
                        </StackPanel>
                        <!-- Provenance under the value, not instead of it: which object and key
                             a value came from still matters once you can see the value. -->
                        <TextBlock Text="{Binding SourceDescription}" FontSize="10.5" Opacity="0.5" TextWrapping="Wrap"
                                   IsVisible="{Binding IsReference}" />
                        <!-- An `optional: true` ref whose key is absent is normal — the container
                             just starts without the variable — so it reads dim, not as an error. -->
                        <TextBlock Text="{Binding RevealError}" FontSize="11" Classes="statusText" TextWrapping="Wrap"
                                   Classes.warn="{Binding !IsOptionalReference}" Classes.dim="{Binding IsOptionalReference}"
                                   IsVisible="{Binding RevealError, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0" IsVisible="{Binding EnvFromSources.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
            <TextBlock Classes="sectionHeader" Text="ENVFROM" Margin="2,0,0,4" />
            <ItemsControl ItemsSource="{Binding EnvFromSources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnvFromSourceViewModel">
                  <Grid ColumnDefinitions="*,Auto" Margin="2,2">
                    <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="11.5" Opacity="0.75"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                    <!-- The one thing this line was always missing: a way through to the
                         object it names. Which keys it contributes is only knowable by
                         looking at the Secret/ConfigMap itself. -->
                    <Button Grid.Column="1" Classes="toolbar" Padding="4" VerticalAlignment="Center"
                            ToolTip.Tip="Open this object's YAML"
                            Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).OpenEnvFromSourceCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="12" Height="12" />
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </TabItem>


      <TabItem Header="Events">
        <!-- Refresh moved onto the tab strip's row; it had a whole row to itself here. -->
        <Grid>
          <!-- A card feed, not a grid: Reason/Message/Count/Type never fit five DataGrid columns in
               an inspector-width panel, and a scannable timeline reads better for events anyway. -->
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <!-- Two lines per event, not three: the count and timestamp ride the
                     reason's line, which is where the eye already is and where there was
                     always room. At the dock's default height that is the difference
                     between two events visible and four. -->
                <DataTemplate x:DataType="vm:EventRowViewModel">
                  <Border Classes="card" Padding="8,6" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                      <Border Grid.Row="0" Grid.Column="0" Classes="statusPill" Margin="0,0,8,0"
                              Classes.ok="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                              Classes.warn="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}">
                        <TextBlock Text="{Binding Type}" FontSize="11" />
                      </Border>
                      <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Reason}" FontWeight="SemiBold" FontSize="12.5"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="0" Grid.Column="2" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Run Text="{Binding Count, StringFormat='×{0}'}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastSeen}" />
                      </TextBlock>
                      <Button Grid.Row="0" Grid.Column="3" Classes="toolbar" Padding="4" Margin="4,0,0,0"
                              ToolTip.Tip="Open the object this event is about"
                              IsVisible="{Binding HasInvolvedObject}"
                              Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).OpenEventInvolvedObjectCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="12" Height="12" />
                      </Button>
                      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding Message}" FontSize="11.5" Opacity="0.75"
                                 TextWrapping="Wrap" Margin="0,3,0,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Usage over time. Appended after Events so the existing tab indices
           (Logs=0, Env=1, Events=2) stay stable for the screenshot harness and
           any future deep link. -->
      <TabItem Header="Usage" IsVisible="{Binding IsAdvancedView}">
        <!-- The "USAGE · last 30 min" header is on the tab strip's row: the tab is
             already labelled Usage, so only the window was ever news. -->
        <Grid>
          <!-- No metrics API at all: say so, instead of a chart area that looks stuck loading. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="380"
                      IsVisible="{Binding IsMetricsUnavailable}">
            <PathIcon Data="{StaticResource AlertCircleIconGeometry}" Width="24" Height="24" Opacity="0.3" HorizontalAlignment="Center" />
            <TextBlock Text="No usage data on this cluster" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.75" />
            <TextBlock Text="metrics.k8s.io isn't served here — install metrics-server to see CPU and memory."
                       FontSize="12" Opacity="0.55" TextWrapping="Wrap" TextAlignment="Center" />
          </StackPanel>

          <!-- Metrics exist but the first poll hasn't landed yet. -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="380"
                      IsVisible="{Binding !HasUsageSamples}">
            <TextBlock Text="Collecting samples…" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" Opacity="0.7"
                       IsVisible="{Binding !IsMetricsUnavailable}" />
            <TextBlock Text="{Binding UsagePollHint}" FontSize="11.5" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="{Binding !IsMetricsUnavailable}" />
          </StackPanel>

          <ScrollViewer IsVisible="{Binding HasUsageSamples}">
            <StackPanel Spacing="8">
              <!-- Whole-pod totals, full width: the two numbers an on-call read starts from. -->
              <Border Classes="card" Padding="12" ToolTip.Tip="{Binding PodCpuTooltip}">
                <Grid RowDefinitions="Auto,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="CPU — pod total" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Opacity="0.8">
                      <Run Text="{Binding PodCpuText}" />
                      <Run Text="  · peak " />
                      <Run Text="{Binding PodPeakCpuText}" />
                    </TextBlock>
                  </Grid>
                  <controls:Sparkline Grid.Row="1" Height="72" Values="{Binding PodCpuSeries}"
                                      Stroke="{StaticResource UsageCpuStrokeBrush}"
                                      AreaFill="{StaticResource UsageCpuAreaBrush}"
                                      BaselineBrush="{StaticResource ChartBaselineBrush}"
                                      StrokeThickness="1.6" />
                </Grid>
              </Border>

              <Border Classes="card" Padding="12" ToolTip.Tip="{Binding PodMemoryTooltip}">
                <Grid RowDefinitions="Auto,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="Memory — pod total" FontSize="12" FontWeight="SemiBold" Opacity="0.8" />
                    <TextBlock Grid.Column="1" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11.5" Opacity="0.8">
                      <Run Text="{Binding PodMemoryText}" />
                      <Run Text="  · peak " />
                      <Run Text="{Binding PodPeakMemoryText}" />
                    </TextBlock>
                  </Grid>
                  <controls:Sparkline Grid.Row="1" Height="72" Values="{Binding PodMemorySeries}"
                                      Stroke="{StaticResource UsageMemoryStrokeBrush}"
                                      AreaFill="{StaticResource UsageMemoryAreaBrush}"
                                      BaselineBrush="{StaticResource ChartBaselineBrush}"
                                      StrokeThickness="1.6" />
                </Grid>
              </Border>

              <!-- Per container: which one is actually spending the pod's budget.
                   CPU and Memory side by side, since a container row is a comparison,
                   not a headline. -->
              <TextBlock Classes="sectionHeader" Text="BY CONTAINER" Margin="2,4,0,0" />
              <ItemsControl ItemsSource="{Binding Containers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContainerViewModel">
                    <Border Classes="card" Padding="12" Margin="0,0,0,6">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Name}"
                                   FontSize="12" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,6"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ResourcesTooltip}" />
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,6,0"
                                    ToolTip.Tip="{Binding CpuChartTooltip}">
                          <TextBlock FontSize="11" Opacity="0.6" FontFamily="Cascadia Mono,Consolas,monospace">
                            <Run Text="CPU " />
                            <Run Text="{Binding PeakCpuText}" />
                            <Run Text=" peak" />
                          </TextBlock>
                          <controls:Sparkline Height="40" Values="{Binding CpuSeries}"
                                              Stroke="{StaticResource UsageCpuStrokeBrush}"
                                              AreaFill="{StaticResource UsageCpuAreaBrush}"
                                              BaselineBrush="{StaticResource ChartBaselineBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4" Margin="6,0,0,0"
                                    ToolTip.Tip="{Binding MemoryChartTooltip}">
                          <TextBlock FontSize="11" Opacity="0.6" FontFamily="Cascadia Mono,Consolas,monospace">
                            <Run Text="MEM " />
                            <Run Text="{Binding PeakMemoryText}" />
                            <Run Text=" peak" />
                          </TextBlock>
                          <controls:Sparkline Height="40" Values="{Binding MemorySeries}"
                                              Stroke="{StaticResource UsageMemoryStrokeBrush}"
                                              AreaFill="{StaticResource UsageMemoryAreaBrush}"
                                              BaselineBrush="{StaticResource ChartBaselineBrush}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- Overview: the structured half of `kubectl describe pod`. Everything here used
           to require opening the YAML editor and scrolling — which is a page of text to
           answer "is this pod's readiness probe the reason it never goes Ready?". Read
           out of the object the row already holds (PodDetails, Core); no extra GET, no
           second watch. Not gated on the Advanced view: three of the five comparable
           clients render exactly these fields unprompted, which is what "table stakes"
           means. -->
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Spacing="8">

            <!-- Scheduling. QoS and priority are one line each and belong beside the node
                 selector, since all three answer "where can this run and what happens to
                 it when the node is under pressure". -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="SCHEDULING" />

                <Grid ColumnDefinitions="130,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="QoS class" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding QosClass}" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding HasQosClass}" />
                  <!-- The API server computes qosClass; an object without one never went
                       through a server. Deriving it here would risk disagreeing with the
                       value the eviction path actually uses. -->
                  <TextBlock Grid.Column="1" Classes="statusText dim" FontSize="12" VerticalAlignment="Center"
                             Text="not reported by the API server" IsVisible="{Binding !HasQosClass}" />
                </Grid>

                <Grid ColumnDefinitions="130,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="Priority class" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding PriorityText}" FontSize="12" VerticalAlignment="Center"
                                       IsVisible="{Binding HasPriority}" />
                  <TextBlock Grid.Column="1" Classes="statusText dim" FontSize="12" VerticalAlignment="Center"
                             Text="none — scheduled at the cluster's default priority" IsVisible="{Binding !HasPriority}" />
                </Grid>

                <Grid ColumnDefinitions="130,*" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="Node selector" FontSize="12" Opacity="0.6" VerticalAlignment="Top" Margin="0,3,0,0" />
                  <TextBlock Grid.Column="1" Classes="statusText dim" FontSize="12" VerticalAlignment="Center"
                             Text="none — any node that tolerates the pod's other constraints"
                             IsVisible="{Binding !HasNodeSelector}" />
                  <ItemsControl Grid.Column="1" ItemsSource="{Binding NodeSelector}" IsVisible="{Binding HasNodeSelector}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="core:PodNodeSelectorTerm">
                        <!-- statusPill, not chip: `chip` is a Button/ToggleButton style
                             and on a Border it compiles and silently styles nothing. A
                             node-selector term is not clickable. -->
                        <Border Classes="statusPill" Margin="0,0,4,4">
                          <TextBlock Text="{Binding Display}" FontSize="11.5"
                                     FontFamily="Cascadia Mono,Consolas,monospace" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Conditions. Positive when True for the types Kubernetes defines that way,
                 negative for DisruptionTarget, and deliberately grey — neither — for a
                 type this app has not classified: see PodDetails.PolarityOf. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="CONDITIONS" />
                <TextBlock Classes="statusText dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasConditions}"
                           Text="This pod reports no conditions yet — the scheduler and kubelet write them as it is admitted and started." />
                <ItemsControl ItemsSource="{Binding Conditions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PodConditionViewModel">
                      <Grid ColumnDefinitions="Auto,170,56,*" Margin="0,2">
                        <Ellipse Grid.Column="0" Classes="statusDot" Width="8" Height="8"
                                 VerticalAlignment="Center" Margin="0,0,8,0"
                                 Fill="{Binding Health, Converter={x:Static conv:HealthToBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Type}" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="12" Opacity="0.75" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Message}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Tolerations, all of them — including the two NoExecute/300s ones the
                 DefaultTolerationSeconds admission plugin adds to nearly every pod.
                 Hiding those would make a pod that genuinely declares one look the same
                 as one that does not. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="TOLERATIONS" />
                <TextBlock Classes="statusText dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasTolerations}"
                           Text="No tolerations — this pod cannot be scheduled onto a tainted node." />
                <ItemsControl ItemsSource="{Binding Tolerations}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:PodToleration">
                      <SelectableTextBlock Text="{Binding Display}" FontSize="12" Margin="0,2"
                                           FontFamily="Cascadia Mono,Consolas,monospace" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Probes, for the container the strip two rows up has selected — the same
                 relationship the Environment tab has with it, so this section needs no
                 picker of its own. The handler and timing wording is kubectl's, so a
                 probe read here and one read in a terminal are visibly the same probe. -->
            <Border Classes="card" Padding="12,10">
              <StackPanel Spacing="6">
                <TextBlock Classes="sectionHeader" Text="PROBES" />
                <TextBlock Classes="statusText dim" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding !HasProbes}"
                           Text="This container declares no probes. Kubernetes will treat it as ready as soon as it starts." />
                <ItemsControl ItemsSource="{Binding Probes}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:ContainerProbe">
                      <Grid ColumnDefinitions="80,*" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Kind}" FontSize="12" Opacity="0.6" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="1">
                          <SelectableTextBlock Text="{Binding Handler}" FontSize="12" TextWrapping="Wrap"
                                               FontFamily="Cascadia Mono,Consolas,monospace" />
                          <TextBlock Text="{Binding Timing}" FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                     FontFamily="Cascadia Mono,Consolas,monospace" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
