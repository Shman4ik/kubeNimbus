<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KubeNimbus.App.ViewModels"
             xmlns:core="using:KubeNimbus.Core"
             xmlns:sys="using:System"
             xmlns:conv="using:KubeNimbus.App.Converters"
             xmlns:aconv="using:Avalonia.Data.Converters"
             x:Class="KubeNimbus.App.Views.PodDetailView"
             x:DataType="vm:PodDetailTabViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="12">

    <!-- Owner chain -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8"
                IsVisible="{Binding Owners.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
      <TextBlock Text="Owned by" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
      <ItemsControl ItemsSource="{Binding Owners}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:OwnerRef">
            <Button Classes="chip" Padding="8,3" Opacity="1"
                    Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).OpenOwnerCommand}"
                    CommandParameter="{Binding}">
              <TextBlock FontSize="12">
                <Run Text="{Binding Kind}" FontWeight="SemiBold" />
                <Run Text="/" />
                <Run Text="{Binding Name}" />
              </TextBlock>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Container picker: a horizontal strip, not a fixed-width side column — with only 2-4
         containers on a typical pod this reads fine as a row of chips and leaves the tabs the
         panel's full width, which logs/events/env vars all need far more than a container list. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <ListBox Grid.Column="0" ItemsSource="{Binding Containers}" SelectedItem="{Binding SelectedContainer}" Padding="0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ContainerViewModel">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Classes="statusDot" Classes.ok="{Binding Ready}" Classes.warn="{Binding !Ready}" />
              <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RestartCount, StringFormat='↻{0}'}" Opacity="0.6" FontSize="11"
                         VerticalAlignment="Center" IsVisible="{Binding RestartCount, Converter={x:Static conv:CountToBoolConverter.Instance}}" />
              <TextBlock Text="{Binding UsageDisplay}" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                         IsVisible="{Binding UsageDisplay, Converter={x:Static conv:StringNotEmptyToBoolConverter.Instance}}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Classes="toolbar" Command="{Binding ExecCommand}" ToolTip.Tip="Exec into selected container" Padding="6">
          <PathIcon Data="{StaticResource ConsoleIconGeometry}" Width="14" Height="14" />
        </Button>
        <Button Classes="toolbar" Command="{Binding PortForwardCommand}" ToolTip.Tip="Port-forward selected container" Padding="6">
          <PathIcon Data="{StaticResource SwapHorizontalIconGeometry}" Width="14" Height="14" />
        </Button>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedDetailTabIndex}">
      <TabItem Header="Logs">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <WrapPanel Grid.Row="0" Margin="0,0,0,6">
            <ToggleButton Classes="chip" Padding="6" Margin="0,0,4,4" IsChecked="{Binding IsFollowingLogs}" Command="{Binding ToggleFollowLogsCommand}"
                          ToolTip.Tip="Follow logs (cancels the stream when toggled off)">
              <PathIcon Data="{StaticResource PlayIconGeometry}" Width="12" Height="12" />
            </ToggleButton>
            <ToggleButton Classes="chip" Padding="7,3" Margin="0,0,4,4" FontSize="11"
                          IsChecked="{Binding IsShowingPreviousLogs}" Command="{Binding TogglePreviousLogsCommand}"
                          ToolTip.Tip="Show the previous (crashed/restarted) container instance's logs"
                          Content="Previous" />
            <ToggleButton Classes="chip" Padding="6" Margin="0,0,4,4" IsChecked="{Binding ShowLogTimestamps}" ToolTip.Tip="Show timestamps">
              <PathIcon Data="{StaticResource ClockOutlineIconGeometry}" Width="12" Height="12" />
            </ToggleButton>
            <ToggleButton Classes="chip" Padding="7,3" Margin="0,0,4,4" FontSize="11"
                          IsChecked="{Binding WrapLogLines}" ToolTip.Tip="Wrap long lines" Content="Wrap" />
            <Button Classes="toolbar" Margin="0,0,4,4" Command="{Binding CopyLogsCommand}" ToolTip.Tip="Copy visible logs" Padding="6">
              <PathIcon Data="{StaticResource ContentCopyIconGeometry}" Width="13" Height="13" />
            </Button>
            <Button Classes="toolbar" Margin="0,0,4,4" Command="{Binding DownloadLogsCommand}" ToolTip.Tip="Download visible logs" Padding="6">
              <PathIcon Data="{StaticResource DownloadIconGeometry}" Width="13" Height="13" />
            </Button>
          </WrapPanel>
          <TextBox Grid.Row="1" Classes="filterbox" Margin="0,0,0,6" Text="{Binding LogSearchText}" PlaceholderText="Filter logs…">
            <TextBox.InnerLeftContent>
              <PathIcon Data="{StaticResource MagnifyIconGeometry}" Width="11" Height="11" Opacity="0.5" Margin="8,0,0,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <TextBlock Grid.Row="2" Text="{Binding SelectedContainer.Name, StringFormat='Following {0}'}" Opacity="0.6" FontSize="12" Margin="0,0,0,6"
                     IsVisible="{Binding IsFollowingLogs}" />
          <TextBlock Grid.Row="2" Text="{Binding SelectedContainer.Name, StringFormat='Previous logs for {0}'}" Opacity="0.6" FontSize="12" Margin="0,0,0,6"
                     IsVisible="{Binding IsShowingPreviousLogs}" />
          <Border Grid.Row="3" Classes="card" Padding="8">
            <ScrollViewer Name="LogScroll">
              <ItemsControl ItemsSource="{Binding LogLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LogLineViewModel">
                    <TextBlock Text="{Binding DisplayText}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                               Foreground="{Binding Severity, Converter={x:Static conv:LogSeverityToBrushConverter.Instance}}"
                               TextWrapping="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).WrapLogLines, Converter={x:Static conv:BoolToTextWrappingConverter.Instance}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Env">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Classes="sectionHeader" Text="{Binding SelectedContainer.Name, StringFormat='ENV — {0}'}" Margin="2,0,0,8" />
          <Border Grid.Row="1" Classes="card" Padding="10">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding EnvironmentVars}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EnvVarViewModel">
                    <StackPanel Margin="0,5" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontWeight="SemiBold" FontSize="11.5" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding DirectValue}" FontSize="11.5" Opacity="0.85" TextWrapping="Wrap"
                                 IsVisible="{Binding IsReference, Converter={x:Static aconv:BoolConverters.Not}}" />
                      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsReference}">
                        <TextBlock Grid.Column="0" Text="{Binding SourceDescription}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Classes="chip" Padding="6,2" FontSize="10.5" Content="Reveal" VerticalAlignment="Center"
                                IsVisible="{Binding CanReveal}" IsEnabled="{Binding !IsRevealing}"
                                Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).RevealEnvVarCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                      <TextBlock Text="{Binding RevealedValue}" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource AppAccentBrush}"
                                 IsVisible="{Binding RevealedValue, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
                      <TextBlock Text="{Binding RevealError}" FontSize="11" Classes="statusText warn" TextWrapping="Wrap"
                                 IsVisible="{Binding RevealError, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Row="2" Spacing="2" Margin="0,8,0,0" IsVisible="{Binding EnvFromSources.Count, Converter={x:Static conv:CountToBoolConverter.Instance}}">
            <TextBlock Classes="sectionHeader" Text="ENVFROM" Margin="2,0,0,4" />
            <ItemsControl ItemsSource="{Binding EnvFromSources}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <TextBlock Text="{Binding}" FontSize="11.5" Opacity="0.75" Margin="2,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Events">
        <Grid RowDefinitions="Auto,*">
          <Button Grid.Row="0" Classes="toolbar" Command="{Binding RefreshEventsCommand}" HorizontalAlignment="Right" Padding="6">
            <PathIcon Data="{StaticResource RefreshIconGeometry}" Width="13" Height="13" />
          </Button>
          <!-- A card feed, not a grid: Reason/Message/Count/Type never fit five DataGrid columns in
               an inspector-width panel, and a scannable timeline reads better for events anyway. -->
          <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding Events}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EventRowViewModel">
                  <Border Classes="card" Padding="10" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Border Classes="statusPill"
                                Classes.ok="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=ok}"
                                Classes.warn="{Binding Health, Converter={x:Static conv:HealthEqualsConverter.Instance}, ConverterParameter=warn}">
                          <TextBlock Text="{Binding Type}" FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding Reason}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button Grid.Row="0" Grid.Column="1" Classes="toolbar" Padding="4" ToolTip.Tip="Open the object this event is about"
                              IsVisible="{Binding HasInvolvedObject}"
                              Command="{Binding $parent[UserControl].((vm:PodDetailTabViewModel)DataContext).OpenEventInvolvedObjectCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="{StaticResource ChevronRightIconGeometry}" Width="12" Height="12" />
                      </Button>
                      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Message}" FontSize="11.5" Opacity="0.75"
                                 TextWrapping="Wrap" Margin="0,5,0,0" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" FontSize="10.5" Opacity="0.5" Margin="0,5,0,0">
                        <Run Text="{Binding Count, StringFormat='×{0}'}" />
                        <Run Text=" · " />
                        <Run Text="{Binding LastSeen}" />
                      </TextBlock>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
