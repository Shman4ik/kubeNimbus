    "spec": {
      "ingressClassName": "nginx",
      "tls": [ { "hosts": [ "api.payments.example.com" ], "secretName": "payments-public-tls" } ],
      "rules": [
        { "host": "api.payments.example.com", "http": { "paths": [
          { "path": "/ledger", "pathType": "Prefix", "backend": { "service": { "name": "ledger-api", "port": { "name": "http" } } } },
          { "path": "/checkout", "pathType": "Prefix", "backend": { "service": { "name": "checkout", "port": { "number": 80 } } } }
        ] } },
        { "host": "admin.payments.example.com", "http": { "paths": [
          { "path": "/reports(/|$)(.*)", "pathType": "ImplementationSpecific", "backend": { "service": { "name": "checkout-canary", "port": { "number": 80 } } } }
        ] } },
        { "host": "*.internal.payments.example.com", "http": { "paths": [
          { "path": "/", "pathType": "Prefix", "backend": { "service": { "name": "fraud-detector", "port": { "number": 9000 } } } }
