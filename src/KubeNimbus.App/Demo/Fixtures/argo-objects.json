  {
    "apiVersion": "argoproj.io/v1alpha1",
    "kind": "AppProject",
    "metadata": {
      "name": "payments",
      "namespace": "argocd",
      "creationTimestamp": "2026-04-02T08:00:00Z"
    },
    "spec": {
      "description": "Payments team services, deployed from the platform manifests",
      "sourceRepos": [
        "https://github.com/example-org/platform-manifests.git",
        "!https://github.com/example-org/platform-secrets.git"
      ],
      "destinations": [
        { "server": "https://kubernetes.default.svc", "namespace": "payments" },
        { "server": "https://kubernetes.default.svc", "namespace": "payments-*" }
      ],
      "sourceNamespaces": [ "payments" ],
      "clusterResourceWhitelist": [ { "group": "", "kind": "Namespace" } ],
      "namespaceResourceBlacklist": [ { "group": "", "kind": "ResourceQuota" }, { "group": "", "kind": "LimitRange" } ],
      "syncWindows": [
        { "kind": "deny", "schedule": "0 22 * * 5", "duration": "56h", "applications": [ "*" ], "manualSync": true, "timeZone": "Europe/Berlin" },
        { "kind": "allow", "schedule": "0 6 * * 1-5", "duration": "14h", "namespaces": [ "payments" ] }
      ],
      "roles": [
        {
          "name": "deployer",
          "description": "CI pipeline",
          "policies": [
            "p, proj:payments:deployer, applications, sync, payments/*, allow",
            "p, proj:payments:deployer, applications, get, payments/*, allow"
          ],
          "groups": [ "payments-ci" ]
        },
        {
          "name": "oncall",
          "description": "Reads Applications",
          "policies": [ "p, proj:payments:oncall, applications, get, payments/*, allow" ],
          "groups": [ "payments-oncall" ]
        }
      ]
    }
  }
