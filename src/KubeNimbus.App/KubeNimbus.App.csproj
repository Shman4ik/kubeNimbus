<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KubeNimbus.App</RootNamespace>
    <!-- The shipped executable is the product name, not the project name — this
         is what a user downloads and pins to a taskbar. Note that the assembly
         name is also the authority for `avares://` URIs (App.axaml references
         avares://kubeNimbus/Styles/Theme.axaml) and for app.manifest's
         assemblyIdentity: all three must move together. -->
    <AssemblyName>kubeNimbus</AssemblyName>
    <AssemblyTitle>kubeNimbus</AssemblyTitle>
    <Description>A fast, open-source Kubernetes desktop client.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

    <!-- Compiled bindings only: no reflection-based XAML bindings anywhere. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- NativeAOT is the shipping configuration. These stay on so trim/AOT
         warnings surface during ordinary CI builds, not just at publish. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- DevTools/previewer inspection (Avalonia MCP). Debug-only so it never
         enters the NativeAOT release build. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../KubeNimbus.Core/KubeNimbus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-written YAML highlighting definition (AvaloniaEdit doesn't bundle one) — see Editing/YamlSyntaxHighlighting.cs. -->
    <EmbeddedResource Include="Assets\Yaml-Mode.xshd" LogicalName="Yaml-Mode.xshd" />
    <!-- Icons, all generated — see design/LOGO-ASSETS.md. Assets\Msix\** are
         packaging-time-only tile images: they are read by a future MSIX pack
         step from the source tree, never loaded at runtime, so they must not
         be embedded into the binary. -->
    <AvaloniaResource Include="Assets\*.ico" />
  </ItemGroup>

</Project>
