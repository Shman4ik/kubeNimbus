# Build outputs
bin/
obj/
artifacts/
TestResults/
*.binlog

# Agent worktrees (.claude/worktrees/** are throwaway checkouts of this repo)
.claude/worktrees/

# A machine's own Claude Code permissions: the QA VM's allow rules for batch G2's kubectl
# (docs/engineering/desktop-qa.md) must never be committed, since settings.json loads everywhere.
.claude/settings.local.json

# IDE
.vs/
.idea/
*.user
*.suo

# NativeAOT publish output
publish/

# Sandbox cluster state (contains cluster CA/client certs — never commit)
.sandbox/

# OS cruft
Thumbs.db
.DS_Store

# Affinity holds a lock file beside an open document; it is transient editor
# state, not art, and it disappears when the document is closed.
*.af~lock~
